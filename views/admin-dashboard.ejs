    function showAppPopup({ title, message, confirmText = 'OK', cancelText = null, tone = 'primary' }) {
      const { element, instance } = ensureAppPopup();
      const titleEl = element.querySelector('#app-popup-title');
      const kickerEl = element.querySelector('#app-popup-kicker');
      const messageEl = element.querySelector('#app-popup-message');
      const noteEl = element.querySelector('#app-popup-note');
      const orbEl = element.querySelector('#app-popup-orb');
      const confirmBtn = element.querySelector('#app-popup-confirm');
      const cancelBtn  = element.querySelector('#app-popup-cancel');
      const contentEl  = element.querySelector('.app-popup-content');

      const toneLabels = {
        primary: 'Acao rapida',
        warning: 'Confirmacao',
        danger: 'Aten��o',
        success: 'Concluido',
      };
      const toneNotes = {
        primary: 'Revise a informacao e siga com a acao desejada.',
        warning: 'Esta decisao impacta o fluxo de aprovacao imediatamente.',
        danger: 'Confira os dados antes de seguir para evitar reversoes desnecessarias.',
        success: 'A interface foi atualizada e o painel ja reflete a nova situacao.',
      };
      const toneIcons = {
        primary: 'fa-sparkles',
        warning: 'fa-shield-halved',
        danger: 'fa-triangle-exclamation',
        success: 'fa-circle-check',
      };

      titleEl.textContent = title || 'Aviso';
      kickerEl.textContent = toneLabels[tone] || 'Acao rapida';
      messageEl.textContent = message || '';
      if (noteEl) {
        noteEl.textContent = toneNotes[tone] || toneNotes.primary;
        noteEl.style.display = noteEl.textContent ? '' : 'none';
      }
      if (orbEl) {
        orbEl.innerHTML = `<i class="fas ${toneIcons[tone] || toneIcons.primary}"></i>`;
      }
      confirmBtn.textContent = confirmText;
      confirmBtn.className = `btn btn-${tone} app-popup-confirm`;
      if (contentEl) {
        contentEl.classList.remove('app-popup-tone-primary', 'app-popup-tone-warning', 'app-popup-tone-danger', 'app-popup-tone-success');
        contentEl.classList.add(`app-popup-tone-${tone}`);
      }
      cancelBtn.style.display = cancelText ? '' : 'none';
      if (cancelText) cancelBtn.textContent = cancelText;

      return new Promise(resolve => {
        let resolved = false;
        const cleanup = () => {
          confirmBtn.removeEventListener('click', onConfirm);
          cancelBtn.removeEventListener('click', onCancel);
          element.removeEventListener('hidden.bs.modal', onHidden);
        };
        const settle = v => { if (resolved) return; resolved = true; cleanup(); resolve(v); };
        const onConfirm = () => { settle(true);  instance.hide(); };
        const onCancel  = () => { settle(false); instance.hide(); };
        const onHidden  = () => settle(false);
        confirmBtn.addEventListener('click', onConfirm);
        cancelBtn.addEventListener('click', onCancel);
        element.addEventListener('hidden.bs.modal', onHidden, { once: true });
        instance.show();
      });
    }

