    function atualizarInterfaceLote(scope) {
      const checkboxes = obterCheckboxesLote(scope);
      const selecionados = checkboxes.filter((checkbox) => checkbox.checked);
      const toolbar = document.querySelector(`.batch-toolbar[data-batch-scope="${scope}"]`);

      checkboxes.forEach((checkbox) => {
        const card = checkbox.closest('.selectable-card');
        if (card) {
          card.classList.toggle('is-selected', checkbox.checked);
        }
      });

      if (!toolbar) return;

      const counter = toolbar.querySelector('.batch-counter');
      const actionButtons = toolbar.querySelectorAll('[data-batch-action]');
      if (counter) {
        counter.textContent = `${selecionados.length} selecionado(s)`;
      }

      actionButtons.forEach((button) => {
        button.disabled = selecionados.length === 0;
      });
    }

    const STATUS_CARD_CLASS = {
      pendente: 'amber-card',
      aprovado: 'green-card',
      reprovado: 'red-card',
    };

    function selecionarTodosLote(scope) {
      obterCheckboxesLote(scope).forEach((checkbox) => {
        checkbox.checked = true;
      });
      atualizarInterfaceLote(scope);
    }

    function limparSelecaoLote(scope) {
      obterCheckboxesLote(scope).forEach((checkbox) => {
        checkbox.checked = false;
      });
      atualizarInterfaceLote(scope);
    }

    function selecionarPorStatusLote(scope, status) {
      const cardClass = STATUS_CARD_CLASS[status];
      obterCheckboxesLote(scope).forEach((checkbox) => {
        const card = checkbox.closest('.selectable-card');
        checkbox.checked = card ? card.classList.contains(cardClass) : false;
      });
      atualizarInterfaceLote(scope);
    }

    function focarAprovacaoEmMassa(scope) {
      const toolbar = document.querySelector(`.approval-command-bar[data-batch-scope="${scope}"]`);
      if (!toolbar) return;

      toolbar.classList.remove('is-guided');
      void toolbar.offsetWidth;
      toolbar.classList.add('is-guided');
      toolbar.scrollIntoView({ behavior: 'smooth', block: 'center' });

      const primeiroCheckbox = obterCheckboxesLote(scope)[0];
      if (primeiroCheckbox) {
        primeiroCheckbox.focus({ preventScroll: true });
      }

      window.setTimeout(() => {
        toolbar.classList.remove('is-guided');
      }, 1800);
    }

    async function executarAcaoLote(scope, action) {
      const selecionados = obterCheckboxesLote(scope)
        .filter((checkbox) => checkbox.checked)
        .map((checkbox) => checkbox.dataset.batchId);

      if (selecionados.length === 0) {
        await appAlert('Selecione pelo menos um cadastro para continuar.', 'warning', 'Nenhuma sele��o');
        return;
      }

      const verbo = action === 'aprovar' ? 'aprovar' : 'reprovar';
      const confirmacao = await appConfirm(`Tem certeza que deseja ${verbo} ${selecionados.length} cadastro(s) de uma vez?`, `Confirmar ${verbo} em lote`);
      if (!confirmacao) return;

      try {
        const res = await fetch('/admin/aprovacao-lote', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ ids: selecionados, tipoLista: scope, action })
        });
        const data = await res.json();

        if (!res.ok || !data.success) {
          throw new Error(data.error || 'Falha ao processar atualiza��o em lote');
        }

        const complemento = data.missingCount > 0
          ? ` ${data.missingCount} cadastro(s) n�o foram encontrados.`
          : '';

        await appAlert(`${data.updatedCount} cadastro(s) atualizados com sucesso.${complemento}`, 'success', 'Sucesso');
        location.reload();
      } catch (e) {
        await appAlert('Erro: ' + e.message, 'danger', 'Erro');
      }
    }

    document.addEventListener('change', (event) => {
      if (!event.target.classList.contains('batch-checkbox')) return;
      atualizarInterfaceLote(event.target.dataset.batchScope);
    });

    document.addEventListener('DOMContentLoaded', () => {
      setupMotionModeControls();
      setupEventScopeControls();
      setupAdvancedFilters();

      window.requestAnimationFrame(() => {
        window.requestAnimationFrame(() => {
          const loadDelay = document.body.classList.contains('motion-mode-executivo') ? 220 : 300;
          setTimeout(() => {
            document.body.classList.remove('is-loading');
            document.body.classList.add('is-loaded');
          }, loadDelay);
        });
      });

      ['encontrista', 'encontreiro'].forEach(atualizarInterfaceLote);
      hydrateSmartCards();
      loadSavedFilters();
      applyAdvancedFilters();

      document.querySelectorAll('[data-board-tabs]').forEach((tabGroup) => {
        const panel = tabGroup.closest('.section-panel');
        if (!panel) return;

        tabGroup.addEventListener('click', (event) => {
          const button = event.target.closest('.status-tab');
          if (!button) return;

          const view = button.dataset.view || 'all';
          tabGroup.querySelectorAll('.status-tab').forEach((tab) => tab.classList.remove('active'));
          button.classList.add('active');

          panel.classList.remove('view-all', 'view-pendente', 'view-aprovado', 'view-reprovado');
          panel.classList.add(`view-${view}`);
        });
      });

      document.querySelectorAll('.pcard').forEach((card) => {
        const header = card.querySelector('.pcard-top');
        if (!header) return;
        header.addEventListener('click', (event) => {
          if (event.target.closest('button, a, input, label')) return;
          card.classList.toggle('is-expanded');
        });
      });
    });

    function getProfileInfoFromCard(card) {
      if (!card) return null;

      const safeText = (value, fallback = '-') => {
        const normalized = String(value || '').replace(/\s+/g, ' ').trim();
        return normalized || fallback;
      };

      const profileId = String(card.dataset.id || '').trim();
      const source = profileId ? PROFILE_SOURCE_BY_ID[profileId] : null;

      const detailMap = {};
      card.querySelectorAll('.pcard-details > div').forEach((item) => {
        const label = safeText(item.querySelector('.pcard-field-lbl')?.textContent, '').toLowerCase();
        if (!label) return;
        detailMap[label] = safeText(item.querySelector('.pcard-field-val')?.textContent);
      });

      const metaItems = Array.from(card.querySelectorAll('.pcard-meta span')).map((span) => safeText(span.textContent));
      const ejcFromMeta = metaItems[0] || '-';
      const dataNascimentoFormatada = (() => {
        const value = source?.dataNascimento || '';
        if (!value) return '';
        const parsed = new Date(value);
        if (Number.isNaN(parsed.getTime())) return '';
        return parsed.toLocaleDateString('pt-BR');
      })();

      const nome = safeText(source?.nomeCompleto || card.querySelector('.pcard-name')?.textContent);
      const tipoCadastro = safeText(card.dataset.tipo === 'encontreiro' ? 'Encontreiro' : 'Encontrista');
      const foto = source?.foto
        ? `/img/uploads/${encodeURIComponent(source.foto)}?w=200&h=200&fit=cover&format=webp`
        : (card.querySelector('.pcard-avatar img')?.getAttribute('src') || '');

      return {
        nome,
        tipoCadastro,
        foto,
        fields: {
          'Como quer ser chamado': source?.comoQuerSerChamado || detailMap['como quer ser chamado'] || '-',
          'Genero': source?.genero || detailMap['gênero'] || detailMap['genero'] || '-',
          'Data de nascimento': dataNascimentoFormatada || detailMap['nascimento'] || '-',
          'Telefone': source?.telefone || detailMap['telefone'] || '-',
          'Email': source?.email || detailMap['email'] || '-',
          'EJC': source?.ejc || detailMap['ejc'] || ejcFromMeta || '-',
          'CEP': source?.cep || detailMap['cep'] || '-',
          'Endereco': source?.logradouro || detailMap['logradouro'] || detailMap['endereço'] || detailMap['endereco'] || '-',
          'Bairro': source?.bairro || detailMap['bairro'] || '-',
          'Observacoes': source?.observacoes || detailMap['observações'] || detailMap['observacoes'] || '-',
        },
      };
    }

    function ensurePerfilDashboardModal() {
      let el = document.getElementById('perfil-pessoa-modal');
      if (el) {
        const existingInstance = bootstrap.Modal.getInstance(el);
        if (existingInstance) existingInstance.dispose();
        return el;
      }

      el = document.createElement('div');
      el.id = 'perfil-pessoa-modal';
      el.tabIndex = -1;
      el.setAttribute('aria-hidden', 'true');
      document.body.appendChild(el);
      return el;
    }

    function abrirPerfilCard(trigger) {
      const card = trigger?.closest('.pcard');
      if (!card) return;

      const profile = getProfileInfoFromCard(card);
      if (!profile) return;

      const isDarkTheme = document.documentElement.getAttribute('data-theme') === 'dark' || !document.documentElement.getAttribute('data-theme');
      const colors = isDarkTheme ? {
        overlay: 'rgba(2, 6, 23, 0.58)',
        surface: 'linear-gradient(156deg, rgba(6, 12, 24, 0.96) 0%, rgba(16, 28, 50, 0.95) 100%)',
        border: 'rgba(148, 163, 184, 0.30)',
        borderSoft: 'rgba(148, 163, 184, 0.18)',
        title: '#f8fafc',
        subtitle: 'rgba(186, 230, 253, 0.85)',
        text: '#e2e8f0',
        muted: 'rgba(148, 163, 184, 0.88)',
        chipBg: 'rgba(14, 116, 144, 0.28)',
        chipText: '#bae6fd',
        cardBg: 'rgba(15, 23, 42, 0.52)',
        shadow: '0 26px 58px rgba(2, 6, 23, 0.62), 0 1px 0 rgba(255,255,255,0.08) inset',
        closeClass: 'btn-close-white'
      } : {
        overlay: 'rgba(15, 23, 42, 0.38)',
        surface: 'linear-gradient(150deg, #ffffff 0%, #f7fbff 55%, #eff6ff 100%)',
        border: 'rgba(30, 64, 175, 0.16)',
        borderSoft: 'rgba(30, 64, 175, 0.10)',
        title: '#0f172a',
        subtitle: 'rgba(30, 64, 175, 0.82)',
        text: '#1e293b',
        muted: 'rgba(71, 85, 105, 0.92)',
        chipBg: 'rgba(14, 165, 233, 0.14)',
        chipText: '#075985',
        cardBg: 'rgba(248, 250, 252, 0.92)',
        shadow: '0 24px 52px rgba(15, 23, 42, 0.18), 0 1px 0 rgba(255,255,255,0.9) inset',
        closeClass: 'btn-close'
      };

      const renderField = (icon, label, value, extraClass = '') => `
        <article class="perfil-pessoa-field ${extraClass}">
          <span class="perfil-pessoa-field-icon" aria-hidden="true"><i class="fas ${icon}"></i></span>
          <div class="perfil-pessoa-field-copy">
            <span class="perfil-pessoa-field-label">${escapeHtml(label)}</span>
            <span class="perfil-pessoa-field-value">${escapeHtml(value || '-')}</span>
          </div>
        </article>
      `;

      const fieldsHtml = [
        renderField('fa-tag', 'Como quer ser chamado', profile.fields['Como quer ser chamado']),
        renderField('fa-venus-mars', 'Genero', profile.fields['Genero']),
        renderField('fa-calendar-day', 'Data de nascimento', profile.fields['Data de nascimento']),
        renderField('fa-phone', 'Telefone', profile.fields['Telefone']),
        renderField('fa-envelope', 'Email', profile.fields['Email'], 'is-email'),
        renderField('fa-church', 'EJC', profile.fields['EJC']),
        renderField('fa-location-dot', 'CEP', profile.fields['CEP']),
        renderField('fa-road', 'Endereco', profile.fields['Endereco']),
        renderField('fa-map-pin', 'Bairro', profile.fields['Bairro']),
        renderField('fa-note-sticky', 'Observacoes', profile.fields['Observacoes']),
      ].join('');

      const modalEl = ensurePerfilDashboardModal();
      modalEl.className = `modal fade perfil-pessoa-modal ${isDarkTheme ? 'perfil-theme-dark' : 'perfil-theme-light'}`;
      modalEl.style.setProperty('--perfil-overlay', colors.overlay);
      modalEl.style.setProperty('--perfil-surface', colors.surface);
      modalEl.style.setProperty('--perfil-border', colors.border);
      modalEl.style.setProperty('--perfil-border-soft', colors.borderSoft);
      modalEl.style.setProperty('--perfil-title', colors.title);
      modalEl.style.setProperty('--perfil-subtitle', colors.subtitle);
      modalEl.style.setProperty('--perfil-text', colors.text);
      modalEl.style.setProperty('--perfil-muted', colors.muted);
      modalEl.style.setProperty('--perfil-chip-bg', colors.chipBg);
      modalEl.style.setProperty('--perfil-chip-text', colors.chipText);
      modalEl.style.setProperty('--perfil-card-bg', colors.cardBg);
      modalEl.style.setProperty('--perfil-shadow', colors.shadow);

      modalEl.innerHTML = `
        <div class="modal-dialog modal-dialog-scrollable perfil-pessoa-dialog">
          <div class="modal-content perfil-pessoa-card">
            <div class="modal-header perfil-pessoa-header">
              <div class="perfil-pessoa-headline">
                <span class="perfil-pessoa-badge">Ficha completa</span>
                <h5 class="modal-title">Perfil do ${escapeHtml(profile.tipoCadastro)}</h5>
              </div>
              <button type="button" class="btn-close ${colors.closeClass}" data-bs-dismiss="modal" aria-label="Fechar"></button>
            </div>
            <div class="modal-body perfil-pessoa-body">
              <section class="perfil-pessoa-hero">
                ${profile.foto
                  ? `<img src="${escapeHtml(profile.foto)}" alt="Foto" class="perfil-pessoa-avatar">`
                  : `<div class="perfil-pessoa-avatar perfil-pessoa-avatar-placeholder"><i class="fas fa-user-circle"></i></div>`}
                <div class="perfil-pessoa-main-info">
                  <h3>${escapeHtml(profile.nome)}</h3>
                  <p>${escapeHtml(profile.tipoCadastro)}</p>
                </div>
              </section>
              <div class="perfil-pessoa-grid">
                ${fieldsHtml}
              </div>
            </div>
            <div class="modal-footer perfil-pessoa-footer">
              <button type="button" class="btn perfil-pessoa-close-btn" data-bs-dismiss="modal">Fechar</button>
            </div>
          </div>
        </div>
      `;

      const liberarScrollPagina = () => {
        document.body.classList.remove('modal-open');
        document.body.style.overflowY = 'auto';
        document.body.style.removeProperty('padding-right');
      };

      let perfilScrollRafId = null;
      const syncModalWithPageScroll = () => {
        modalEl.style.top = `${Math.max(0, window.scrollY)}px`;
      };

      const requestModalScrollSync = () => {
        if (perfilScrollRafId !== null) return;
        perfilScrollRafId = window.requestAnimationFrame(() => {
          perfilScrollRafId = null;
          syncModalWithPageScroll();
        });
      };

      const enableFollowScroll = () => {
        modalEl.classList.add('perfil-pessoa-follow-scroll');
        syncModalWithPageScroll();
        window.addEventListener('scroll', requestModalScrollSync, { passive: true });
        window.addEventListener('resize', requestModalScrollSync);
      };

      const restaurarScrollPadrao = () => {
        if (perfilScrollRafId !== null) {
          window.cancelAnimationFrame(perfilScrollRafId);
          perfilScrollRafId = null;
        }
        window.removeEventListener('scroll', requestModalScrollSync);
        window.removeEventListener('resize', requestModalScrollSync);
        modalEl.classList.remove('perfil-pessoa-follow-scroll');
        modalEl.style.removeProperty('top');
        document.body.style.removeProperty('overflow-y');
      };

      modalEl.addEventListener('shown.bs.modal', () => {
        liberarScrollPagina();
        if (getPerfilModalScrollMode() === 'follow') {
          enableFollowScroll();
        }
      }, { once: true });
      modalEl.addEventListener('hidden.bs.modal', restaurarScrollPadrao, { once: true });

      const modal = new bootstrap.Modal(modalEl, {
        backdrop: true,
        keyboard: true,
        focus: true,
      });
      modal.show();
    }

    function toggleCardDetails(trigger) {
      abrirPerfilCard(trigger);
    }

    /* -- Actions ----------------------------------------------- */
    async function aprovarCadastro(id, tipoLista) {
      if (!await appConfirm('Tem certeza que deseja aprovar este cadastro?', 'Confirmar aprova��o')) return;
      const card = document.querySelector(`.pcard[data-id="${id}"][data-tipo="${tipoLista}"]`);
      setCardPendingState(card, 'approve');
      try {
        const res  = await fetch('/admin/aprovar', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ id, tipoLista }) });
        const data = await res.json();
        if (data.success) {
          moveApprovalCard(card, 'aprovado');
          await appAlert('Cadastro aprovado com sucesso.', 'success', 'Sucesso');
        }
        else {
          setCardPendingState(card);
          await appAlert('Erro: ' + (data.error || 'Falha ao aprovar'), 'danger', 'Erro');
        }
      } catch (e) {
        setCardPendingState(card);
        await appAlert('Erro: ' + e.message, 'danger', 'Erro');
      }
    }

    async function desaprovarCadastro(id, tipoLista) {
      if (!await appConfirm('Tem certeza que deseja desaprovar este cadastro?', 'Confirmar desaprova��o')) return;
      const card = document.querySelector(`.pcard[data-id="${id}"][data-tipo="${tipoLista}"]`);
      setCardPendingState(card, 'reject');
      try {
        const res  = await fetch('/admin/desaprovar', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ id, tipoLista }) });
        const data = await res.json();
        if (data.success) {
          moveApprovalCard(card, 'reprovado');
          await appAlert('Cadastro desaprovado com sucesso.', 'success', 'Sucesso');
        }
        else {
          setCardPendingState(card);
          await appAlert('Erro: ' + (data.error || 'Falha ao desaprovar'), 'danger', 'Erro');
        }
      } catch (e) {
        setCardPendingState(card);
        await appAlert('Erro: ' + e.message, 'danger', 'Erro');
      }
    }
  </script>
  <script src="/js/page-transitions.js?v=20260422-remove-floating-theme-toggle-28"></script>
</body>
