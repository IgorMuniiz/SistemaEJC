    function setupEventScopeControls() {
      const buttons = Array.from(document.querySelectorAll('.event-scope-btn[data-event-scope]'));
      if (buttons.length === 0) return;

      buttons.forEach((button) => {
        button.addEventListener('click', async () => {
          const nextScope = button.dataset.eventScope === 'todos' ? 'todos' : 'ativo';
          buttons.forEach((b) => {
            const active = b === button;
            b.classList.toggle('active', active);
            b.setAttribute('aria-pressed', String(active));
            b.disabled = true;
          });

          try {
            const res = await fetch('/admin/evento-scope', {
              method: 'POST',
              headers: {
                'Content-Type': 'application/json',
                'X-CSRF-Token': adminCsrfToken,
              },
              body: JSON.stringify({ scope: nextScope }),
            });
            const data = await res.json();
            if (!res.ok || !data.success) {
              throw new Error(data.error || 'Falha ao trocar escopo de evento.');
            }

            window.location.reload();
          } catch (error) {
            buttons.forEach((b) => {
              b.disabled = false;
            });
            await appAlert('Erro: ' + error.message, 'danger', 'Escopo de evento');
          }
        });
      });
    }

    function formatarDataCurta(dateIso) {
      if (!dateIso) return 'Data n�o informada';
      const data = new Date(`${dateIso}T00:00:00`);
      if (Number.isNaN(data.getTime())) return 'Data n�o informada';
      return data.toLocaleDateString('pt-BR');
    }

    function prefersReducedDashboardMotion() {
      return window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    }

    function pulseUiElement(element, className = 'is-bumping', duration = 720) {
      if (!element || prefersReducedDashboardMotion()) return;
      element.classList.remove(className);
      void element.offsetWidth;
      element.classList.add(className);
      window.setTimeout(() => element.classList.remove(className), duration);
    }

    function setCardPendingState(card, tone = null) {
