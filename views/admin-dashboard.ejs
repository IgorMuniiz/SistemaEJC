  <script>
    const adminCsrfToken = '<%= adminCsrfToken %>';

    function getPerfilModalScrollMode() {
      const datasetMode = String(document.body?.dataset?.perfilModalScroll || '').trim().toLowerCase();
      if (datasetMode === 'fixed' || datasetMode === 'follow') return datasetMode;

      const windowMode = String(window?.EJC_PROFILE_MODAL_SCROLL_MODE || '').trim().toLowerCase();
      if (windowMode === 'fixed' || windowMode === 'follow') return windowMode;

      return 'follow';
    }

    /* -- Modal helper ------------------------------------------ */
    function ensureAppPopup() {
      let el = document.getElementById('app-popup-modal');
      if (el) return { element: el, instance: bootstrap.Modal.getOrCreateInstance(el) };
      el = document.createElement('div');
      el.className = 'modal fade';
      el.id = 'app-popup-modal';
      el.tabIndex = -1;
      el.setAttribute('aria-hidden', 'true');
      el.innerHTML = `
        <div class="modal-dialog modal-dialog-centered app-popup-dialog">
          <div class="modal-content app-popup-content app-popup-tone-primary">
            <div class="modal-header app-popup-header">
              <div class="app-popup-headline">
