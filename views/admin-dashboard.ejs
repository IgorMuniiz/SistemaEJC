    function syncCardTimeline(card, status) {
      const timelineStatus = status === 'aprovado' ? 'Aprovado' : status === 'reprovado' ? 'Reprovado' : 'Em an�lise';
      const timelineValue = card.querySelector('.pcard-timeline li:last-child strong');
