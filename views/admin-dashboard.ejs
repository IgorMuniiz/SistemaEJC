    function getColumnByStatus(scope, status) {
      const panel = getPanelByScope(scope);
      if (!panel) return null;

      if (status === 'aprovado') return panel.querySelector('.kanban-col.col-aprovado');
      if (status === 'reprovado') return panel.querySelector('.kanban-col.col-reprovado');
      return panel.querySelector('.kanban-col.col-pendente');
    }

    function syncColumnEmptyState(scope, status) {
      const column = getColumnByStatus(scope, status);
      if (!column) return;

      const existingDynamicEmpty = column.querySelector('.empty-col.dynamic-empty');
      const staticEmpty = column.querySelector('.empty-col:not(.dynamic-empty)');
      const cards = Array.from(column.querySelectorAll('.pcard'));

      if (cards.length > 0) {
        if (staticEmpty) staticEmpty.remove();
        return;
      }

      if (existingDynamicEmpty || staticEmpty) return;

      const copy = getStatusCopy(status);
      const empty = document.createElement('div');
      empty.className = 'empty-col';
      empty.innerHTML = `<div class="empty-col-icon"><i class="fas fa-inbox"></i></div><p class="empty-col-text">${copy.emptyText}</p>`;
      column.appendChild(empty);
    }

    function syncPanelMeta(scope, options = {}) {
      const panel = getPanelByScope(scope);
      if (!panel) return;
      const shouldAnimate = options.animate !== false;

      const pendentes = panel.querySelectorAll('.pcard[data-status="pendente"]').length;
      const aprovados = panel.querySelectorAll('.pcard[data-status="aprovado"]').length;
      const reprovados = panel.querySelectorAll('.pcard[data-status="reprovado"]').length;
      const chips = panel.querySelectorAll('.section-meta .meta-chip');

      if (chips[0]) chips[0].innerHTML = `<i class="fas fa-clock"></i>${pendentes} pendente(s)`;
      if (chips[1]) chips[1].innerHTML = `<i class="fas fa-check"></i>${aprovados} aprovado(s)`;
      if (chips[2]) chips[2].innerHTML = `<i class="fas fa-xmark"></i>${reprovados} reprovado(s)`;
      if (shouldAnimate) {
        chips.forEach((chip) => pulseUiElement(chip));
      }
    }

    function rebuildCardActions(card, scope, status) {
      const actions = card.querySelector('.pcard-actions');
      if (!actions) return;

      const id = card.dataset.id || '';
      const copy = getStatusCopy(status);
      actions.innerHTML = `
        <button class="pcard-btn approve" onclick="aprovarCadastro('${id}', '${scope}')">${copy.primaryAction}</button>
        <button class="pcard-btn reject" onclick="desaprovarCadastro('${id}', '${scope}')">${copy.secondaryAction}</button>
        <button class="pcard-btn details" type="button" onclick="toggleCardDetails(this)"><i class="fas fa-eye"></i>Ver detalhes</button>
