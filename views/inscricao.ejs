<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="Formul&aacute;rio de inscri&ccedil;&atilde;o para o EJC" />
  <meta name="theme-color" media="(prefers-color-scheme: light)" content="#f7fbff" />
  <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#0a0a14" />
  <title>Inscri&ccedil;&atilde;o EJC - Cadastro</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="preload" href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=Sora:wght@500;600;700&display=swap" as="style" onload="this.onload=null;this.rel='stylesheet'">
  <noscript><link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=Sora:wght@500;600;700&display=swap" rel="stylesheet"></noscript>
  <link rel="preconnect" href="https://unpkg.com" crossorigin>
  <link rel="preload" href="/vendor/bootstrap/css/bootstrap.min.css" as="style" onload="this.onload=null;this.rel='stylesheet'">
  <noscript><link rel="stylesheet" href="/vendor/bootstrap/css/bootstrap.min.css"></noscript>
  <link rel="preload" href="/vendor/fontawesome/css/all.min.css" as="style" onload="this.onload=null;this.rel='stylesheet'">
  <noscript><link rel="stylesheet" href="/vendor/fontawesome/css/all.min.css"></noscript>
  <link rel="stylesheet" href="/css/style.css?v=20260531-premium-rebuild-01" />
</head>
<body class="portal-page">
  <div class="portal-ambient" aria-hidden="true">
    <div class="portal-grid"></div>
    <div class="portal-orb portal-orb-a"></div>
    <div class="portal-orb portal-orb-b"></div>
    <div class="portal-orb portal-orb-c"></div>
  </div>

  <% if (locals.bloqueado) { %>
  <main role="main" class="portal-blocked-shell">
    <div class="portal-blocked-card">
      <div class="portal-blocked-icon">&#128274;</div>
      <h2 class="portal-blocked-title">Inscricoes Encerradas</h2>
      <p class="portal-blocked-text">
        <%= locals.motivoBloqueio || 'O formulario de inscricao esta temporariamente indisponivel.' %>
      </p>
      <a href="/" class="portal-blocked-link">&#8592; Voltar &agrave; p&aacute;gina inicial</a>
    </div>
  </main>
  <% } else { %>
  <main id="root" role="main">
    <div class="container py-5" id="portal-loading-fallback">
      <div class="alert alert-info text-center" role="status" aria-live="polite">
        <h2 class="h5 mb-2">Carregando formulario de inscricao...</h2>
        <p class="mb-0">Se esta mensagem nao sumir em alguns segundos, verifique sua conexao e tente recarregar a pagina.</p>
      </div>
      <noscript>
        <div class="alert alert-warning mt-3" role="alert">
          Este formulario precisa de JavaScript habilitado para funcionar.
        </div>
      </noscript>
    </div>
  </main>
  <% } %>

  <footer class="portal-footer text-center py-3">
    <div class="container">
      <small>&copy; 2026 EJC - Todos os direitos reservados</small>
    </div>
  </footer>

  <% if (!locals.bloqueado) { %>
  <script>
    window.__EJC_ATIVO__ = <%- JSON.stringify(locals.ejcAtivo || '') %>;
  </script>
  <!-- React and dependencies -->
  <script defer src="https://unpkg.com/react@18/umd/react.production.min.js" crossorigin></script>
  <script defer src="https://unpkg.com/react-dom@18/umd/react-dom.production.min.js" crossorigin></script>
  <script defer src="/dist/bundle.js?v=20260618-runtime-free-01"></script>
  <% } %>
  <script>
    setTimeout(() => {
      const root = document.getElementById('root');
      if (!root) return;

      const appMounted = root.dataset.mounted === 'true';
      const dependenciesReady = Boolean(window.React && window.ReactDOM);
      if (appMounted || dependenciesReady) return;

      fetch('/api/frontend-diagnostics', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          event: 'form_boot_failed',
          page: 'inscricao',
          reason: 'react_or_bundle_not_loaded',
          href: window.location.href,
          userAgent: navigator.userAgent,
        }),
      }).catch(() => {});

      root.innerHTML = `
        <div class="container py-5">
          <div class="alert alert-warning" role="alert">
            <h2 class="h5 mb-2">Nao foi possivel carregar o formulario.</h2>
            <p class="mb-2">Falha ao carregar recursos da pagina. Tente atualizar ou abrir novamente em alguns instantes.</p>
            <a href="/" class="btn btn-outline-primary btn-sm">Voltar para a pagina inicial</a>
          </div>
        </div>
      `;
    }, 4500);

    const deferHeavyWork = (callback) => {
      if ('requestIdleCallback' in window) {
        window.requestIdleCallback(callback, { timeout: 3000 });
      } else {
        setTimeout(callback, 1200);
      }
    };

    const isLocalhost = ['localhost', '127.0.0.1'].includes(window.location.hostname);
    if ('serviceWorker' in navigator) {
      if (isLocalhost) {
        navigator.serviceWorker.getRegistrations().then((registrations) => {
          registrations.forEach((r) => r.unregister());
        });
        if ('caches' in window) {
          caches.keys().then((keys) => keys.forEach((key) => caches.delete(key)));
        }
      } else {
        deferHeavyWork(() => {
          navigator.serviceWorker.register('/sw.js')
            .then((registration) => {
              console.log('Service worker registered');
              registration.update();
              navigator.serviceWorker.ready.then(reg => {
                reg.pushManager.getSubscription().then(sub => {
                  if (sub) return;
                  fetch('/vapidPublicKey').then(r => r.text()).then(key => {
                    const vapidKey = urlBase64ToUint8Array(key);
                    reg.pushManager.subscribe({
                      userVisibleOnly: true,
                      applicationServerKey: vapidKey
                    }).then(newSub => {
                      fetch('/subscribe', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(newSub)
                      });
                    });
                  });
                });
              });
            })
            .catch((err) => console.warn('SW registration failed', err));
        });
      }
    }

    function urlBase64ToUint8Array(base64String) {
      const padding = '='.repeat((4 - base64String.length % 4) % 4);
      const base64 = (base64String + padding).replace(/-/g, '+').replace(/_/g, '/');
      const rawData = window.atob(base64);
      const outputArray = new Uint8Array(rawData.length);
      for (let i = 0; i < rawData.length; ++i) {
        outputArray[i] = rawData.charCodeAt(i);
      }
      return outputArray;
    }

  </script>
  <script defer src="/js/page-transitions.js?v=20260417-premium-feedback-27"></script>
</body>
</html>
