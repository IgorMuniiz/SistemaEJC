<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="Confirmação de envio de inscrição EJC" />
  <meta name="theme-color" media="(prefers-color-scheme: light)" content="#f7fbff" />
  <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#0a0a14" />
  <title>Inscrição enviada - EJC</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="preload" href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=Sora:wght@500;600;700&display=swap" as="style" onload="this.onload=null;this.rel='stylesheet'">
  <noscript><link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=Sora:wght@500;600;700&display=swap" rel="stylesheet"></noscript>
  <link rel="preload" href="/vendor/bootstrap/css/bootstrap.min.css" as="style" onload="this.onload=null;this.rel='stylesheet'">
  <noscript><link rel="stylesheet" href="/vendor/bootstrap/css/bootstrap.min.css"></noscript>
  <link rel="preload" href="/vendor/fontawesome/css/all.min.css" as="style" onload="this.onload=null;this.rel='stylesheet'">
  <noscript><link rel="stylesheet" href="/vendor/fontawesome/css/all.min.css"></noscript>
  <link rel="stylesheet" href="/css/style.css?v=20260417-buttons-premium-15" />
</head>
<body class="portal-success-page">
  <% const title = typeof successTitle === 'string' && successTitle ? successTitle : 'Inscrição confirmada'; %>
  <% const description = typeof successText === 'string' && successText ? successText : 'Recebemos seus dados com sucesso. Obrigado por fazer parte do EJC COP. Se desejar, você pode iniciar uma nova inscrição ou voltar para a página principal.'; %>
  <% const primaryHref = typeof successPrimaryHref === 'string' && successPrimaryHref ? successPrimaryHref : '/inscricao'; %>
  <% const primaryLabel = typeof successPrimaryLabel === 'string' && successPrimaryLabel ? successPrimaryLabel : 'Fazer novo cadastro'; %>
  <% const secondaryHref = typeof successSecondaryHref === 'string' && successSecondaryHref ? successSecondaryHref : '/'; %>
  <% const secondaryLabel = typeof successSecondaryLabel === 'string' && successSecondaryLabel ? successSecondaryLabel : 'Voltar ao menu principal'; %>
  <div class="portal-ambient" aria-hidden="true">
    <div class="portal-grid"></div>
    <div class="portal-orb portal-orb-a"></div>
    <div class="portal-orb portal-orb-b"></div>
    <div class="portal-orb portal-orb-c"></div>
  </div>

  <main class="portal-success-shell" role="main">
    <div class="portal-success-icon">
      <i class="fas fa-check"></i>
    </div>
    <h1 class="portal-success-title"><%= title %></h1>
    <p class="portal-success-text"><%= description %></p>

    <div class="portal-success-actions">
      <a href="<%= primaryHref %>" class="btn btn-primary">
        <i class="fas fa-user-plus"></i>
        <%= primaryLabel %>
      </a>
      <a href="<%= secondaryHref %>" class="btn btn-glass">
        <i class="fas fa-home"></i>
        <%= secondaryLabel %>
      </a>
    </div>
  </main>

  <footer class="portal-footer text-center py-3">
    <div class="container">
      <small>© 2026 EJC - Todos os direitos reservados</small>
    </div>
  </footer>
  <script defer src="/js/page-transitions.js?v=20260417-premium-feedback-27"></script>
</body>
</html>