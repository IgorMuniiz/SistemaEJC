    function scrollParaConteudoDaAba(targetPane) {
      const anchor = document.getElementById('cadastroTabs') || targetPane;
      if (!anchor || typeof anchor.scrollIntoView !== 'function') return;

      window.requestAnimationFrame(() => {
        anchor.scrollIntoView({ behavior: 'smooth', block: 'start' });
      });
    }

    function abrirAba(tabId, options = {}) {
      const tabButton = document.getElementById(tabId);
      const shouldScroll = options.scroll !== false && options.shouldScroll !== false;

      if (!tabButton || window.getComputedStyle(tabButton).display === 'none') {
        return;
      }

      let targetPane = getTabPaneFromButton(tabButton);

      try {
        if (window.bootstrap && bootstrap.Tab) {
          bootstrap.Tab.getOrCreateInstance(tabButton).show();
          targetPane = getTabPaneFromButton(tabButton);
        } else {
          targetPane = ativarAbaSemBootstrap(tabButton);
        }
      } catch (error) {
        console.error('[abrirAba] fallback manual acionado:', error);
        targetPane = ativarAbaSemBootstrap(tabButton);
      }

      promoverSecaoAdministradores(tabId);
      atualizarNavegacaoAtiva(tabId);
      salvarAbaAtiva();

      if (shouldScroll) {
        scrollParaConteudoDaAba(targetPane);
      }
    }

    function bindTabTriggers() {
      document.querySelectorAll('[data-tab-target]').forEach((trigger) => {
        if (trigger.dataset.tabBound === 'true') return;
        trigger.dataset.tabBound = 'true';

        trigger.addEventListener('click', (event) => {
          const tabTarget = trigger.getAttribute('data-tab-target');
          if (!tabTarget) return;

          const isAnchorTrigger = trigger.tagName === 'A' && !!trigger.getAttribute('href');
          if (isAnchorTrigger) {
            try {
              localStorage.setItem('admin_gerenciar_cadastros_aba_ativa', tabTarget.replace(/-tab$/, ''));
            } catch (error) {
              // Ignora falhas de armazenamento e deixa a navegação seguir normalmente.
            }

            abrirAba(tabTarget, { shouldScroll: false });
            return;
          }

          event.preventDefault();
          abrirAba(tabTarget);
        });
      });
    }

    function promoverSecaoAdministradores(tabId) {
      const adminPane = document.getElementById('administradores');
      const tabsContent = document.getElementById('cadastroTabsContent');
      if (!adminPane || !tabsContent) return;

      if (tabsContent.firstElementChild !== adminPane) {
        tabsContent.prepend(adminPane);
      }

      const abaAtiva = tabId || ((document.querySelector('#cadastroTabs .nav-link.active') || {}).id);
      const isAdministradores = abaAtiva === 'administradores-tab';

      adminPane.classList.toggle('admin-pane-persistent', isAdministradores);
      adminPane.classList.toggle('show', isAdministradores);
      adminPane.classList.toggle('active', isAdministradores);
      adminPane.classList.toggle('fade', !isAdministradores);
      adminPane.hidden = !isAdministradores;
      adminPane.style.display = isAdministradores ? 'block' : '';
    }

    function setupAdminKeyboardShortcuts() {
      const tabsByShortcut = {
        '1': 'principal-tab',
        '2': 'encontristas-tab',
        '3': 'encontreiros-tab',
        '4': 'tios-tab',
        '5': 'aprovacoes-tab',
        '6': 'encontros-tab',
        '7': 'subequipes-tab',
        '8': 'gastos-tab',
        '9': 'administradores-tab',
      };

      document.addEventListener('keydown', (event) => {
        const key = String(event.key || '').toLowerCase();
        const target = event.target;
        const isTyping = target && (
          target.tagName === 'INPUT'
          || target.tagName === 'TEXTAREA'
          || target.tagName === 'SELECT'
          || target.isContentEditable
        );

        if (isTyping) return;
        if (!event.altKey) return;

        if (tabsByShortcut[key]) {
          event.preventDefault();
          abrirAba(tabsByShortcut[key]);
          return;
        }

        if (key === 'd') {
          event.preventDefault();
          window.location.href = '/admin/dashboard';
          return;
        }

        if (key === 's') {
          event.preventDefault();
          const activePane = document.querySelector('.tab-pane.active.show') || document;
          const saveButton = activePane.querySelector('.admin-primary-action, .btn-primary, button[type="submit"]');
          if (saveButton && !saveButton.disabled) {
            saveButton.click();
          }
        }
      });
    }

    function atualizarNavegacaoAtiva(tabButtonId) {
      document.querySelectorAll('[data-tab-target]').forEach((item) => {
        item.classList.toggle('active', item.dataset.tabTarget === tabButtonId);
      });
