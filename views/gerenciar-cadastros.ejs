          }

          #beautiful-dialog-close:hover {
            opacity: 1;
            transform: translateY(-1px);
            background: rgba(30, 41, 59, 0.78);
          }

          #beautiful-dialog-body {
            position: relative;
            z-index: 1;
            padding: 20px 20px 10px;
            color: #e6eeff;
            font-size: 0.98rem;
            line-height: 1.6;
            background: transparent;
            overflow-y: auto;
          }

          #beautiful-dialog-note {
            margin-top: 14px;
            padding: 12px 14px;
            border-radius: 18px;
            border: 1px solid rgba(148, 163, 184, 0.14);
            background: rgba(15, 23, 42, 0.48);
            color: rgba(191, 219, 254, 0.88);
            font-size: 0.84rem;
            line-height: 1.55;
          }

          #beautiful-dialog-input-wrap {
            position: relative;
            z-index: 1;
            padding: 0 20px 14px;
            background: transparent;
            display: none;
          }

          #beautiful-dialog-field-label {
            display: block;
            margin: 0 0 8px;
            color: rgba(191, 219, 254, 0.9);
            font-size: 0.8rem;
            font-weight: 700;
            letter-spacing: 0.04em;
            text-transform: uppercase;
          }

          #beautiful-dialog-input,
          #beautiful-dialog-select {
            width: 100%;
            min-height: 52px;
            border: 1px solid rgba(148, 163, 184, 0.26);
            background: rgba(15, 23, 42, 0.78);
            color: #f4f7ff;
            border-radius: 16px;
            padding: 12px 14px;
            font-size: 1rem;
            outline: none;
            box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.04);
          }

          #beautiful-dialog-select {
            appearance: none;
            -webkit-appearance: none;
            background-image: linear-gradient(45deg, transparent 50%, rgba(191, 219, 254, 0.92) 50%), linear-gradient(135deg, rgba(191, 219, 254, 0.92) 50%, transparent 50%);
            background-position: calc(100% - 20px) calc(50% - 3px), calc(100% - 14px) calc(50% - 3px);
            background-size: 6px 6px, 6px 6px;
            background-repeat: no-repeat;
            padding-right: 44px;
          }

          #beautiful-dialog-input:focus,
          #beautiful-dialog-select:focus {
            border-color: rgba(96, 165, 250, 0.48);
            box-shadow: 0 0 0 0.24rem rgba(37, 99, 235, 0.18);
          }

          #beautiful-dialog-footer {
            position: relative;
            z-index: 1;
            padding: 12px 20px 18px;
            background: rgba(15, 23, 42, 0.4);
            display: flex;
            gap: 10px;
            justify-content: flex-end;
            flex-wrap: wrap;
            border-top: 1px solid rgba(148, 163, 184, 0.16);
          }

          .beautiful-dialog-btn {
            min-height: 46px;
            border-radius: 14px;
            font-weight: 800;
            font-size: 0.96rem;
            padding: 10px 20px;
            cursor: pointer;
            min-width: 128px;
            transition: transform 0.18s ease, box-shadow 0.18s ease, filter 0.18s ease;
          }

          .beautiful-dialog-btn:hover {
            transform: translateY(-1px);
            filter: brightness(1.04);
          }

          #beautiful-dialog-cancel {
            background: rgba(30, 41, 59, 0.58);
            color: #dce7ff;
            border: 1px solid rgba(148, 163, 184, 0.34);
            display: none;
          }

          #beautiful-dialog-confirm {
            border: none;
            background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%);
            color: #ffffff;
            box-shadow: 0 14px 28px rgba(37, 99, 235, 0.34);
          }

          #beautiful-dialog-confirm.danger {
            background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%);
            box-shadow: 0 14px 28px rgba(239, 68, 68, 0.28);
          }

          #beautiful-dialog-card.tone-warning #beautiful-dialog-header {
            background: linear-gradient(90deg, rgba(245, 158, 11, 0.28), rgba(15, 23, 42, 0.9));
          }

          #beautiful-dialog-card.tone-warning #beautiful-dialog-orb {
            background: linear-gradient(145deg, rgba(251, 191, 36, 0.24), rgba(245, 158, 11, 0.12));
            border-color: rgba(252, 211, 77, 0.24);
            color: rgba(254, 249, 195, 0.98);
            box-shadow: 0 18px 30px rgba(245, 158, 11, 0.16);
          }

          #beautiful-dialog-card.tone-success #beautiful-dialog-header {
            background: linear-gradient(90deg, rgba(34, 197, 94, 0.24), rgba(15, 23, 42, 0.9));
          }

          #beautiful-dialog-card.tone-success #beautiful-dialog-orb {
            background: linear-gradient(145deg, rgba(74, 222, 128, 0.24), rgba(34, 197, 94, 0.12));
            border-color: rgba(134, 239, 172, 0.24);
            color: rgba(220, 252, 231, 0.98);
            box-shadow: 0 18px 30px rgba(34, 197, 94, 0.16);
          }

          #beautiful-dialog-card.tone-danger #beautiful-dialog-header {
            background: linear-gradient(90deg, rgba(239, 68, 68, 0.24), rgba(15, 23, 42, 0.9));
          }

          #beautiful-dialog-card.tone-danger #beautiful-dialog-orb {
            background: linear-gradient(145deg, rgba(248, 113, 113, 0.24), rgba(239, 68, 68, 0.12));
            border-color: rgba(252, 165, 165, 0.24);
            color: rgba(254, 226, 226, 0.98);
            box-shadow: 0 18px 30px rgba(239, 68, 68, 0.16);
          }

          @media (max-width: 640px) {
            #beautiful-dialog-card {
              width: calc(100vw - 16px);
              max-height: calc(100vh - 16px);
            }

            #beautiful-dialog-headline {
              align-items: flex-start;
              gap: 10px;
            }

            #beautiful-dialog-orb {
              width: 44px;
              height: 44px;
              border-radius: 15px;
              font-size: 0.98rem;
            }

            #beautiful-dialog-title {
              font-size: 1rem;
            }

            #beautiful-dialog-body {
              font-size: 0.94rem;
            }

            .beautiful-dialog-btn {
              flex: 1;
              min-width: 96px;
            }
          }
        </style>

        <div id="beautiful-dialog-overlay" aria-hidden="true">
          <div id="beautiful-dialog-card" role="dialog" aria-modal="true" aria-labelledby="beautiful-dialog-title">
            <div id="beautiful-dialog-header">
              <div id="beautiful-dialog-headline">
                <div id="beautiful-dialog-orb" aria-hidden="true"><i class="fas fa-sparkles"></i></div>
                <div id="beautiful-dialog-title-stack">
                  <span id="beautiful-dialog-kicker">Ação rápida</span>
                  <h3 id="beautiful-dialog-title">Aviso</h3>
                </div>
              </div>
              <button type="button" id="beautiful-dialog-close" aria-label="Fechar">×</button>
            </div>
            <div id="beautiful-dialog-body">
              <div id="beautiful-dialog-message"></div>
              <div id="beautiful-dialog-note"></div>
            </div>
            <div id="beautiful-dialog-input-wrap">
              <label id="beautiful-dialog-field-label" for="beautiful-dialog-input">Valor</label>
              <input type="text" id="beautiful-dialog-input" autocomplete="off" />
              <select id="beautiful-dialog-select"></select>
            </div>
            <div id="beautiful-dialog-footer">
              <button type="button" id="beautiful-dialog-cancel" class="beautiful-dialog-btn">Cancelar</button>
              <button type="button" id="beautiful-dialog-confirm" class="beautiful-dialog-btn">OK</button>
            </div>
          </div>
        </div>
      `;

      const wrapper = document.createElement('div');
      wrapper.innerHTML = html;
      while (wrapper.firstChild) {
        document.documentElement.appendChild(wrapper.firstChild);
      }

      overlay = document.getElementById('beautiful-dialog-overlay');
      return overlay;
    }

    function showBeautifulDialog({ title, message, isPrompt = false, inputMode = null, defaultValue = '', isDanger = false, confirmText = 'OK', cancelText = null, tone = 'primary', fieldLabel = '', selectOptions = [] }) {
      const overlay = createBeautifulDialog();
      const cardEl = document.getElementById('beautiful-dialog-card');
      const kickerEl = document.getElementById('beautiful-dialog-kicker');
      const orbEl = document.getElementById('beautiful-dialog-orb');
      const titleEl = document.getElementById('beautiful-dialog-title');
      const messageEl = document.getElementById('beautiful-dialog-message');
      const noteEl = document.getElementById('beautiful-dialog-note');
      const inputWrap = document.getElementById('beautiful-dialog-input-wrap');
      const fieldLabelEl = document.getElementById('beautiful-dialog-field-label');
      const inputEl = document.getElementById('beautiful-dialog-input');
      const selectEl = document.getElementById('beautiful-dialog-select');
      const confirmBtn = document.getElementById('beautiful-dialog-confirm');
      const cancelBtn = document.getElementById('beautiful-dialog-cancel');
      const closeBtn = document.getElementById('beautiful-dialog-close');

      if (!overlay || !cardEl || !kickerEl || !orbEl || !titleEl || !messageEl || !noteEl || !inputWrap || !fieldLabelEl || !inputEl || !selectEl || !confirmBtn || !cancelBtn || !closeBtn) {
        return Promise.reject(new Error('Dialog elements unavailable'));
      }

      const effectiveInputMode = inputMode || (isPrompt ? 'text' : 'none');

      const effectiveTone = isDanger ? 'danger' : tone;
      const toneLabels = {
        primary: 'Acao rapida',
        warning: 'Confirmacao',
        success: 'Concluido',
        danger: 'Atencao',
      };
      const toneNotes = {
        primary: 'A central segue disponível logo após esta confirmação, sem recarregar o painel inteiro.',
        warning: 'Revise os dados antes de continuar para evitar retrabalho manual depois.',
        success: 'A ação foi concluída e o painel já foi atualizado com o novo estado.',
        danger: 'Confirme com atenção, porque esta operação pode exigir reversão manual depois.',
      };
      const toneIcons = {
        primary: 'fa-sparkles',
        warning: 'fa-shield-halved',
        success: 'fa-circle-check',
        danger: 'fa-triangle-exclamation',
      };

      titleEl.textContent = title || 'Aviso';
      kickerEl.textContent = toneLabels[effectiveTone] || toneLabels.primary;
      messageEl.textContent = message || '';
      noteEl.textContent = effectiveInputMode === 'text'
        ? 'Preencha o campo abaixo para concluir a operação com segurança.'
        : effectiveInputMode === 'select'
          ? 'Escolha uma opção válida antes de continuar.'
          : (toneNotes[effectiveTone] || toneNotes.primary);
      orbEl.innerHTML = `<i class="fas ${toneIcons[effectiveTone] || toneIcons.primary}"></i>`;
      inputEl.value = String(defaultValue || '');
      selectEl.innerHTML = '';
      cardEl.classList.remove('tone-primary', 'tone-warning', 'tone-success', 'tone-danger');
      cardEl.classList.add(`tone-${effectiveTone}`);

      if (effectiveInputMode === 'select') {
        const options = Array.isArray(selectOptions) ? selectOptions : [];
        options.forEach((option) => {
          const optionEl = document.createElement('option');
          optionEl.value = String(option && option.value != null ? option.value : '');
          optionEl.textContent = String(option && option.label != null ? option.label : optionEl.value);
          selectEl.appendChild(optionEl);
        });

        const desiredValue = String(defaultValue || (options[0] ? options[0].value : ''));
        selectEl.value = desiredValue;
        if (selectEl.value !== desiredValue && options[0]) {
          selectEl.value = String(options[0].value);
        }
      } else {
        selectEl.value = '';
      }

      fieldLabelEl.textContent = fieldLabel || (effectiveInputMode === 'select' ? 'Seleção' : 'Valor');
      inputWrap.style.display = effectiveInputMode === 'none' ? 'none' : 'block';
      fieldLabelEl.style.display = effectiveInputMode === 'none' ? 'none' : 'block';
      inputEl.style.display = effectiveInputMode === 'text' ? 'block' : 'none';
      selectEl.style.display = effectiveInputMode === 'select' ? 'block' : 'none';
      cancelBtn.style.display = cancelText ? 'inline-block' : 'none';
      if (cancelText) cancelBtn.textContent = cancelText;
      confirmBtn.textContent = confirmText || 'OK';

      if (isDanger) {
        confirmBtn.classList.add('danger');
      } else {
        confirmBtn.classList.remove('danger');
      }

      overlay.classList.add('visible');
      overlay.setAttribute('aria-hidden', 'false');
      const prevBodyOverflow = document.body.style.overflow;
      document.body.style.overflow = 'hidden';

      if (effectiveInputMode === 'text') {
        setTimeout(() => {
          inputEl.focus();
          inputEl.select();
        }, 10);
      } else if (effectiveInputMode === 'select') {
        setTimeout(() => {
          selectEl.focus();
        }, 10);
      }

      return new Promise((resolve) => {
        let settled = false;

        const cleanup = () => {
          if (settled) return;
          settled = true;
          overlay.classList.remove('visible');
          overlay.setAttribute('aria-hidden', 'true');
          document.body.style.overflow = prevBodyOverflow;

          confirmBtn.removeEventListener('click', onConfirm);
          cancelBtn.removeEventListener('click', onCancel);
          closeBtn.removeEventListener('click', onCancel);
          overlay.removeEventListener('click', onOverlayClick);
          document.removeEventListener('keydown', onKeyDown);
        };

        const finish = (value) => {
          cleanup();
          resolve(value);
        };

        const onConfirm = () => finish(effectiveInputMode === 'text' ? inputEl.value : effectiveInputMode === 'select' ? selectEl.value : true);
        const onCancel = () => finish(effectiveInputMode === 'none' ? false : null);
        const onOverlayClick = (event) => {
          if (event.target === overlay) onCancel();
        };
        const onKeyDown = (event) => {
          if (event.key === 'Escape') {
            onCancel();
            return;
          }
          if (effectiveInputMode !== 'none' && event.key === 'Enter') {
            event.preventDefault();
            onConfirm();
          }
        };

        confirmBtn.addEventListener('click', onConfirm);
        cancelBtn.addEventListener('click', onCancel);
        closeBtn.addEventListener('click', onCancel);
        overlay.addEventListener('click', onOverlayClick);
        document.addEventListener('keydown', onKeyDown);
      });
    }

    // Substituir funções de diálogo
    async function showAlert(message, title = 'Aviso') {
      return appAlert(message, 'primary', title);
    }

    async function showConfirm(message, title = 'Confirmação') {
      return appConfirm(message, title);
    }

    async function showPrompt(message, defaultValue = '', title = 'Digite um valor') {
      return appPrompt(message, defaultValue, title);
    }

    async function showDangerConfirm(message, title = 'Confirmar exclusão') {
      resetLegacyAppPopupState();
      return showBeautifulDialog({ title, message, isPrompt: false, cancelText: 'Cancelar', isDanger: true, confirmText: 'Deletar' });
    }
  </script>
</body>
</html>
