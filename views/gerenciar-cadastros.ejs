        buttonText.textContent = tipoImportacao === 'encontro_completo' ? 'Importar Encontro Completo' : 'Importar Encontreiros';
      }

      if (tipoImportacao === 'encontro_completo' && sourceType === 'excel') {
        sourceTypeNode.value = 'database';
        sourceType = 'database';
      }

      if (tipoImportacao === 'encontro_completo' && sourceType === 'pdf') {
        sourceTypeNode.value = 'database';
        sourceType = 'database';
      }

      if (tipoImportacao !== 'encontro_completo' && sourceType === 'sistema') {
        sourceTypeNode.value = 'database';
        sourceType = 'database';
      }

      if (contextTipoNode) {
        contextTipoNode.textContent = tipoImportacao === 'encontro_completo'
          ? 'Encontro Completo (estrutura + pessoas)'
          : 'Apenas Encontreiros';
      }
      if (contextOrigemNode) {
        const sourceLabels = {
          sistema: 'Encontro já criado no sistema',
          database: 'Banco externo',
          excel: 'Arquivo Excel',
          pdf: 'Arquivo PDF',
        };
        contextOrigemNode.textContent = sourceLabels[sourceType] || 'Origem não informada';
      }

      // Mostrar/ocultar campos de encontro completo
      if (tipoImportacao === 'encontro_completo') {
        encontroCompletoFields.style.display = 'flex';
        carregarEncontrosImportacao();
        if (origemSistemaWrap) origemSistemaWrap.style.display = sourceType === 'sistema' ? 'block' : 'none';
      } else {
        encontroCompletoFields.style.display = 'none';
        if (origemSistemaWrap) origemSistemaWrap.style.display = 'none';
      }

      if (tipoImportacao === 'encontro_completo' && sourceType === 'sistema') {
        dbFields.style.display = 'none';
        fileFields.style.display = 'none';
        if (completeCollectionFields) completeCollectionFields.style.display = 'none';
        if (tableInput) tableInput.parentElement.style.display = 'none';
        if (buttonText) buttonText.textContent = 'Importar Estrutura do Encontro';
        carregarResumoEncontroOrigem();
        return;
      }

      if (sourceType === 'database') {
        dbFields.style.display = 'flex';
        fileFields.style.display = 'none';

        if (tipoImportacao === 'encontro_completo') {
          if (completeCollectionFields) completeCollectionFields.style.display = 'flex';
          if (tableInput) tableInput.parentElement.style.display = 'none';
        } else {
          if (completeCollectionFields) completeCollectionFields.style.display = 'none';
          if (tableInput) tableInput.parentElement.style.display = 'block';
        }

        if (dbEngine === 'mongodb') {
          labelConnection.textContent = 'URI do MongoDB Externo *';
          tableLabel.textContent = 'Colecao de Encontreiros';
          connectionInput.placeholder = 'mongodb+srv://usuario:senha@cluster.exemplo.mongodb.net';
          tableInput.value = tableInput.value || 'Encontro';
          sqlQueryWrap.style.display = 'none';
        } else if (dbEngine === 'postgresql') {
          labelConnection.textContent = 'String de Conexao PostgreSQL *';
          tableLabel.textContent = 'Tabela de Encontreiros';
          connectionInput.placeholder = 'postgresql://usuario:senha@host:5432/banco';
          tableInput.value = tableInput.value || 'encontro';
          sqlQueryWrap.style.display = 'none';
        } else {
          labelConnection.textContent = 'String de Conexao MySQL *';
          tableLabel.textContent = 'Tabela de Encontreiros';
          connectionInput.placeholder = 'mysql://usuario:senha@host:3306/banco';
          tableInput.value = tableInput.value || 'encontro';
          sqlQueryWrap.style.display = 'none';
        }
      } else {
        dbFields.style.display = 'none';
        fileFields.style.display = 'flex';
        if (completeCollectionFields) completeCollectionFields.style.display = 'none';
        if (tableInput) tableInput.parentElement.style.display = 'block';
      }

      carregarResumoEncontroOrigem();
    }

    async function importarCadastros() {
      if (!ensurePermission('importacao.executar')) return;
      const tipoImportacao = document.getElementById('import_tipoImportacao').value;
      const sourceType = document.getElementById('import_sourceType').value;
      const dbEngine = document.getElementById('import_dbEngine').value;
      const connectionString = document.getElementById('import_connectionString').value.trim();
      const databaseName = document.getElementById('import_databaseName').value.trim();
      const tableName = document.getElementById('import_tableName').value.trim() || 'Encontro';
      const colecaoEquipesCompleta = (document.getElementById('import_completeColecaoEquipes') || {}).value?.trim?.() || 'Equipe';
      const colecaoCirculosCompleta = (document.getElementById('import_completeColecaoCirculos') || {}).value?.trim?.() || 'Circulo';
      const colecaoEncontreirosCompleta = (document.getElementById('import_completeColecaoEncontreiros') || {}).value?.trim?.() || 'Encontro';
      const limite = document.getElementById('import_limite').value;
      const atualizarExistentes = document.getElementById('import_atualizarExistentes').checked;
      const arquivoInput = document.getElementById('import_arquivo');
      const fotoPadrao = document.getElementById('import_fotoPadrao').value.trim();
      const payload = {
        tipoImportacao,
        sourceType,
        dbEngine,
        connectionString,
        databaseName,
        tableName,
        colecaoEquipesCompleta,
        colecaoCirculosCompleta,
        colecaoEncontreirosCompleta,
        limite,
        atualizarExistentes,
        fotoPadrao,
        encontroOrigemId: document.getElementById('import_encontroOrigemId')?.value || '',
        ejcSelecionado: document.getElementById('import_ejcSelecionado')?.value || '',
        importarEquipes: document.getElementById('import_importarEquipes')?.checked || false,
        importarCirculos: document.getElementById('import_importarCirculos')?.checked || false,
        importarEncontreiros: document.getElementById('import_importarEncontreiros')?.checked || false,
        arquivo: (arquivoInput.files && arquivoInput.files[0]) ? arquivoInput.files[0] : null,
      };

      setImportResultState('preview', '<div class="import-report-loading"><i class="fas fa-magnifying-glass-chart me-1"></i>Preparando relatório pré-importação...</div>');

      if (tipoImportacao === 'encontro_completo') {
        if (sourceType === 'sistema' && !payload.encontroOrigemId) {
          setImportResultState('error', 'Selecione o encontro de origem para continuar.');
          return;
        }

        if (!payload.ejcSelecionado) {
          setImportResultState('error', 'Selecione o encontro de destino para importar a estrutura completa.');
          return;
        }

        if (sourceType === 'sistema' && payload.encontroOrigemId === payload.ejcSelecionado) {
          setImportResultState('error', 'Escolha encontros diferentes para origem e destino.');
          return;
        }
      }

      if (tipoImportacao === 'encontro_completo') {
        const encontroOrigemId = document.getElementById('import_encontroOrigemId').value;
        const ejcSelecionado = document.getElementById('import_ejcSelecionado').value;
        if (sourceType === 'sistema' && !encontroOrigemId) {
          resultBox.className = 'import-result error';
          resultBox.textContent = 'Selecione o encontro de origem para continuar.';
          return;
        }

        if (!ejcSelecionado) {
          resultBox.className = 'import-result error';
          resultBox.textContent = 'Selecione o encontro de destino para importar a estrutura completa.';
          return;
        }

        if (sourceType === 'sistema' && encontroOrigemId === ejcSelecionado) {
          resultBox.className = 'import-result error';
          resultBox.textContent = 'Escolha encontros diferentes para origem e destino.';
          return;
        }
      }

      if (sourceType === 'database' && !connectionString) {
        setImportResultState('error', 'Informe a conexao do banco externo para continuar.');
        return;
      }

      if (sourceType !== 'database' && sourceType !== 'sistema' && !payload.arquivo) {
        setImportResultState('error', 'Selecione um arquivo para importar.');
        return;
      }

      try {
        const previewResult = await executarImportacaoRequest({ ...payload, dryRun: true });
        setImportResultState('preview', renderImportReport(previewResult, 'preview'));

        const confirmMsg = tipoImportacao === 'encontro_completo'
          ? 'O relatório pré-importação foi gerado. Deseja executar a importação completa agora?'
          : 'O relatório pré-importação foi gerado. Deseja executar a importação agora?';

        if (!await appConfirm(confirmMsg, 'Confirmar importação')) return;

        setImportResultState('preview', `${renderImportReport(previewResult, 'preview')}<div class="import-report-loading mt-3"><i class="fas fa-spinner fa-spin me-1"></i>Executando importação...</div>`);

        const result = await executarImportacaoRequest({ ...payload, dryRun: false });
        setImportResultState('success', renderImportReport(result, 'result'));
      } catch (error) {
        setImportResultState('error', escapeImportHtml(error.message || 'Falha ao executar importação. Verifique os dados informados e tente novamente.'));
      }
    }

    async function aprovarCadastro(tipo, id) {
      if (!ensurePermission('cadastros.aprovar')) return;
      const triggerButton = getActionTriggerButton();
      const targetRow = triggerButton ? [triggerButton.closest('tr')].filter(Boolean) : [];
      if (!await appConfirm('Aprovar este cadastro?', 'Confirmar aprovacao')) return;

      setActionButtonBusy(triggerButton, true, 'Aprovando...');
      setRowsPendingState(targetRow, true);

      try {
        const response = await fetch('/admin/aprovar', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ tipo, id })
        });
        const result = await response.json();

        if (result.success) {
          queueManagerFeedback({
            tabId: getAbaAtivaPainelId(),
            rows: [{ tipo, id }],
          });
          await appAlert('Cadastro aprovado com sucesso!', 'success', 'Sucesso');
          recarregarMantendoAbaAtual();
        } else {
          await appAlert(result.error || 'Erro ao aprovar.', 'danger', 'Erro');
        }
      } catch (error) {
        await appAlert('Erro ao aprovar cadastro.', 'danger', 'Erro');
      } finally {
        setActionButtonBusy(triggerButton, false);
        setRowsPendingState(targetRow, false);
      }
    }

