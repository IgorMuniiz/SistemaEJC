    let lastTransferSelectionCount = null;
    let lastApprovalSelectionCount = null;
    const managerFeedbackStorageKey = 'admin_manager_pending_feedback';

    function prefersReducedManagerMotion() {
      return window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    }

    function pulseManagerElement(element, className = 'manager-feedback-pulse') {
      if (!element) return;

      const duration = className === 'manager-feedback-glow' ? 1400 : 1100;
      element.classList.remove(className);
      void element.offsetWidth;
      element.classList.add(className);

      window.setTimeout(() => {
        element.classList.remove(className);
      }, prefersReducedManagerMotion() ? 260 : duration);
    }

    function setActionButtonBusy(button, busy, busyLabel = 'Processando...') {
      if (!button) return;

      if (busy) {
        if (!button.dataset.originalHtml) {
          button.dataset.originalHtml = button.innerHTML;
          button.dataset.wasDisabled = button.disabled ? 'true' : 'false';
        }

        button.disabled = true;
        button.classList.add('is-busy');
        button.innerHTML = `<span class="btn-busy-spinner" aria-hidden="true"></span><span>${escapeHtml(busyLabel)}</span>`;
        return;
      }

      if (button.dataset.originalHtml) {
        button.innerHTML = button.dataset.originalHtml;
      }

      button.classList.remove('is-busy');
      button.disabled = button.dataset.wasDisabled === 'true';
      delete button.dataset.originalHtml;
      delete button.dataset.wasDisabled;
    }

    function getActionTriggerButton() {
      const activeElement = document.activeElement;
      if (activeElement && activeElement.closest) {
        return activeElement.closest('button');
      }
      return null;
    }

    function escapeSelectorValue(value) {
      if (window.CSS && typeof window.CSS.escape === 'function') {
        return window.CSS.escape(String(value || ''));
      }

      return String(value || '').replace(/(["\\])/g, '\\$1');
    }

    function getCadastroRowsById(tipo, id) {
      const rows = new Set();
      const safeId = String(id || '');
      if (!safeId) return [];

      const actionSelectors = [
        `button[onclick*="editarCadastro('${tipo}', '${safeId}')"]`,
        `button[onclick*="deletarCadastro('${tipo}', '${safeId}')"]`,
      ];

      if (tipo === 'encontrista') {
        actionSelectors.push(`button[onclick*="transferirParaEncontreiros('${safeId}'"]`);
      }

      document.querySelectorAll(actionSelectors.join(',')).forEach((button) => {
        const row = button.closest('tr');
        if (row) rows.add(row);
      });

      const selectorId = escapeSelectorValue(safeId);
      document.querySelectorAll(`.approval-batch-check[value="${selectorId}"][data-approval-batch-type="${tipo}"]`).forEach((checkbox) => {
        const row = checkbox.closest('tr');
        if (row) rows.add(row);
      });

      if (tipo === 'encontrista') {
        document.querySelectorAll(`.transfer-encontrista-check[value="${selectorId}"]`).forEach((checkbox) => {
          const row = checkbox.closest('tr');
          if (row) rows.add(row);
        });
      }

      return Array.from(rows);
    }

    function setRowsPendingState(rows, active) {
      rows.forEach((row) => {
        row.classList.toggle('is-pending-action', !!active);
      });
    }

    function queueManagerFeedback(feedback) {
      try {
        sessionStorage.setItem(managerFeedbackStorageKey, JSON.stringify({
          ...feedback,
          timestamp: Date.now(),
        }));
      } catch (error) {
        console.warn('Nao foi possivel persistir microfeedback da central.', error);
      }
    }

    function consumeManagerFeedback() {
      try {
        const raw = sessionStorage.getItem(managerFeedbackStorageKey);
        if (!raw) return null;

        sessionStorage.removeItem(managerFeedbackStorageKey);
        const parsed = JSON.parse(raw);
        if (!parsed || (Date.now() - Number(parsed.timestamp || 0)) > 15000) {
          return null;
        }

        return parsed;
      } catch (error) {
        console.warn('Nao foi possivel ler microfeedback pendente da central.', error);
        sessionStorage.removeItem(managerFeedbackStorageKey);
        return null;
      }
    }

    function getAbaAtivaPainelId() {
      const activePane = document.querySelector('.tab-pane.show.active');
      return activePane && activePane.id ? activePane.id : 'principal-tab';
    }

    function applyManagerFeedbackOnLoad() {
      const feedback = consumeManagerFeedback();
      if (!feedback) return;

      const tabId = feedback.tabId || getAbaAtivaPainelId();
      const pane = document.getElementById(tabId);
      if (pane) {
        pulseManagerElement(pane, 'manager-feedback-glow');
      }

      document.querySelectorAll(`[data-tab-target="${tabId}"]`).forEach((target) => {
        pulseManagerElement(target);
      });

      if (Array.isArray(feedback.rows)) {
        feedback.rows.forEach((entry) => {
          getCadastroRowsById(entry.tipo, entry.id).forEach((row) => {
            pulseManagerElement(row, 'is-success-flash');
          });
        });
      }
    }

