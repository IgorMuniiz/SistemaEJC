    async function salvarEdicao() {
      const formData = new FormData(document.getElementById('formEdicao'));
      const tipo = document.getElementById('edit_tipo').value;
      const id = document.getElementById('edit_id').value;
      const saveButtons = Array.from(modalEdicaoElement.querySelectorAll('button[onclick="salvarEdicao()"]'));
      const tabId = getAbaAtivaPainelId();

      saveButtons.forEach((button) => setActionButtonBusy(button, true, 'Salvando...'));

      if (tipo === 'encontreiro') {
        formData.set('cep', document.getElementById('edit_cep')?.value || '');
        formData.set('complementoReferencia', document.getElementById('edit_complementoReferencia')?.value || '');
        formData.set('talentoHabilidadeArtistica', document.getElementById('edit_encontro_talentoHabilidadeArtistica')?.value || '');
        formData.set('quadroSaude', document.getElementById('edit_encontro_quadroSaude')?.value || '');
        formData.set('medicamentoControlado', document.getElementById('edit_encontro_medicamentoControlado')?.value || '');
        formData.set('religiosidadeAtual', document.getElementById('edit_encontro_religiosidadeAtual')?.value || '');
        formData.set('paroquiaFrequenta', document.getElementById('edit_encontro_paroquiaFrequenta')?.value || '');
        formData.set('participaMovimentoIgreja', document.getElementById('edit_encontro_participaMovimentoIgreja')?.value || '');
      }

      if (tipo === 'encontreiro') {
        formData.set('cep', document.getElementById('edit_encontro_cep')?.value || '');
        formData.set('complementoReferencia', document.getElementById('edit_encontro_complementoReferencia')?.value || '');
        formData.set('talentoHabilidadeArtistica', document.getElementById('edit_encontro_talentoHabilidadeArtistica')?.value || '');
        formData.set('quadroSaude', document.getElementById('edit_encontro_quadroSaude')?.value || '');
        formData.set('medicamentoControlado', document.getElementById('edit_encontro_medicamentoControlado')?.value || '');
        formData.set('religiosidadeAtual', document.getElementById('edit_encontro_religiosidadeAtual')?.value || '');
        formData.set('paroquiaFrequenta', document.getElementById('edit_encontro_paroquiaFrequenta')?.value || '');
        formData.set('participaMovimentoIgreja', document.getElementById('edit_encontro_participaMovimentoIgreja')?.value || '');
      }

      try {
        const response = await fetch(`/admin/atualizar-cadastro/${tipo}/${id}`, {
          method: 'POST',
          body: formData
        });
        
        const contentType = response.headers.get('content-type');
        if (!contentType || !contentType.includes('application/json')) {
          console.error('Resposta não-JSON recebida:', await response.text());
          await appAlert('Erro: Resposta invalida do servidor.', 'danger', 'Erro');
          return;
        }
        
        const result = await response.json();

        if (result.success) {
          queueManagerFeedback({
            tabId,
            rows: [{ tipo, id }],
          });
          await appAlert('Cadastro atualizado com sucesso.', 'success', 'Sucesso');
          modalEdicao.hide();
          recarregarMantendoAbaAtual();
        } else {
          await appAlert(result.error || 'Erro ao atualizar cadastro.', 'danger', 'Erro');
        }
      } catch (error) {
        console.error('Erro ao salvar alterações:', error);
        await appAlert('Erro ao salvar alteracoes: ' + error.message, 'danger', 'Erro');
      } finally {
        saveButtons.forEach((button) => setActionButtonBusy(button, false));
      }
    }

