    function renderVinculadosEquipe() {
      const equipeSelecionada = document.getElementById('visualizar_equipe').value;
      const tabela = document.getElementById('tabela-vinculados-equipe');
      if (!tabela) return;

      const tbody = tabela.querySelector('tbody');
      if (!tbody) return;

      if (!equipeSelecionada) {
        tbody.innerHTML = '<tr><td colspan="4" class="empty-state">Selecione uma equipe para visualizar os vinculados.</td></tr>';
        return;
      }

      const vinculados = (encontreiros || []).filter((pessoa) => {
        const serviu = Array.isArray(pessoa.equipeServiu) && pessoa.equipeServiu.includes(equipeSelecionada);
        const coordenou = Array.isArray(pessoa.equipeCoordenou) && pessoa.equipeCoordenou.includes(equipeSelecionada);
        return serviu || coordenou;
      });

      if (vinculados.length === 0) {
        tbody.innerHTML = '<tr><td colspan="4" class="empty-state">Nenhuma pessoa vinculada nesta equipe.</td></tr>';
        return;
      }

      tbody.innerHTML = vinculados.map((pessoa) => {
        const tipoTxt = pessoa.tipo === 'tios' ? 'Tios' : 'Jovens';
        const serviuTxt = Array.isArray(pessoa.equipeServiu) ? pessoa.equipeServiu.filter((e) => e === equipeSelecionada).join(', ') : '';
        const coordTxt = Array.isArray(pessoa.equipeCoordenou) ? pessoa.equipeCoordenou.filter((e) => e === equipeSelecionada).join(', ') : '';
        return `<tr>
          <td>${pessoa.nomeCompleto || '-'}</td>
          <td>${tipoTxt}</td>
          <td>${serviuTxt || '-'}</td>
          <td>${coordTxt || '-'}</td>
        </tr>`;
      }).join('');
    }

    async function editarAdmin(adminId, username, nivelAcesso, permissoesCsv) {
      try {
        const now = Date.now();
        if (now - adminInlineEditLastClickAt < 180) return;
        adminInlineEditLastClickAt = now;

        if (adminInlineEditorBusy) return;
        adminInlineEditorBusy = true;

        if (!hasPermission('admins.gerenciar')) {
          await showAlert('Você não possui permissão para editar administradores.', 'Acesso Negado');
          return;
        }

        let permissoesArray = [];
        if (!username) {
          const adminSelecionado = administradoresData.find((item) => String(item && item._id) === String(adminId));
          username = adminSelecionado && adminSelecionado.username ? adminSelecionado.username : '';
          nivelAcesso = adminSelecionado && adminSelecionado.nivelAcesso ? adminSelecionado.nivelAcesso : 'super_admin';
          permissoesArray = adminSelecionado && Array.isArray(adminSelecionado.permissoes) ? adminSelecionado.permissoes : [];
        } else {
          permissoesArray = String(permissoesCsv || '').split(',').map((s) => s.trim()).filter(Boolean);
        }

        const existingEditorRow = document.getElementById('admin-inline-editor-row');
        if (existingEditorRow) {
          const abertoParaMesmoAdmin = String(existingEditorRow.dataset.adminId || '') === String(adminId);
          if (abertoParaMesmoAdmin) {
            const existingInput = existingEditorRow.querySelector('#edit_admin_username');
            if (existingInput) existingInput.focus();
            existingEditorRow.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
            return;
          }
          // Remove o editor anterior imediatamente para evitar duplicidade de IDs e corrida de estado.
          fecharInlineEditorAdmin(true);
        }

        // Localiza a linha clicada na tabela
        const clickedBtn = document.querySelector(`.js-edit-admin[data-admin-id="${adminId}"]`);
        const targetRow = clickedBtn ? clickedBtn.closest('tr') : null;
        if (!targetRow) return;

        const editScopeId = `admin-edit-${String(adminId).replace(/[^a-zA-Z0-9_-]/g, '')}`;

        // Gera HTML dos checkboxes de permissão dinamicamente
        const permsHtml = adminPermissionOptionsData.map((opt) => `
          <div class="admin-perm-pill">
            <input class="admin-perm-item-edit" type="checkbox" id="${editScopeId}-perm-${opt.key}" value="${opt.key}">
            <label class="admin-perm-pill-label" for="${editScopeId}-perm-${opt.key}">
              <span class="admin-perm-pill-name"><i class="fas fa-check admin-perm-check-icon"></i>${escapeHtml(opt.label)}</span>
              <small>${escapeHtml(opt.description)}</small>
            </label>
          </div>`).join('');

        const safeUsername = escapeHtml(username || '');

        const editorRow = document.createElement('tr');
        editorRow.id = 'admin-inline-editor-row';
        editorRow.className = 'admin-inline-editor-row';
        editorRow.dataset.adminId = String(adminId);
        editorRow.innerHTML = `
          <td colspan="5" style="padding:0;border-top:none">
            <div class="admin-inline-editor">
              <div class="admin-inline-editor-header">
                <span><i class="fas fa-user-pen me-2"></i>Editando: <strong>${safeUsername || adminId}</strong></span>
                <button type="button" class="admin-inline-close" onclick="fecharInlineEditorAdmin()" aria-label="Fechar">×</button>
              </div>
              <input type="hidden" id="edit_admin_id" value="${adminId}">
              <div class="admin-inline-editor-grid">
                <div class="admin-inline-field">
                  <label class="form-label">Usuário</label>
                  <input type="text" class="form-control" id="edit_admin_username" placeholder="Digite o usuário" value="${safeUsername}">
                </div>
                <div class="admin-inline-field">
                  <label class="form-label">Nova senha <small>(opcional)</small></label>
                  <input type="password" class="form-control" id="edit_admin_senha" minlength="6" placeholder="Deixe em branco para manter">
                </div>
                <div class="admin-inline-field">
                  <label class="form-label">Nível hierárquico</label>
                  <select id="edit_admin_nivel" class="form-select">
                    <option value="consulta">Consulta</option>
                    <option value="operador">Operador</option>
                    <option value="coordenador">Coordenador</option>
                    <option value="super_admin">Super Admin</option>
                  </select>
                </div>
              </div>
              <div class="admin-inline-perms">
                <label class="form-label">Permissões extras</label>
                <div id="edit_admin_permissions" class="admin-perm-pill-group">${permsHtml}</div>
              </div>
              <div class="admin-inline-footer">
                <small class="text-muted">Se informar senha, deve ter no mínimo 6 caracteres.</small>
                <div class="admin-inline-actions">
                  <button type="button" class="btn btn-secondary" onclick="fecharInlineEditorAdmin()">
                    <i class="fas fa-times me-1"></i>Cancelar
                  </button>
                  <button type="button" class="btn btn-primary js-save-admin-inline" onclick="salvarEdicaoAdmin()">
                    <i class="fas fa-save me-1"></i>Salvar alterações
                  </button>
                </div>
              </div>
            </div>
          </td>`;

        targetRow.insertAdjacentElement('afterend', editorRow);
        requestAnimationFrame(() => editorRow.classList.add('open'));

        const nivelField = editorRow.querySelector('#edit_admin_nivel');
        if (nivelField) nivelField.value = nivelAcesso || 'super_admin';

        const selectedPerms = new Set(permissoesArray.map((item) => String(item || '').trim()).filter(Boolean));
        editorRow.querySelectorAll('.admin-perm-item-edit').forEach((node) => {
          node.checked = selectedPerms.has(String(node.value || '').trim());
        });

        editorRow.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      } catch (error) {
        console.error('[editarAdmin] ERRO:', error);
        await showAlert('Erro ao abrir editor de administrador: ' + error.message, 'Erro');
      } finally {
        adminInlineEditorBusy = false;
      }
    }

    async function salvarEdicaoAdmin() {
      if (!ensurePermission('admins.gerenciar')) return;
      const editorRow = document.getElementById('admin-inline-editor-row');
      if (!editorRow) {
        await appAlert('Editor de administrador não está aberto.', 'warning', 'Editor fechado');
        return;
      }

      const saveBtn = editorRow.querySelector('.js-save-admin-inline');
      if (saveBtn && saveBtn.dataset.loading === '1') return;
      if (saveBtn) {
        saveBtn.dataset.loading = '1';
        setActionButtonBusy(saveBtn, true, 'Salvando...');
      }

      const adminId = String((editorRow.querySelector('#edit_admin_id') || {}).value || '').trim();
      const usernameTratado = String((editorRow.querySelector('#edit_admin_username') || {}).value || '').trim();
      const novaSenha = String((editorRow.querySelector('#edit_admin_senha') || {}).value || '');
      const nivelAcesso = String((editorRow.querySelector('#edit_admin_nivel') || {}).value || '').trim();
      const permissoes = Array.from(editorRow.querySelectorAll('#edit_admin_permissions .admin-perm-item-edit'))
        .filter((node) => node.checked)
        .map((node) => String(node.value || '').trim())
        .filter(Boolean);
      const usernameAtualNoCampo = usernameTratado;

      if (!adminId) {
        await appAlert('Administrador invalido para atualizacao.', 'danger', 'Erro');
        return;
      }

      if (!usernameAtualNoCampo && !novaSenha && !nivelAcesso && permissoes.length === 0) {
        await appAlert('Informe ao menos um campo para atualizar.', 'warning', 'Sem alteracoes');
        return;
      }

      if (novaSenha && novaSenha.length < 6) {
        await appAlert('A nova senha deve ter no minimo 6 caracteres.', 'warning', 'Senha invalida');
        return;
      }

      const payload = {};
      if (usernameTratado) payload.username = usernameTratado;
      if (novaSenha) payload.senha = novaSenha;
      if (nivelAcesso) payload.nivelAcesso = nivelAcesso;
      payload.permissoes = permissoes;

      try {
        const response = await fetch(`/admin/atualizar-admin/${encodeURIComponent(adminId)}`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });
        const result = await response.json();

        if (result.success) {
          queueManagerFeedback({ tabId: 'administradores' });
          await appAlert('Administrador atualizado com sucesso.', 'success', 'Sucesso');
          fecharInlineEditorAdmin();
          recarregarMantendoAbaAtual();
        } else {
          await appAlert(result.error || 'Erro ao atualizar administrador.', 'danger', 'Erro');
        }
      } catch (error) {
        await appAlert('Erro ao atualizar administrador.', 'danger', 'Erro');
      } finally {
        if (saveBtn) {
          saveBtn.dataset.loading = '0';
          setActionButtonBusy(saveBtn, false);
        }
      }
    }

