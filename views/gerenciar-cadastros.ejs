    function hasPermission(permissionKey) {
      if (String(currentAdminLevel || '').toLowerCase() === 'super_admin') return true;
      if (!permissionKey) return true;
      return currentAdminPermissions.includes(permissionKey);
    }

    function ensurePermission(permissionKey, message) {
      if (hasPermission(permissionKey)) return true;
      // Mostrar alerta sem bloquear (fire and forget)
      appAlert(message || 'Você não possui permissão para esta ação.', 'warning', 'Acesso negado').catch(err => console.error('[ensurePermission] erro ao mostrar alerta:', err));
      return false;
    }

    // Utilitário global de escape HTML — protege contra XSS em interpolações de innerHTML.
    function escapeHtml(value) {
      return String(value == null ? '' : value)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;');
    }

    // Em ambiente de produção suprime os logs de debug; ative via localStorage:
    //   localStorage.setItem('ejc_debug', '1')  ou  window.EJC_DEBUG = true
    (function () {
      const debugEnabled = window.EJC_DEBUG || localStorage.getItem('ejc_debug') === '1';
      if (!debugEnabled) {
        const noop = () => {};
        console.log = noop;
        console.debug = noop;
      }
    })();

    function getPrimeiraAbaDisponivelId() {
      const tabButtons = Array.from(document.querySelectorAll('#cadastroTabs .nav-link'));
      const firstVisible = tabButtons.find((item) => item.style.display !== 'none');
      if (!firstVisible || !firstVisible.id) return 'encontristas';
      return firstVisible.id.replace(/-tab$/, '');
    }

    function aplicarPermissoesNoPainel() {
      document.querySelectorAll('[data-required-permission]').forEach((node) => {
        const permissionKey = node.getAttribute('data-required-permission');
        if (hasPermission(permissionKey)) return;
        node.style.display = 'none';
      });
    }

    function initAdminsCardsLayout() {
      const adminsCard = document.getElementById('admins-list-card');
      const auditCard = document.getElementById('admins-audit-card');
      const toggleBtn = document.getElementById('toggle-admin-audit');
      const auditContent = document.getElementById('admins-audit-content');
      const auditStorageKey = 'adminsAuditOpenState';
      if (!adminsCard || !auditCard || !toggleBtn || !auditContent) return;

      const parent = auditCard.parentElement;
      if (parent && adminsCard.parentElement === parent) {
        // Garante: lista de administradores acima e auditoria como ultimo card
        parent.insertBefore(adminsCard, auditCard);
        parent.appendChild(auditCard);
      }

      const setAuditOpen = (open) => {
        auditContent.hidden = !open;
        toggleBtn.setAttribute('aria-expanded', open ? 'true' : 'false');
        toggleBtn.textContent = `${open ? 'Ocultar' : 'Mostrar'} auditoria (<%= auditoriaTotal || 0 %>)`;
        auditCard.classList.toggle('is-open', open);
        try {
          localStorage.setItem(auditStorageKey, open ? '1' : '0');
        } catch (error) {
          // Ignora falha de armazenamento (ex.: modo privado)
        }
      };

      let shouldOpen = false;
      try {
        shouldOpen = localStorage.getItem(auditStorageKey) === '1';
      } catch (error) {
        shouldOpen = false;
      }
      setAuditOpen(shouldOpen);

      toggleBtn.addEventListener('click', () => {
        const isOpen = toggleBtn.getAttribute('aria-expanded') === 'true';
        setAuditOpen(!isOpen);
      });

      const cardHead = auditCard.querySelector('.admin-card-head');
      if (cardHead) {
        cardHead.addEventListener('click', (event) => {
          if (event.target === toggleBtn || toggleBtn.contains(event.target)) return;
          const isOpen = toggleBtn.getAttribute('aria-expanded') === 'true';
          setAuditOpen(!isOpen);
        });
      }
    }

    const modalEdicaoElement = document.getElementById('modalEdicao');
    initAdminsCardsLayout();
    function createFixedEditorModalController(element) {
      if (!element) {
        return {
          show() {},
          hide() {},
        };
      }

      let hideTimer = null;

      const emit = (eventName) => {
        element.dispatchEvent(new Event(eventName));
      };

      const lockScroll = () => {
        const scrollY = window.scrollY;
        document.documentElement.style.overflow = 'hidden';
        document.body.style.overflow = 'hidden';
        document.body.style.position = 'fixed';
        document.body.style.top = `-${scrollY}px`;
        document.body.style.left = '0';
        document.body.style.right = '0';
        document.body.dataset.scrollY = scrollY;
      };

      const unlockScroll = () => {
        const scrollY = parseInt(document.body.dataset.scrollY || '0', 10);
        document.documentElement.style.overflow = '';
        document.body.style.overflow = '';
        document.body.style.position = '';
        document.body.style.top = '';
        document.body.style.left = '';
        document.body.style.right = '';
        delete document.body.dataset.scrollY;
        window.scrollTo(0, scrollY);
      };

      const show = () => {
        if (hideTimer) {
          clearTimeout(hideTimer);
          hideTimer = null;
        }
        emit('show.bs.modal');
        lockScroll();
        element.style.display = 'flex';
        requestAnimationFrame(() => {
          element.classList.add('show');
          emit('shown.bs.modal');
        });
      };

      const hide = () => {
        if (!element.classList.contains('show') && element.style.display === 'none') return;
        emit('hide.bs.modal');
        element.classList.remove('show');
        unlockScroll();
        hideTimer = window.setTimeout(() => {
          element.style.display = 'none';
          emit('hidden.bs.modal');
        }, 180);
      };

      element.style.display = 'none';
      element.querySelectorAll('[data-bs-dismiss="modal"]').forEach((button) => {
        button.addEventListener('click', () => hide());
      });
      element.addEventListener('click', (event) => {
        if (event.target === element) hide();
      });

      return { show, hide };
    }

    let modalEdicao = createFixedEditorModalController(modalEdicaoElement);
