    function carregarEncontrosImportacao() {
      const origemNode = document.getElementById('import_encontroOrigemId');
      const destinoNode = document.getElementById('import_ejcSelecionado');
      if (!origemNode || !destinoNode) return;

      const encontrosOrdenados = [...(Array.isArray(ejcs) ? ejcs : [])].sort((a, b) => {
        if (!!a.ativo === !!b.ativo) {
          return String(a.nome || '').localeCompare(String(b.nome || ''));
        }
        return a.ativo ? -1 : 1;
      });

      const origemAtual = origemNode.value;
      const destinoAtual = destinoNode.value;
      origemNode.innerHTML = '<option value="">-- Selecione o encontro de origem --</option>';
      destinoNode.innerHTML = '<option value="">-- Selecione o encontro de destino --</option>';

      encontrosOrdenados.forEach((item) => {
        const optionLabel = `${item.nome || 'Encontro sem nome'}${item.ativo ? ' (ativo)' : ''}`;
        const origemOption = document.createElement('option');
        origemOption.value = String(item._id || '');
        origemOption.textContent = optionLabel;
        origemNode.appendChild(origemOption);

        const destinoOption = document.createElement('option');
        destinoOption.value = String(item._id || '');
        destinoOption.textContent = optionLabel;
        destinoNode.appendChild(destinoOption);
      });

      if (origemAtual) origemNode.value = origemAtual;
      const encontroAtivo = encontrosOrdenados.find((item) => item && item.ativo);
      destinoNode.value = destinoAtual || (encontroAtivo ? String(encontroAtivo._id) : '');
      carregarResumoEncontroOrigem();
    }

    async function carregarResumoEncontroOrigem() {
      const resumoNode = document.getElementById('import_encontro_resumo');
      const origemNode = document.getElementById('import_encontroOrigemId');
      const sourceType = (document.getElementById('import_sourceType') || {}).value;
      const tipoImportacao = (document.getElementById('import_tipoImportacao') || {}).value;
      if (!resumoNode) return;

      if (tipoImportacao !== 'encontro_completo' || sourceType !== 'sistema') {
        resumoNode.className = 'alert alert-secondary mb-0';
        resumoNode.textContent = 'Selecione o encontro de destino e informe o banco externo. O resumo previo so aparece ao copiar de um encontro interno.';
        return;
      }

      const encontroOrigemId = origemNode && origemNode.value ? String(origemNode.value) : '';
      if (!encontroOrigemId) {
        resumoNode.className = 'alert alert-secondary mb-0';
        resumoNode.textContent = 'Selecione um encontro de origem para ver o resumo prévio da estrutura.';
        return;
      }

      resumoNode.className = 'alert alert-info mb-0';
      resumoNode.textContent = 'Carregando resumo do encontro de origem...';

      try {
        const response = await fetch(`/api/admin/ejcs/${encodeURIComponent(encontroOrigemId)}/resumo-importacao`);
        const result = await response.json();
        if (!result.success) {
          resumoNode.className = 'alert alert-warning mb-0';
          resumoNode.textContent = result.error || 'Nao foi possivel carregar o resumo do encontro selecionado.';
          return;
        }

        const resumo = result.resumo || {};
        resumoNode.className = 'alert alert-light border mb-0';
        resumoNode.innerHTML = `
          <strong>Resumo do encontro de origem:</strong> ${resumo.nome || 'Nao informado'}<br>
          Equipes: <strong>${resumo.equipes || 0}</strong> | 
          Círculos: <strong>${resumo.circulos || 0}</strong> | 
          Encontreiros: <strong>${resumo.encontreiros || 0}</strong> | 
          Vínculos: <strong>${resumo.vinculos || 0}</strong>
        `;
      } catch (error) {
        resumoNode.className = 'alert alert-warning mb-0';
        resumoNode.textContent = 'Falha ao carregar resumo do encontro de origem.';
      }
    }

    function escapeImportHtml(value) {
      return String(value || '')
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;');
    }

    function formatImportNumber(value) {
      return Number(value || 0).toLocaleString('pt-BR');
    }

    function getImportSourceLabel(sourceType, dbEngine) {
      const labels = {
        sistema: 'Encontro já criado no sistema',
        database: `Banco externo${dbEngine ? ` (${dbEngine})` : ''}`,
        excel: 'Arquivo Excel',
        pdf: 'Arquivo PDF',
      };

      return labels[sourceType] || 'Origem não informada';
    }

