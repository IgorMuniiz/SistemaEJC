    function getTabPaneFromButton(tabButton) {
      const targetSelector = tabButton ? tabButton.getAttribute('data-bs-target') : '';
      return targetSelector ? document.querySelector(targetSelector) : null;
    }

    function ativarAbaSemBootstrap(tabButton) {
      if (!tabButton) return null;

      const targetPane = getTabPaneFromButton(tabButton);

      document.querySelectorAll('#cadastroTabs .nav-link').forEach((item) => {
        item.classList.remove('active');
        item.setAttribute('aria-selected', 'false');
      });

      document.querySelectorAll('#cadastroTabsContent .tab-pane').forEach((pane) => {
        pane.classList.remove('active', 'show');
      });

      tabButton.classList.add('active');
      tabButton.setAttribute('aria-selected', 'true');

