<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="Painel de gestao de cadastros do EJC COP com controle de encontristas, encontreiros, tios, encontros e administradores.">
  <title>Painel Administrativo - EJC COP</title>
  <link rel="preload" href="/vendor/bootstrap/css/bootstrap.min.css" as="style" onload="this.onload=null;this.rel='stylesheet'">
  <noscript><link rel="stylesheet" href="/vendor/bootstrap/css/bootstrap.min.css"></noscript>
  <link rel="preload" href="/vendor/fontawesome/css/all.min.css" as="style" onload="this.onload=null;this.rel='stylesheet'">
  <noscript><link rel="stylesheet" href="/vendor/fontawesome/css/all.min.css"></noscript>
  <link rel="stylesheet" href="/css/admin-saas.css?v=20260419-manager-all-feedback-42">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=Sora:wght@500;600;700&display=swap" rel="stylesheet">
</head>
<body class="admin-panel admin-manager-page admin-manager-revamp">
  <% const encontreirosIndividuais = (encontreiros || []).filter(function(c){ return c.tipo !== 'tios'; }); %>
  <% const tios = (encontreiros || []).filter(function(c){ return c.tipo === 'tios'; }); %>
  <% const statusCadastroRaw = function(c){
    if (c && c.statusAprovacao) return c.statusAprovacao;
    if (c && c.aprovado) return 'aprovado';
    return 'pendente';
  }; %>
  <% const statusCadastroGrupo = function(c){
    const raw = statusCadastroRaw(c);
    if (raw === 'aprovado') return 'aprovado';
    if (raw === 'reprovado' || raw === 'desistiu') return 'reprovado';
    return 'pendente';
  }; %>
  <% const resumoAlergia = function(c){
    const ehAlergico = String((c && c.ehAlergico) || '').toLowerCase() === 'sim';
    const alergiaDescricao = String((c && c.alergiaDescricao) || '').trim();
    if (!ehAlergico) return 'Nao';
    return alergiaDescricao || 'Sim (nao informado)';
  }; %>
  <% const escapeHtmlServer = function(value){
    return String(value || '')
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#39;');
  }; %>
  <% const getSubequipesVinculadas = function(c){
    const lista = Array.isArray(c && c.subequipeCoordenou) ? c.subequipeCoordenou : [];
    return lista.map(function(item){ return String(item || '').trim(); }).filter(Boolean);
  }; %>
  <% const renderSubequipesChips = function(c){
    const subequipes = getSubequipesVinculadas(c);
    if (!subequipes.length) {
      return '<span class="subeq-chip subeq-chip-empty">Sem vínculo</span>';
    }

    const chips = subequipes.map(function(nome){
      return '<span class="subeq-chip">' + escapeHtmlServer(nome) + '</span>';
    }).join('');

    return '<div class="subeq-chip-list">' + chips + '</div>';
  }; %>
  <% const encontristasAprovados = (encontristas || []).filter(function(c){ return statusCadastroGrupo(c) === 'aprovado'; }); %>
  <% const encontristasReprovados = (encontristas || []).filter(function(c){ return statusCadastroGrupo(c) === 'reprovado'; }); %>
  <% const encontristasPendentes = (encontristas || []).filter(function(c){ return statusCadastroGrupo(c) === 'pendente'; }); %>
  <% const encontreirosAprovados = (encontreirosIndividuais || []).filter(function(c){ return statusCadastroGrupo(c) === 'aprovado'; }); %>
  <% const encontreirosReprovados = (encontreirosIndividuais || []).filter(function(c){ return statusCadastroGrupo(c) === 'reprovado'; }); %>
  <% const encontreirosPendentes = (encontreirosIndividuais || []).filter(function(c){ return statusCadastroGrupo(c) === 'pendente'; }); %>
  <% const tiosAprovados = (tios || []).filter(function(c){ return statusCadastroGrupo(c) === 'aprovado'; }); %>
  <% const tiosReprovados = (tios || []).filter(function(c){ return statusCadastroGrupo(c) === 'reprovado'; }); %>
  <% const tiosPendentes = (tios || []).filter(function(c){ return statusCadastroGrupo(c) === 'pendente'; }); %>
  <% const totalCadastrosVisiveis = (encontristas || []).length + (encontreirosIndividuais || []).length + (tios || []).length; %>
  <% const totalPendencias = (encontristasPendentes || []).length + (encontreirosPendentes || []).length; %>
  <% const totalAprovadosGeral = (encontristasAprovados || []).length + (encontreirosAprovados || []).length + (tiosAprovados || []).length; %>
  <% const totalReprovadosGeral = (encontristasReprovados || []).length + (encontreirosReprovados || []).length + (tiosReprovados || []).length; %>
  <% const totalPendenciasGeral = (encontristasPendentes || []).length + (encontreirosPendentes || []).length + (tiosPendentes || []).length; %>
  <% const taxaAprovacaoGeral = totalCadastrosVisiveis ? Math.round((totalAprovadosGeral / totalCadastrosVisiveis) * 100) : 0; %>
  <% const taxaPendenciaGeral = totalCadastrosVisiveis ? Math.round((totalPendenciasGeral / totalCadastrosVisiveis) * 100) : 0; %>
  <% const taxaReprovacaoGeral = totalCadastrosVisiveis ? Math.round((totalReprovadosGeral / totalCadastrosVisiveis) * 100) : 0; %>
  <% const atividadeRecente = [
    ...((encontristas || []).map(function(item){ return Object.assign({}, item, { __tipoPainel: 'Encontrista' }); })),
    ...((encontreirosIndividuais || []).map(function(item){ return Object.assign({}, item, { __tipoPainel: 'Encontreiro' }); })),
    ...((tios || []).map(function(item){ return Object.assign({}, item, { __tipoPainel: 'Tio' }); }))
  ].sort(function(a, b){
    return new Date(b.dataCadastro || 0).getTime() - new Date(a.dataCadastro || 0).getTime();
  }).slice(0, 8); %>
  <% const pendenciasCriticasMenu = totalPendencias >= 12; %>
  <% const pendenciasAtencaoMenu = !pendenciasCriticasMenu && totalPendencias >= 6; %>
  <% const pendenciasClasseMenu = pendenciasCriticasMenu ? 'is-critical' : (pendenciasAtencaoMenu ? 'is-attention' : 'is-normal'); %>
  <% const pendenciasTituloMenu = pendenciasCriticasMenu ? 'Fila critica de aprovacoes' : (pendenciasAtencaoMenu ? 'Fila em atencao' : 'Fila sob controle'); %>
  <% const adminPermissoesLista = Array.isArray(adminPermissoes) ? adminPermissoes : []; %>
  <% const adminPermissionOptionsList = Array.isArray(adminPermissionOptions) ? adminPermissionOptions : []; %>
  <% const adminRoleDefaults = adminRoleDefaultPermissions || {}; %>
  <% const adminNivelAtual = adminNivelAcesso || 'super_admin'; %>
  <% const gastosResumoData = gastosResumo || { quantidade: 0, total: 0, encontro: 0, equipes: 0 }; %>
  <% const gastoCategoryOptionsList = Array.isArray(gastoCategoryOptions) ? gastoCategoryOptions : []; %>
  <% const fluxoResumoData = fluxoCaixaResumo || { quantidade: 0, entradas: 0, saidas: 0, saldo: 0 }; %>
  <% const fluxoMensalResumoData = fluxoCaixaMensalResumo || { saldoInicial: 0, entradasMes: 0, saidasMes: 0, saldoFinal: 0, mesReferencia: '' }; %>
  <% const fluxoCategoryOptionsList = Array.isArray(fluxoCategoryOptions) ? fluxoCategoryOptions : []; %>
  <% const gastosLista = Array.isArray(gastos) ? gastos : []; %>
  <% const hojeGastosRef = new Date(); %>
  <% const gastosMesAtualLista = gastosLista.filter(function(item){
    if (!item || !item.dataGasto) return false;
    const dataItem = new Date(item.dataGasto);
    return !Number.isNaN(dataItem.getTime())
      && dataItem.getFullYear() === hojeGastosRef.getFullYear()
      && dataItem.getMonth() === hojeGastosRef.getMonth();
  }); %>
  <% const totalGastosMesAtual = gastosMesAtualLista.reduce(function(total, item){ return total + (Number(item && item.valor) || 0); }, 0); %>
  <% const maiorGastoMesAtual = gastosMesAtualLista.reduce(function(maior, item){
    const valorItem = Number(item && item.valor) || 0;
    if (!maior || valorItem > (Number(maior.valor) || 0)) return item;
    return maior;
  }, null); %>
  <% const gastoMedioGeral = gastosResumoData.quantidade ? (Number(gastosResumoData.total || 0) / Number(gastosResumoData.quantidade || 1)) : 0; %>
  <% const percentualGastosEquipes = Number(gastosResumoData.total || 0) > 0 ? Math.round((Number(gastosResumoData.equipes || 0) / Number(gastosResumoData.total || 1)) * 100) : 0; %>
  <% const percentualGastosEncontro = Number(gastosResumoData.total || 0) > 0 ? Math.max(0, 100 - percentualGastosEquipes) : 0; %>
  <% const totalFluxoEntradas = Number(fluxoResumoData.entradas || 0); %>
  <% const totalFluxoSaidas = Number(fluxoResumoData.saidas || 0); %>
  <% const totalFluxoMovimentado = totalFluxoEntradas + totalFluxoSaidas; %>
  <% const percentualFluxoEntradas = totalFluxoMovimentado > 0 ? Math.round((totalFluxoEntradas / totalFluxoMovimentado) * 100) : 0; %>
  <% const percentualFluxoSaidas = totalFluxoMovimentado > 0 ? Math.max(0, 100 - percentualFluxoEntradas) : 0; %>
  <% const percentualGastosEncontroBar = Number(gastosResumoData.total || 0) > 0 ? Math.round((Number(gastosResumoData.encontro || 0) / Number(gastosResumoData.total || 1)) * 100) : 0; %>
  <% const percentualGastosEquipesBar = Number(gastosResumoData.total || 0) > 0 ? Math.max(0, 100 - percentualGastosEncontroBar) : 0; %>
  <% const gastoCategoriasResumo = (gastosLista || []).reduce(function(acc, item){
    const categoria = String((item && item.categoria) || 'Outros').trim() || 'Outros';
    acc[categoria] = (acc[categoria] || 0) + (Number(item && item.valor) || 0);
    return acc;
  }, {}); %>
  <% const gastoCategoriasOrdenadas = Object.keys(gastoCategoriasResumo)
    .map(function(categoria){ return { categoria: categoria, valor: Number(gastoCategoriasResumo[categoria] || 0) }; })
    .sort(function(a, b){ return b.valor - a.valor; })
    .slice(0, 4); %>
  <% const gastoCategoriaMaiorValor = gastoCategoriasOrdenadas.length ? Number(gastoCategoriasOrdenadas[0].valor || 0) : 0; %>
  <% const extratoMesReferenciaPrincipal = fluxoMensalResumoData.mesReferencia || new Date().toLocaleDateString('pt-BR', { month: 'long', year: 'numeric' }); %>
  <% const extratoMaxValorPrincipal = Math.max(
    1,
    Math.abs(Number(fluxoMensalResumoData.saldoInicial || 0)),
    Math.abs(Number(fluxoMensalResumoData.entradasMes || 0)),
    Math.abs(Number(fluxoMensalResumoData.saidasMes || 0)),
    Math.abs(Number(fluxoMensalResumoData.saldoFinal || 0))
  ); %>
  <% const podeGerenciarAdmins = adminPermissoesLista.includes('admins.gerenciar'); %>
  <% const podeVisualizarPainel = adminPermissoesLista.includes('painel.visualizar'); %>
  <% const abasPermitidasPainel = ['principal', 'encontristas', 'encontreiros', 'tios', 'aprovacoes', 'encontros', 'subequipes', 'gastos', 'administradores']; %>
  <% const abaInicialGerenciarSafe = typeof abaInicialGerenciar !== 'undefined' ? abaInicialGerenciar : 'principal'; %>
  <% const modoPaginaAdministradoresSafe = typeof modoPaginaAdministradores !== 'undefined' ? !!modoPaginaAdministradores : false; %>
  <% const abaInicialPainel = abasPermitidasPainel.includes(String(abaInicialGerenciarSafe || '').toLowerCase()) ? String(abaInicialGerenciarSafe || '').toLowerCase() : 'principal'; %>
  <% const isAbaAtiva = function(abaId){ return abaInicialPainel === abaId; }; %>

  <div class="admin-shell <%= modoPaginaAdministradoresSafe ? 'admin-shell-admins-only' : '' %>">
    <aside class="sidebar">
      <div class="sidebar-top">
        <div class="brand-inline">
          <div class="brand-badge"><img src="/images/rodape.png?v=20260322" alt="EJC COP" loading="lazy" decoding="async"></div>
          <div class="brand-text">EJC COP</div>
        </div>
      </div>

      <nav class="side-menu">
          <button type="button" class="menu-link" data-menu-title="Principal" data-tab-target="principal-tab" data-required-permission="painel.visualizar"><i class="fas fa-chart-line"></i><span class="menu-label">Principal</span></button>
          <button type="button" class="menu-link" data-menu-title="Encontristas" data-tab-target="encontristas-tab" data-required-permission="cadastros.visualizar"><i class="fas fa-user"></i><span class="menu-label">Encontristas</span></button>
          <button type="button" class="menu-link" data-menu-title="Encontreiros" data-tab-target="encontreiros-tab" data-required-permission="cadastros.visualizar"><i class="fas fa-user-group"></i><span class="menu-label">Encontreiros</span></button>
          <button type="button" class="menu-link" data-menu-title="Tios" data-tab-target="tios-tab" data-required-permission="cadastros.visualizar"><i class="fas fa-heart"></i><span class="menu-label">Tios</span></button>
          <button type="button" class="menu-link menu-link-aprovacoes" data-menu-title="Aprovações" data-tab-target="aprovacoes-tab" data-required-permission="cadastros.aprovar" title="<%= pendenciasTituloMenu %>">
            <i class="fas fa-check-circle"></i>
            <span class="menu-label">Aprovações</span>
            <span class="menu-alert-counter <%= pendenciasClasseMenu %>"><%= totalPendencias %></span>
          </button>
          <button type="button" class="menu-link" data-menu-title="Encontros" data-tab-target="encontros-tab" data-required-permission="encontros.gerenciar"><i class="fas fa-calendar-days"></i><span class="menu-label">Encontros</span></button>
          <button type="button" class="menu-link" data-menu-title="Sub-Equipes" data-tab-target="subequipes-tab" data-required-permission="equipes.gerenciar"><i class="fas fa-diagram-project"></i><span class="menu-label">Sub-Equipes</span></button>
          <button type="button" class="menu-link" data-menu-title="Financeiro" data-tab-target="gastos-tab" data-required-permission="gastos.gerenciar"><i class="fas fa-wallet"></i><span class="menu-label">Financeiro</span></button>
          <a href="#administradores" class="menu-link" data-menu-title="Administradores" data-tab-target="administradores-tab" data-required-permission="admins.gerenciar" data-no-transition="true"><i class="fas fa-user-shield"></i><span class="menu-label">Administradores</span></a>
          <form action="/admin/logout" method="POST" class="menu-logout-form">
            <input type="hidden" name="_csrf" value="<%= adminCsrfToken %>">
            <button type="submit" class="menu-link" data-menu-title="Sair"><i class="fas fa-right-from-bracket"></i><span class="menu-label">Sair</span></button>
          </form>
        </nav>

        <div class="sidebar-note">
          Passe o mouse para expandir
        </div>
      </aside>

      <main class="main-panel">
        <header class="topbar workspace-hero-manager <%= pendenciasCriticasMenu ? 'is-critical' : (pendenciasAtencaoMenu ? 'is-attention' : '') %>">
          <div class="workspace-hero-main">
            <h1 class="workspace-title">
              <span class="workspace-title-icon" aria-hidden="true"><i class="fas fa-users-cog"></i></span>
              <span class="workspace-title-copy">
                <span class="workspace-title-kicker"><%= modoPaginaAdministradoresSafe ? 'Administradores' : 'Painel' %></span>
                <span class="workspace-title-main"><%= modoPaginaAdministradoresSafe ? 'Gestão de Administradores' : 'Gestão Administrativa' %></span>
              </span>
            </h1>
            <div class="workspace-hero-strip" aria-label="Destaques da gestão">
              <span class="hero-strip-pill"><i class="fas fa-bullseye"></i>Encontro ativo: <strong><%= encontroAtivoNome || 'Nenhum definido' %></strong></span>
            </div>
            <% if (podeVisualizarPainel) { %>
              <div class="event-scope-workbench" aria-label="Escopo dos dados do painel administrativo">
                <div class="event-scope-switch" role="group" aria-label="Filtro de escopo por encontro">
                  <button
                    type="button"
                    class="event-scope-btn <%= (escopoEventoAdmin || 'ativo') === 'ativo' ? 'active' : '' %>"
                    data-event-scope="ativo"
                    aria-pressed="<%= (escopoEventoAdmin || 'ativo') === 'ativo' ? 'true' : 'false' %>"
                  >
                    <i class="fas fa-bullseye"></i>Somente encontro ativo
                  </button>
                  <button
                    type="button"
                    class="event-scope-btn <%= (escopoEventoAdmin || 'ativo') === 'todos' ? 'active' : '' %>"
                    data-event-scope="todos"
                    aria-pressed="<%= (escopoEventoAdmin || 'ativo') === 'todos' ? 'true' : 'false' %>"
                  >
                    <i class="fas fa-layer-group"></i>Todos os encontros
                  </button>
                </div>
              </div>
            <% } %>
          </div>
          <div class="manager-stats" aria-label="Resumo da gestão">
            <article class="workspace-stat-card">
              <span class="stat-label">Cadastros</span>
              <strong class="stat-value"><%= totalCadastrosVisiveis %></strong>
            </article>
            <article class="workspace-stat-card">
              <span class="stat-label">Pendências</span>
              <strong class="stat-value"><%= totalPendencias %></strong>
            </article>
            <article class="workspace-stat-card">
              <span class="stat-label">Encontros</span>
              <strong class="stat-value"><%= (ejcs || []).length %></strong>
            </article>
            <article class="workspace-stat-card">
              <span class="stat-label">Admins</span>
              <strong class="stat-value"><%= (administradores || []).length %></strong>
            </article>
          </div>
          <div class="hero-admin-stack">
            <div class="admin-pill hero-admin-pill"><span class="hero-admin-avatar"><i class="fas fa-user-shield"></i></span><span class="hero-admin-meta"><small>Logado como</small><strong><%= adminUsername %></strong><small>Nivel: <%= adminNivelAtual %></small></span></div>
            <div class="hero-admin-theme-slot app-theme-toggle-dock app-theme-toggle-dock--manager" aria-hidden="true"></div>
          </div>
        </header>

        <section class="manager-module-grid" aria-label="Atalhos da gestão">
          <button type="button" class="manager-module-card" data-tab-target="principal-tab" data-required-permission="painel.visualizar">
            <span class="manager-module-icon"><i class="fas fa-chart-line"></i></span>
            <span class="manager-module-copy">
              <span class="manager-module-title">Principal</span>
              <span class="manager-module-subtitle">Visão executiva e operação em tempo real</span>
            </span>
            <span class="manager-module-count"><%= totalCadastrosVisiveis %></span>
          </button>
          <button type="button" class="manager-module-card" data-tab-target="encontristas-tab" data-required-permission="cadastros.visualizar">
            <span class="manager-module-icon"><i class="fas fa-user"></i></span>
            <span class="manager-module-copy">
              <span class="manager-module-title">Encontristas</span>
              <span class="manager-module-subtitle">Cadastros e acompanhamento individual</span>
            </span>
            <span class="manager-module-count"><%= (encontristas || []).length %></span>
          </button>
          <button type="button" class="manager-module-card" data-tab-target="encontreiros-tab" data-required-permission="cadastros.visualizar">
            <span class="manager-module-icon"><i class="fas fa-user-group"></i></span>
            <span class="manager-module-copy">
              <span class="manager-module-title">Encontreiros</span>
              <span class="manager-module-subtitle">Equipes de serviço e apoio jovem</span>
            </span>
            <span class="manager-module-count"><%= (encontreirosIndividuais || []).length %></span>
          </button>
          <button type="button" class="manager-module-card" data-tab-target="tios-tab" data-required-permission="cadastros.visualizar">
            <span class="manager-module-icon"><i class="fas fa-heart"></i></span>
            <span class="manager-module-copy">
              <span class="manager-module-title">Tios</span>
              <span class="manager-module-subtitle">Apoio pastoral e serviço no encontro</span>
            </span>
            <span class="manager-module-count"><%= (tios || []).length %></span>
          </button>
          <button type="button" class="manager-module-card" data-tab-target="aprovacoes-tab" data-required-permission="cadastros.aprovar">
            <span class="manager-module-icon"><i class="fas fa-check-circle"></i></span>
            <span class="manager-module-copy">
              <span class="manager-module-title">Aprovações</span>
              <span class="manager-module-subtitle">Triagem, status e decisão dos cadastros</span>
            </span>
            <span class="manager-module-count"><%= totalPendencias %></span>
          </button>
          <button type="button" class="manager-module-card" data-tab-target="encontros-tab" data-required-permission="encontros.gerenciar">
            <span class="manager-module-icon"><i class="fas fa-calendar-days"></i></span>
            <span class="manager-module-copy">
              <span class="manager-module-title">Encontros</span>
              <span class="manager-module-subtitle">Criação e manutenção dos eventos EJC</span>
            </span>
            <span class="manager-module-count"><%= (ejcs || []).length %></span>
          </button>
          <button type="button" class="manager-module-card" data-tab-target="subequipes-tab" data-required-permission="equipes.gerenciar">
            <span class="manager-module-icon"><i class="fas fa-diagram-project"></i></span>
            <span class="manager-module-copy">
              <span class="manager-module-title">Sub-Equipes</span>
              <span class="manager-module-subtitle">Criação e vínculo de encontreiros e tios</span>
            </span>
            <span class="manager-module-count"><%= (subequipes || []).length %></span>
          </button>
          <button type="button" class="manager-module-card" data-tab-target="gastos-tab" data-required-permission="gastos.gerenciar">
            <span class="manager-module-icon"><i class="fas fa-wallet"></i></span>
            <span class="manager-module-copy">
              <span class="manager-module-title">Financeiro</span>
              <span class="manager-module-subtitle">Controle financeiro do encontro e das equipes</span>
            </span>
            <span class="manager-module-count"><%= gastosResumoData.quantidade %></span>
          </button>
          <a href="#administradores" class="manager-module-card" data-tab-target="administradores-tab" data-required-permission="admins.gerenciar" data-no-transition="true">
            <span class="manager-module-icon"><i class="fas fa-user-shield"></i></span>
            <span class="manager-module-copy">
              <span class="manager-module-title">Administradores</span>
              <span class="manager-module-subtitle">Permissões, bloqueios e importações</span>
            </span>
            <span class="manager-module-count"><%= (administradores || []).length %></span>
          </a>
        </section>
        <div class="manager-shortcut-hint" aria-label="Atalhos de teclado">
          <span class="manager-shortcut-title"><i class="fas fa-keyboard"></i>Atalhos</span>
          <div class="manager-shortcut-list" role="list">
            <span class="manager-shortcut-chip" role="listitem">
              <kbd>Alt+1..9</kbd>
              <small>Alternar entre abas</small>
            </span>
            <span class="manager-shortcut-chip" role="listitem">
              <kbd>Alt+D</kbd>
              <small>Abrir dashboard</small>
            </span>
            <span class="manager-shortcut-chip" role="listitem">
              <kbd>Alt+S</kbd>
              <small>Salvar formulário ativo</small>
            </span>
          </div>
        </div>

        <section class="content-card content-card-premium">
        <ul class="nav nav-tabs" id="cadastroTabs" role="tablist">
          <li class="nav-item" role="presentation">
            <button class="nav-link <%= isAbaAtiva('principal') ? 'active' : '' %>" id="principal-tab" data-bs-toggle="tab" data-bs-target="#principal" data-required-permission="painel.visualizar" type="button" aria-selected="<%= isAbaAtiva('principal') ? 'true' : 'false' %>">
              <i class="fas fa-chart-line me-1"></i>Principal
            </button>
          </li>
          <li class="nav-item" role="presentation">
            <button class="nav-link" id="encontristas-tab" data-bs-toggle="tab" data-bs-target="#encontristas" data-required-permission="cadastros.visualizar" type="button">
              <i class="fas fa-user me-1"></i>Encontristas (<%= encontristas.length %>)
            </button>
          </li>
          <li class="nav-item" role="presentation">
            <button class="nav-link" id="encontreiros-tab" data-bs-toggle="tab" data-bs-target="#encontreiros" data-required-permission="cadastros.visualizar" type="button">
              <i class="fas fa-user-group me-1"></i>Encontreiros (<%= encontreirosIndividuais.length %>)
            </button>
          </li>
          <li class="nav-item" role="presentation">
            <button class="nav-link" id="tios-tab" data-bs-toggle="tab" data-bs-target="#tios" data-required-permission="cadastros.visualizar" type="button">
              <i class="fas fa-heart me-1"></i>Tios (<%= tios.length %>)
            </button>
          </li>
          <li class="nav-item" role="presentation">
            <button class="nav-link" id="aprovacoes-tab" data-bs-toggle="tab" data-bs-target="#aprovacoes" data-required-permission="cadastros.aprovar" type="button">
              <i class="fas fa-check-circle me-1"></i>Aprovações
            </button>
          </li>
          <li class="nav-item" role="presentation">
            <button class="nav-link" id="encontros-tab" data-bs-toggle="tab" data-bs-target="#encontros" data-required-permission="encontros.gerenciar" type="button">
              <i class="fas fa-calendar-days me-1"></i>Encontros
            </button>
          </li>
          <li class="nav-item" role="presentation">
            <button class="nav-link" id="subequipes-tab" data-bs-toggle="tab" data-bs-target="#subequipes" data-required-permission="equipes.gerenciar" type="button">
              <i class="fas fa-diagram-project me-1"></i>Sub-Equipes (<%= (subequipes || []).length %>)
            </button>
          </li>
          <li class="nav-item" role="presentation">
            <button class="nav-link" id="gastos-tab" data-bs-toggle="tab" data-bs-target="#gastos" data-required-permission="gastos.gerenciar" type="button">
              <i class="fas fa-wallet me-1"></i>Financeiro (<%= gastosResumoData.quantidade + (fluxoResumoData.quantidade || 0) %>)
            </button>
          </li>
          <li class="nav-item" role="presentation">
            <button class="nav-link <%= isAbaAtiva('administradores') ? 'active' : '' %>" id="administradores-tab" data-bs-toggle="tab" data-bs-target="#administradores" data-required-permission="admins.gerenciar" type="button" aria-selected="<%= isAbaAtiva('administradores') ? 'true' : 'false' %>">
              <i class="fas fa-user-shield me-1"></i>Administradores (<%= administradores.length %>)
            </button>
          </li>
        </ul>

        <div class="tab-content" id="cadastroTabsContent">
          <% if (dadosLimitados) { %>
            <div class="alert alert-warning mb-3" role="alert">
              Visualizacao limitada a <strong><%= listLimit %></strong> registros por lista para manter desempenho.
              Totais atuais: encontristas <strong><%= encontristasTotal %></strong> e encontreiros/tios <strong><%= encontreirosTotal %></strong>.
              Use filtros de escopo ou parametro <code>?listLimit=</code> (max 5000) quando necessario.
            </div>
          <% } %>
          <!-- TAB: PRINCIPAL -->
          <div class="tab-pane fade <%= isAbaAtiva('principal') ? 'show active' : '' %>" id="principal" data-required-permission="painel.visualizar" role="tabpanel">
            <section class="principal-lite-hero">
              <div class="principal-lite-title-wrap">
                <h3>Bem-vindo ao Painel do EJC</h3>
                <p>Gerencie inscrições, equipes, gastos e status do encontro em um único lugar.</p>
              </div>
              <div class="principal-lite-kpis">
                <article class="principal-lite-kpi kpi-blue">
                  <span>Inscritos</span>
                  <strong><%= totalCadastrosVisiveis %></strong>
                  <small>Novos: <%= atividadeRecente.length %></small>
                </article>
                <article class="principal-lite-kpi kpi-orange">
                  <span>Equipes</span>
                  <strong><%= (equipes || []).length %></strong>
                  <small>Sub-equipes: <%= (subequipes || []).length %></small>
                </article>
                <article class="principal-lite-kpi kpi-green">
                  <span>Confirmados</span>
                  <strong><%= totalAprovadosGeral %></strong>
                  <small>Taxa: <%= taxaAprovacaoGeral %>%</small>
                </article>
                <article class="principal-lite-kpi kpi-red">
                  <span>Pendências</span>
                  <strong><%= totalPendenciasGeral %></strong>
                  <small>Aguardando ação</small>
                </article>
              </div>

            </section>

            <div class="principal-lite-grid">
              <section class="principal-lite-panel principal-lite-panel-main">
                <div class="principal-lite-panel-head">
                  <h6>Gráficos de Controle de Gastos</h6>
                  <span>Visão financeira consolidada</span>
                </div>

                <div class="principal-finance-board">
                  <div class="principal-finance-board-head">
                    <h6>Controle de Gastos</h6>
                    <span>Gráficos financeiros</span>
                  </div>

                  <div class="principal-finance-kpi-grid">
                    <article class="principal-finance-kpi-card is-balance">
                      <div class="kpi-icon"><i class="fas fa-wallet"></i></div>
                      <small>Saldo atual</small>
                      <strong><%= Number(fluxoResumoData.saldo || 0).toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' }) %></strong>
                      <span>Posição consolidada do caixa</span>
                    </article>
                    <article class="principal-finance-kpi-card is-exit">
                      <div class="kpi-icon"><i class="fas fa-arrow-trend-down"></i></div>
                      <small>Saídas lançadas</small>
                      <strong><%= totalFluxoSaidas.toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' }) %></strong>
                      <span><%= gastosResumoData.quantidade || 0 %> despesa(s) registradas</span>
                    </article>
                    <article class="principal-finance-kpi-card is-entry">
                      <div class="kpi-icon"><i class="fas fa-arrow-trend-up"></i></div>
                      <small>Entradas</small>
                      <strong><%= totalFluxoEntradas.toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' }) %></strong>
                      <span>Receitas e repasses no caixa</span>
                    </article>
                    <article class="principal-finance-kpi-card is-ticket">
                      <div class="kpi-icon"><i class="fas fa-receipt"></i></div>
                      <small>Ticket médio</small>
                      <strong><%= Number(gastoMedioGeral || 0).toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' }) %></strong>
                      <span>Média por lançamento de gasto</span>
                    </article>
                  </div>

                  <div class="principal-finance-chart-grid">
                    <article class="principal-finance-card">
                      <div class="principal-finance-card-head">
                        <strong>Fluxo do caixa</strong>
                        <span><%= percentualFluxoEntradas %>% entradas</span>
                      </div>
                      <div class="principal-finance-donut-wrap">
                        <div
                          class="principal-finance-donut"
                          style="background: conic-gradient(#27c97a 0 <%= percentualFluxoEntradas %>%, #f34f5f <%= percentualFluxoEntradas %>% 100%);"
                          aria-label="Percentual de entradas e saídas"
                          role="img"
                        >
                          <div class="principal-finance-donut-center">
                            <strong><%= percentualFluxoEntradas %>%</strong>
                            <span>Entradas</span>
                          </div>
                        </div>
                        <div class="principal-finance-legend">
                          <div class="is-entry"><i></i>Entradas <strong><%= totalFluxoEntradas.toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' }) %></strong></div>
                          <div class="is-exit"><i></i>Saídas <strong><%= totalFluxoSaidas.toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' }) %></strong></div>
                          <div class="is-balance"><i></i>Saldo <strong><%= Number(fluxoResumoData.saldo || 0).toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' }) %></strong></div>
                        </div>
                      </div>
                    </article>

                    <article class="principal-finance-card">
                      <div class="principal-finance-card-head">
                        <strong>Gastos por escopo</strong>
                        <span><%= percentualGastosEquipesBar %>% equipes</span>
                      </div>
                      <div class="principal-finance-donut-wrap">
                        <div
                          class="principal-finance-donut"
                          style="background: conic-gradient(#2f7bff 0 <%= percentualGastosEncontroBar %>%, #ffb200 <%= percentualGastosEncontroBar %>% 100%);"
                          aria-label="Percentual de gastos por escopo"
                          role="img"
                        >
                          <div class="principal-finance-donut-center">
                            <strong><%= percentualGastosEncontroBar %>%</strong>
                            <span>Encontro</span>
                          </div>
                        </div>
                        <div class="principal-finance-legend">
                          <div class="is-encontro"><i></i>Encontro <strong><%= Number(gastosResumoData.encontro || 0).toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' }) %></strong></div>
                          <div class="is-equipes"><i></i>Equipes <strong><%= Number(gastosResumoData.equipes || 0).toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' }) %></strong></div>
                          <div class="is-total"><i></i>Total <strong><%= Number(gastosResumoData.total || 0).toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' }) %></strong></div>
                        </div>
                      </div>
                    </article>
                  </div>

                  <article class="principal-finance-category-panel">
                    <div class="principal-finance-card-head">
                      <strong>Distribuição de gastos por categoria</strong>
                      <span>Top categorias</span>
                    </div>
                    <% if (!gastoCategoriasOrdenadas.length) { %>
                      <p class="principal-finance-empty">Ainda não existem gastos suficientes para gerar o gráfico.</p>
                    <% } else { %>
                      <div class="principal-finance-category-list">
                        <% gastoCategoriasOrdenadas.forEach(function(item){ %>
                          <% const percentualCategoria = gastoCategoriaMaiorValor > 0 ? Math.round((Number(item.valor || 0) / gastoCategoriaMaiorValor) * 100) : 0; %>
                          <div class="principal-finance-category-item">
                            <div class="category-top">
                              <span><%= item.categoria %></span>
                              <strong><%= Number(item.valor || 0).toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' }) %></strong>
                            </div>
                            <div class="category-bar"><span style="width: <%= percentualCategoria %>%;"></span></div>
                          </div>
                        <% }); %>
                      </div>
                    <% } %>
                  </article>

                  <article class="principal-finance-extrato-panel">
                    <div class="principal-finance-card-head">
                      <strong>Extrato mensal de <%= extratoMesReferenciaPrincipal %></strong>
                      <span>Saldo do período</span>
                    </div>
                    <div class="principal-finance-extrato-list">
                      <div class="extrato-item">
                        <div class="extrato-row"><span>Saldo inicial</span><strong><%= Number(fluxoMensalResumoData.saldoInicial || 0).toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' }) %></strong></div>
                        <div class="extrato-bar"><span class="is-balance" style="width: <%= Math.max(4, Math.round((Math.abs(Number(fluxoMensalResumoData.saldoInicial || 0)) / extratoMaxValorPrincipal) * 100)) %>%;"></span></div>
                      </div>
                      <div class="extrato-item">
                        <div class="extrato-row"><span>Entradas</span><strong><%= Number(fluxoMensalResumoData.entradasMes || 0).toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' }) %></strong></div>
                        <div class="extrato-bar"><span class="is-entry" style="width: <%= Math.max(4, Math.round((Math.abs(Number(fluxoMensalResumoData.entradasMes || 0)) / extratoMaxValorPrincipal) * 100)) %>%;"></span></div>
                      </div>
                      <div class="extrato-item">
                        <div class="extrato-row"><span>Saídas</span><strong><%= Number(fluxoMensalResumoData.saidasMes || 0).toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' }) %></strong></div>
                        <div class="extrato-bar"><span class="is-exit" style="width: <%= Math.max(4, Math.round((Math.abs(Number(fluxoMensalResumoData.saidasMes || 0)) / extratoMaxValorPrincipal) * 100)) %>%;"></span></div>
                      </div>
                      <div class="extrato-item">
                        <div class="extrato-row"><span>Saldo final</span><strong><%= Number(fluxoMensalResumoData.saldoFinal || 0).toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' }) %></strong></div>
                        <div class="extrato-bar"><span class="is-total" style="width: <%= Math.max(4, Math.round((Math.abs(Number(fluxoMensalResumoData.saldoFinal || 0)) / extratoMaxValorPrincipal) * 100)) %>%;"></span></div>
                      </div>
                    </div>
                  </article>
                </div>
              </section>

              <aside class="principal-lite-side">
                <section class="principal-lite-panel">
                  <div class="principal-lite-panel-head">
                    <h6>Status do Encontro</h6>
                    <span>Indicadores rápidos</span>
                  </div>
                  <div class="principal-lite-progress-wrap">
                    <div class="principal-lite-progress-item">
                      <div class="principal-lite-progress-label"><span>Confirmados</span><strong><%= totalAprovadosGeral %> / <%= totalCadastrosVisiveis || 0 %></strong></div>
                      <div class="principal-lite-progress-bar"><span class="bar-confirmados" style="width: <%= taxaAprovacaoGeral %>%;"></span></div>
                    </div>
                    <div class="principal-lite-progress-item">
                      <div class="principal-lite-progress-label"><span>Pendentes</span><strong><%= totalPendenciasGeral %> / <%= totalCadastrosVisiveis || 0 %></strong></div>
                      <div class="principal-lite-progress-bar"><span class="bar-pendentes" style="width: <%= taxaPendenciaGeral %>%;"></span></div>
                    </div>
                    <div class="principal-lite-progress-item">
                      <div class="principal-lite-progress-label"><span>Reprovados</span><strong><%= totalReprovadosGeral %> / <%= totalCadastrosVisiveis || 0 %></strong></div>
                      <div class="principal-lite-progress-bar"><span class="bar-reprovados" style="width: <%= taxaReprovacaoGeral %>%;"></span></div>
                    </div>
                    <div class="principal-lite-progress-item">
                      <div class="principal-lite-progress-label"><span>Gastos em equipes</span><strong><%= Number(gastosResumoData.equipes || 0).toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' }) %></strong></div>
                      <div class="principal-lite-progress-bar"><span class="bar-gastos" style="width: <%= gastosResumoData.total ? Math.min(100, Math.round((gastosResumoData.equipes / gastosResumoData.total) * 100)) : 0 %>%;"></span></div>
                    </div>
                  </div>
                </section>

                <section class="principal-lite-panel">
                  <div class="principal-lite-panel-head">
                    <h6>Alertas</h6>
                    <span>Pontos de atenção</span>
                  </div>
                  <div class="principal-lite-alerts">
                    <% if (totalPendenciasGeral > 0) { %>
                      <div class="principal-lite-alert alert-danger-soft"><i class="fas fa-triangle-exclamation"></i>Existem <strong><%= totalPendenciasGeral %></strong> cadastro(s) pendente(s) aguardando aprovação.</div>
                    <% } %>
                    <% if (!encontroAtivoNome) { %>
                      <div class="principal-lite-alert alert-warning-soft"><i class="fas fa-bullseye"></i>Defina um encontro ativo para organizar novos vínculos automaticamente.</div>
                    <% } %>
                    <% if ((gastosResumoData.total || 0) > 0) { %>
                      <div class="principal-lite-alert alert-info-soft"><i class="fas fa-wallet"></i>Total de gastos lançados: <strong><%= Number(gastosResumoData.total || 0).toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' }) %></strong>.</div>
                    <% } %>
                    <% if (totalPendenciasGeral === 0 && encontroAtivoNome) { %>
                      <div class="principal-lite-alert alert-success-soft"><i class="fas fa-circle-check"></i>Painel estável: sem pendências críticas no momento.</div>
                    <% } %>
                  </div>
                </section>
              </aside>
            </div>
          </div>

          <!-- TAB: ENCONTRISTAS -->
          <div class="tab-pane fade" id="encontristas" data-required-permission="cadastros.visualizar" role="tabpanel">
            <div class="tab-workspace-head">
              <div>
                <p class="tab-kicker">Area Encontristas</p>
                <h5><i class="fas fa-user me-2"></i>Gestao de Encontristas</h5>
              </div>
              <div class="tab-head-chips">
                <span class="tab-chip">Total: <%= (encontristas || []).length %></span>
                <span class="tab-chip tab-chip-ok">Aprovados: <%= encontristasAprovados.length %></span>
                <span class="tab-chip tab-chip-pending">Pendentes: <%= encontristasPendentes.length %></span>
              </div>
            </div>
            <div class="export-group-actions mb-3">
              <a href="/export?format=pdf" class="btn btn-sm btn-outline-secondary export-btn export-btn-pdf" target="_blank" rel="noreferrer" title="Exportar como PDF">
                <i class="fas fa-file-pdf me-1"></i>PDF
              </a>
              <a href="/export-encontrista-excel" class="btn btn-sm btn-outline-secondary export-btn export-btn-report" target="_blank" rel="noreferrer" title="Exportar Relatório em Excel">
                <i class="fas fa-table me-1"></i>Relatório
              </a>
              <a href="/export-images-encontristas" class="btn btn-sm btn-outline-secondary export-btn export-btn-image" target="_blank" rel="noreferrer" title="Exportar Imagens">
                <i class="fas fa-file-archive me-1"></i>Imagens
              </a>
            </div>
            <div class="transfer-lote-bar">
              <button id="btn-transferir-selecionados" class="btn btn-approve" type="button" onclick="transferirSelecionadosEncontristas()" disabled>
                <i class="fas fa-right-left me-1"></i>Transferir selecionados (0)
              </button>
              <small class="text-muted">Voce pode selecionar varios encontristas e transferir todos de uma vez.</small>
            </div>
            <div class="search-toolbar">
              <div class="search-input-wrap">
                <i class="fas fa-search"></i>
                <input id="search-encontristas" class="search-input" type="text" placeholder="Pesquisar encontristas por nome">
              </div>
              <button id="clear-search-encontristas" type="button" class="btn-clear-search">
                <i class="fas fa-eraser me-1"></i>Limpar busca
              </button>
            </div>
            <div class="admin-form-card admin-config-card manager-status-card manager-status-card-approved">
              <div class="admin-card-head manager-status-card-head">
                <div>
                  <p class="admin-card-kicker">Resultado positivo</p>
                  <h5><i class="fas fa-circle-check me-2"></i>Encontristas aprovados</h5>
                  <p class="admin-card-subtitle">Cadastros liberados para seguir no fluxo, com acesso rápido a edição, transferência e exclusão.</p>
                </div>
                <span class="admin-card-badge"><%= encontristasAprovados.length %> aprovados</span>
              </div>
              <div class="table-wrap manager-table-shell">
              <table class="table table-hover">
                <thead>
                  <tr>
                    <th class="checkbox-col"><input type="checkbox" onchange="toggleSelecionarTodosEncontristas(this, 'aprovado')" title="Selecionar todos aprovados"></th>
                    <th>Foto</th>
                    <th>Nome</th>
                    <th>Telefone</th>
                    <th>Email</th>
                    <th>Alergia</th>
                    <th>Sub-equipes</th>
                    <th>Status</th>
                    <th>Ações</th>
                  </tr>
                </thead>
                <tbody>
                  <% if (encontristasAprovados.length === 0) { %>
                    <tr><td colspan="9" class="empty-state">Nenhum encontrista aprovado.</td></tr>
                  <% } else { %>
                    <% encontristasAprovados.forEach(function(cadastro) { %>
                      <tr data-searchable="true" data-transfer-group="aprovado">
                        <td class="checkbox-col">
                          <input class="transfer-encontrista-check" type="checkbox" value="<%= cadastro._id %>" onchange="atualizarTransferenciaLoteUI()">
                        </td>
                        <td>
                          <% if (cadastro.foto) { %>
                            <img src="/img/uploads/<%= encodeURIComponent(cadastro.foto) %>?w=120&h=120&fit=cover&format=webp" loading="lazy" decoding="async" alt="Foto" class="table-photo">
                          <% } else { %>
                            <i class="fas fa-user-circle fa-2x text-secondary"></i>
                          <% } %>
                        </td>
                        <td><%= cadastro.nomeCompleto %></td>
                        <td><%= cadastro.telefone %></td>
                        <td><%= cadastro.email %></td>
                        <td><%= resumoAlergia(cadastro) %></td>
                        <td><%- renderSubequipesChips(cadastro) %></td>
                        <td>
                          <% if (statusCadastroGrupo(cadastro) === 'aprovado') { %>
                            <span class="status-badge status-ok">Aprovado</span>
                          <% } else if (statusCadastroGrupo(cadastro) === 'reprovado') { %>
                            <span class="status-badge status-danger">Reprovado</span>
                          <% } else { %>
                            <span class="status-badge status-pending">Pendente</span>
                          <% } %>
                        </td>
                        <td>
                          <button class="btn btn-edit" onclick="editarCadastro('encontrista', '<%= cadastro._id %>')">
                            <i class="fas fa-edit me-1"></i>Editar
                          </button>
                          <button class="btn btn-approve" onclick="transferirParaEncontreiros('<%= cadastro._id %>', '<%= cadastro.nomeCompleto.replace(/'/g, "\\'") %>')">
                            <i class="fas fa-right-left me-1"></i>Transferir
                          </button>
                          <button class="btn btn-delete" data-nome="<%= cadastro.nomeCompleto %>" onclick="deletarCadastro('encontrista', '<%= cadastro._id %>', this.dataset.nome)">
                            <i class="fas fa-trash me-1"></i>Deletar
                          </button>
                        </td>
                      </tr>
                    <% }); %>
                  <% } %>
                </tbody>
              </table>
              </div>
            </div>

            <div class="admin-form-card admin-config-card manager-status-card manager-status-card-rejected">
              <div class="admin-card-head manager-status-card-head">
                <div>
                  <p class="admin-card-kicker">Revisão encerrada</p>
                  <h5><i class="fas fa-circle-xmark me-2"></i>Encontristas reprovados</h5>
                  <p class="admin-card-subtitle">Registros que não avançaram no processo e permanecem disponíveis para reavaliação administrativa.</p>
                </div>
                <span class="admin-card-badge"><%= encontristasReprovados.length %> reprovados</span>
              </div>
              <div class="table-wrap manager-table-shell">
              <table class="table table-hover">
                <thead>
                  <tr>
                    <th class="checkbox-col"><input type="checkbox" onchange="toggleSelecionarTodosEncontristas(this, 'reprovado')" title="Selecionar todos reprovados"></th>
                    <th>Foto</th>
                    <th>Nome</th>
                    <th>Telefone</th>
                    <th>Email</th>
                    <th>Alergia</th>
                    <th>Sub-equipes</th>
                    <th>Status</th>
                    <th>Ações</th>
                  </tr>
                </thead>
                <tbody>
                  <% if (encontristasReprovados.length === 0) { %>
