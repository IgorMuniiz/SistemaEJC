    function setImportResultState(kind, html) {
      const resultBox = document.getElementById('import_result');
      if (!resultBox) return;
      resultBox.className = `import-result ${kind}`;
      resultBox.innerHTML = html;
    }

    function buildImportacaoFormData(payload) {
      const formData = new FormData();
      formData.append('tipoImportacao', payload.tipoImportacao);
      formData.append('sourceType', payload.sourceType);
      formData.append('dbEngine', payload.dbEngine);
      formData.append('connectionString', payload.connectionString);
      formData.append('mongoUri', payload.connectionString);
      formData.append('databaseName', payload.databaseName);
      formData.append('colecaoEncontreiros', payload.tableName);
      formData.append('tableName', payload.tableName);
      formData.append('limite', payload.limite);
      formData.append('atualizarExistentes', payload.atualizarExistentes ? 'true' : 'false');
      formData.append('fotoPadrao', payload.fotoPadrao);
      formData.append('dryRun', payload.dryRun ? 'true' : 'false');

      if (payload.tipoImportacao === 'encontro_completo') {
        formData.append('sourceEncontroId', payload.encontroOrigemId || '');
        formData.append('ejcId', payload.ejcSelecionado || '');
        formData.append('colecaoEquipes', payload.colecaoEquipesCompleta || 'Equipe');
        formData.append('colecaoCirculos', payload.colecaoCirculosCompleta || 'Circulo');
        formData.append('colecaoEncontreiros', payload.colecaoEncontreirosCompleta || 'Encontro');
        formData.append('importarEquipes', payload.importarEquipes ? 'true' : 'false');
        formData.append('importarCirculos', payload.importarCirculos ? 'true' : 'false');
        formData.append('importarEncontreiros', payload.importarEncontreiros ? 'true' : 'false');
      }

      if (payload.sourceType !== 'database' && payload.sourceType !== 'sistema' && payload.arquivo) {
        formData.append('arquivo', payload.arquivo);
      }

      return formData;
    }

    async function executarImportacaoRequest(payload) {
      const response = await fetch('/admin/importar-cadastros', {
        method: 'POST',
        body: buildImportacaoFormData(payload),
      });

      const responseType = response.headers.get('content-type') || '';
      const isJson = responseType.includes('application/json');
      const result = isJson
        ? await response.json()
        : { success: false, error: await response.text() };

      if (!response.ok || !result.success) {
        throw new Error((result.error || 'Erro ao importar').toString().replace(/<[^>]*>/g, '').slice(0, 500));
      }

      return result;
    }

