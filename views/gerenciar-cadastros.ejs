    function renderVinculadosSubequipe() {
      const subequipeSelecionada = document.getElementById('visualizar_subequipe').value;
      const tabela = document.getElementById('tabela-vinculados-subequipe');
      if (!tabela) return;

      const tbody = tabela.querySelector('tbody');
      if (!tbody) return;

      if (!subequipeSelecionada) {
        tbody.innerHTML = '<tr><td colspan="4" class="empty-state">Selecione uma sub-equipe para visualizar os vinculados.</td></tr>';
        return;
      }

      const agrupadoPorAno = new Map();

      (encontreiros || []).forEach((pessoa) => {
        const historico = Array.isArray(pessoa.subequipeCoordenacoes) ? pessoa.subequipeCoordenacoes : [];
        const entradas = historico.filter((item) => String(item?.subequipeId || '') === String(subequipeSelecionada));
        if (entradas.length === 0) return;

        entradas.forEach((entrada) => {
          const anoNum = Number.parseInt(String(entrada?.anoVigencia || ''), 10);
          const anoKey = Number.isFinite(anoNum) ? String(anoNum) : 'Sem ano';

          if (!agrupadoPorAno.has(anoKey)) {
            agrupadoPorAno.set(anoKey, new Map());
          }

          const pessoasAno = agrupadoPorAno.get(anoKey);
          const pessoaKey = String(pessoa._id || pessoa.id || pessoa.nomeCompleto || Math.random());

          if (!pessoasAno.has(pessoaKey)) {
            pessoasAno.set(pessoaKey, {
              nome: pessoa.nomeCompleto || '-',
              tipo: pessoa.tipo === 'tios' ? 'Tios' : 'Jovens',
              coordenacoes: new Set(),
            });
          }

          const pessoaItem = pessoasAno.get(pessoaKey);
          pessoaItem.coordenacoes.add(entrada?.subequipeNome || '-');
        });
      });

      if (agrupadoPorAno.size === 0) {
        tbody.innerHTML = '<tr><td colspan="4" class="empty-state">Nenhuma pessoa vinculada nesta sub-equipe.</td></tr>';
        return;
      }

      const anosOrdenados = Array.from(agrupadoPorAno.keys()).sort((a, b) => {
        const aNum = Number.parseInt(a, 10);
        const bNum = Number.parseInt(b, 10);
        const aValido = Number.isFinite(aNum);
        const bValido = Number.isFinite(bNum);

        if (aValido && bValido) return bNum - aNum;
        if (aValido) return -1;
        if (bValido) return 1;
        return a.localeCompare(b, 'pt-BR');
      });

      const linhas = [];

      anosOrdenados.forEach((ano) => {
        linhas.push(`<tr class="table-light"><td colspan="4"><strong>Ano ${escapeHtml(ano)}</strong></td></tr>`);

        const pessoasMap = agrupadoPorAno.get(ano);
        const pessoasOrdenadas = Array.from(pessoasMap.values()).sort((p1, p2) =>
          String(p1.nome || '').localeCompare(String(p2.nome || ''), 'pt-BR')
        );

        pessoasOrdenadas.forEach((pessoa) => {
          linhas.push(`<tr>
            <td>${escapeHtml(pessoa.nome || '-')}</td>
            <td>${escapeHtml(pessoa.tipo || '-')}</td>
            <td>${escapeHtml(ano)}</td>
            <td>${escapeHtml(Array.from(pessoa.coordenacoes).join(', ') || '-')}</td>
          </tr>`);
        });
      });

      tbody.innerHTML = linhas.join('');
    }

