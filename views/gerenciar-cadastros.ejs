    async function deletarCadastro(tipo, id, nome) {
      const triggerButton = getActionTriggerButton();
      const rows = getCadastroRowsById(tipo, id);
      if (!await appConfirm(`Tem certeza que deseja deletar o cadastro de "${nome}"? Esta acao nao pode ser desfeita.`, 'Confirmar exclusao')) return;

      setActionButtonBusy(triggerButton, true, 'Excluindo...');
      setRowsPendingState(rows, true);

      try {
        const response = await fetch(`/admin/deletar-cadastro/${encodeURIComponent(tipo)}/${encodeURIComponent(id)}`, {
          method: 'POST',
          headers: { Accept: 'application/json' }
        });

        const contentType = response.headers.get('content-type') || '';
        const result = contentType.includes('application/json')
          ? await response.json()
          : { success: false, error: await response.text() };

        if (result.success) {
          queueManagerFeedback({ tabId: getAbaAtivaPainelId() });
          await appAlert('Cadastro deletado com sucesso.', 'success', 'Sucesso');
          recarregarMantendoAbaAtual();
        } else {
          await appAlert(result.error || 'Erro ao deletar cadastro.', 'danger', 'Erro');
        }
      } catch (error) {
        await appAlert('Erro ao deletar cadastro: ' + (error.message || 'falha de conexao'), 'danger', 'Erro');
      } finally {
        setActionButtonBusy(triggerButton, false);
        setRowsPendingState(rows, false);
      }
    }

    async function transferirParaEncontreiros(id, nome) {
      const triggerButton = getActionTriggerButton();
      const rows = getCadastroRowsById('encontrista', id);
        const encontroDestino = await solicitarEncontroTransferencia(1);
        if (!encontroDestino) return;

        const confirmar = await appConfirm(`Transferir "${nome}" de Encontristas para Encontreiros no encontro "${encontroDestino.nome}"?\n\nAo confirmar, o cadastro sai da aba Encontristas e passa para Encontreiros já vinculado a esse encontro.`, 'Confirmar transferencia');
      if (!confirmar) return;

      setActionButtonBusy(triggerButton, true, 'Transferindo...');
      setRowsPendingState(rows, true);

      try {
        const response = await fetch(`/admin/transferir-encontrista/${encodeURIComponent(id)}`, {
          method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              Accept: 'application/json'
            },
            body: JSON.stringify({ ejcId: encontroDestino._id }),
        });

        const contentType = response.headers.get('content-type') || '';
        const result = contentType.includes('application/json')
          ? await response.json()
          : { success: false, error: await response.text() };

        if (result.success) {
          queueManagerFeedback({ tabId: getAbaAtivaPainelId() });
          await appAlert(`Transferencia realizada com sucesso para o encontro ${encontroDestino.nome}.`, 'success', 'Sucesso');
          recarregarMantendoAbaAtual();
          return;
        }

        await appAlert(result.error || 'Nao foi possivel transferir o cadastro.', 'danger', 'Erro');
      } catch (error) {
        await appAlert('Erro ao transferir cadastro: ' + (error.message || 'falha de conexao'), 'danger', 'Erro');
      } finally {
        setActionButtonBusy(triggerButton, false);
        setRowsPendingState(rows, false);
      }
    }

