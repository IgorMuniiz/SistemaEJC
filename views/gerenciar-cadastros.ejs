    function getCheckedAdminPermissions(selector) {
      const nodes = document.querySelectorAll(selector);
      return Array.from(nodes)
        .filter((node) => node.checked)
        .map((node) => String(node.value || '').trim())
        .filter(Boolean);
    }

    function setCheckedAdminPermissions(selector, permissions) {
      const selected = new Set(Array.isArray(permissions) ? permissions : []);
      const nodes = document.querySelectorAll(selector);
      nodes.forEach((node) => {
        node.checked = selected.has(String(node.value || '').trim());
      });
    }

    function applyRoleDefaultPermissions(levelSelectorId, checkboxSelector) {
      const levelNode = document.getElementById(levelSelectorId);
      if (!levelNode) return;

      const level = String(levelNode.value || '').trim();
      const defaults = Array.isArray(adminRoleDefaults[level]) ? adminRoleDefaults[level] : [];
      setCheckedAdminPermissions(checkboxSelector, defaults);
    }

    function shouldExpandExtraPermissionsForLevel(level) {
      const normalizedLevel = String(level || '').trim();
      const defaults = Array.isArray(adminRoleDefaults[normalizedLevel]) ? adminRoleDefaults[normalizedLevel] : [];
      const availableOptions = Array.isArray(adminPermissionOptionsData) ? adminPermissionOptionsData : [];
      return availableOptions.some((option) => {
        const key = String((option && option.key) || '').trim();
        return key && !defaults.includes(key);
      });
    }

    function toggleAdminPermissionsCollapse(expand) {
      const collapseNode = document.getElementById('admin_permissions_collapse');
      if (!collapseNode) return;

      const toggleNode = document.querySelector('[data-bs-target="#admin_permissions_collapse"]');
      if (typeof bootstrap !== 'undefined' && bootstrap.Collapse) {
        const collapse = bootstrap.Collapse.getOrCreateInstance(collapseNode, { toggle: false });
        if (expand) collapse.show();
        else collapse.hide();
      } else {
        collapseNode.classList.toggle('show', !!expand);
      }

      if (toggleNode) {
        toggleNode.setAttribute('aria-expanded', expand ? 'true' : 'false');
      }
    }

