                        <td><%= cadastro.telefone %></td>
                        <td><%= cadastro.email %></td>
                        <td><%= resumoAlergia(cadastro) %></td>
                        <td><%- renderSubequipesChips(cadastro) %></td>
                        <td>
                          <% if (statusCadastroGrupo(cadastro) === 'aprovado') { %>
                            <span class="status-badge status-ok">Aprovado</span>
                          <% } else if (statusCadastroGrupo(cadastro) === 'reprovado') { %>
                            <span class="status-badge status-danger">Reprovado</span>
                          <% } else { %>
                            <span class="status-badge status-pending">Pendente</span>
                          <% } %>
                        </td>
                        <td>
                          <button class="btn btn-edit" onclick="editarCadastro('encontreiro', '<%= cadastro._id %>')">
                            <i class="fas fa-edit me-1"></i>Editar
                          </button>
                          <button class="btn btn-delete" data-nome="<%= cadastro.nomeCompleto %>" onclick="deletarCadastro('encontreiro', '<%= cadastro._id %>', this.dataset.nome)">
                            <i class="fas fa-trash me-1"></i>Deletar
                          </button>
                        </td>
                      </tr>
                    <% }); %>
                  <% } %>
                </tbody>
              </table>
              </div>
            </div>
          </div>

          <!-- TAB: APROVACOES -->
          <div class="tab-pane fade" id="aprovacoes" data-required-permission="cadastros.aprovar" role="tabpanel">
            <% const encontristasPendentesAprovacoes = (encontristas || []).filter(c => statusCadastroGrupo(c) === 'pendente'); %>
            <% const encontreirosPendentesAprovacoes = (encontreiros || []).filter(c => statusCadastroGrupo(c) === 'pendente'); %>
            <% const totalPendentesAprovacoes = encontristasPendentesAprovacoes.length + encontreirosPendentesAprovacoes.length; %>
            <% const filaCriticaAprovacoes = totalPendentesAprovacoes >= 12; %>
            <% const filaAtencaoAprovacoes = !filaCriticaAprovacoes && totalPendentesAprovacoes >= 6; %>
            <div class="tab-workspace-head approval-workspace-head <%= filaCriticaAprovacoes ? 'approval-queue-critical' : (filaAtencaoAprovacoes ? 'approval-queue-attention' : '') %>">
              <div>
                <p class="tab-kicker">Area Aprovações</p>
                <h5><i class="fas fa-check-circle me-2"></i>Central de Aprovação</h5>
              </div>
              <div class="tab-head-chips">
                <span class="tab-chip">Fila total: <%= totalPendentesAprovacoes %></span>
                <% if (filaCriticaAprovacoes) { %>
                  <span class="tab-chip tab-chip-alert">Fila critica</span>
                <% } else if (filaAtencaoAprovacoes) { %>
                  <span class="tab-chip tab-chip-alert">Fila em atenção</span>
                <% } %>
                <span class="tab-chip tab-chip-pending">Encontristas: <%= encontristasPendentesAprovacoes.length %></span>
                <span class="tab-chip tab-chip-soft">Encontreiros: <%= encontreirosPendentesAprovacoes.length %></span>
              </div>
            </div>

            <div class="approval-overview">
              <article class="approval-metric-card <%= filaCriticaAprovacoes ? 'approval-metric-card-critical' : (filaAtencaoAprovacoes ? 'approval-metric-card-attention' : '') %>">
                <span class="approval-metric-icon approval-metric-icon-pending"><i class="fas fa-hourglass-half"></i></span>
                <div>
                  <span class="approval-metric-label">Aguardando triagem</span>
                  <strong class="approval-metric-value"><%= totalPendentesAprovacoes %></strong>
                  <p class="approval-metric-note">Cadastros prontos para análise manual.</p>
                </div>
              </article>
              <article class="approval-metric-card">
                <span class="approval-metric-icon approval-metric-icon-ok"><i class="fas fa-user"></i></span>
                <div>
                  <span class="approval-metric-label">Encontristas pendentes</span>
                  <strong class="approval-metric-value"><%= encontristasPendentesAprovacoes.length %></strong>
                  <p class="approval-metric-note">Revise dados e libere a participação no encontro.</p>
                </div>
              </article>
              <article class="approval-metric-card">
                <span class="approval-metric-icon approval-metric-icon-info"><i class="fas fa-user-group"></i></span>
                <div>
                  <span class="approval-metric-label">Encontreiros pendentes</span>
                  <strong class="approval-metric-value"><%= encontreirosPendentesAprovacoes.length %></strong>
                  <p class="approval-metric-note">Mantenha a fila organizada por perfil e edição.</p>
                </div>
              </article>
            </div>

            <div class="search-toolbar approval-search-toolbar">
              <div class="search-input-wrap">
                <i class="fas fa-search"></i>
                <input id="search-aprovacoes" class="search-input" type="text" placeholder="Pesquisar aprovações por nome ou EJC">
              </div>
              <button id="clear-search-aprovacoes" type="button" class="btn-clear-search">
                <i class="fas fa-eraser me-1"></i>Limpar busca
              </button>
            </div>

            <div class="approval-batch-toolbar">
              <div class="approval-batch-toolbar-main">
                <span class="approval-batch-kicker">Ação em lote</span>
                <label class="approval-batch-toggle" for="approval-select-all-visible">
                  <input id="approval-select-all-visible" type="checkbox" onchange="toggleSelecionarTodosAprovacoes(this)">
                  <span>Selecionar todos os visíveis</span>
                </label>
              </div>
              <div class="approval-batch-toolbar-status">
                <span class="approval-batch-counter-label">Seleção atual</span>
                <span id="approval-batch-counter" class="approval-batch-counter">0 selecionado(s)</span>
              </div>
              <div class="approval-batch-toolbar-actions">
                <button id="btn-limpar-selecao-aprovacoes" class="btn btn-outline-secondary btn-sm" type="button" onclick="limparSelecaoAprovacoes()">
                  <i class="fas fa-eraser me-1"></i>Limpar seleção
                </button>
                <button id="btn-aprovar-selecionados-aprovacoes" class="btn btn-approve btn-sm" type="button" onclick="executarAprovacaoLote('aprovar')" disabled>
                  <i class="fas fa-check-double me-1"></i>Aprovar selecionados
                </button>
                <button id="btn-reprovar-selecionados-aprovacoes" class="btn btn-reject btn-sm" type="button" onclick="executarAprovacaoLote('desaprovar')" disabled>
                  <i class="fas fa-ban me-1"></i>Reprovar selecionados
                </button>
              </div>
            </div>

            <section class="approval-section">
              <div class="approval-section-head">
                <div>
                  <p class="approval-section-kicker">Fila principal</p>
                  <h6><i class="fas fa-hourglass-half me-2"></i>Encontristas pendentes de aprovação</h6>
                </div>
                <span class="tab-chip tab-chip-pending">Pendentes: <%= encontristasPendentesAprovacoes.length %></span>
              </div>
            <div class="table-wrap approval-table-wrap">
              <table class="table table-hover">
                <thead>
                  <tr>
                    <th class="checkbox-col"><input type="checkbox" data-approval-master-type="encontrista" onchange="toggleSelecionarTodosAprovacoesPorTipo(this, 'encontrista')" title="Selecionar todos os encontristas visíveis"></th>
                    <th>Foto</th>
                    <th>Nome</th>
                    <th>EJC</th>
                    <th>Telefone</th>
                    <th>Email</th>
                    <th>Ações</th>
                  </tr>
                </thead>
                <tbody>
                  <% if (encontristasPendentesAprovacoes.length === 0) { %>
                    <tr><td colspan="7" class="empty-state">Todos os encontristas estão aprovados!</td></tr>
                  <% } else { %>
                    <% encontristasPendentesAprovacoes.forEach(function(cadastro) { %>
                      <tr data-searchable="true">
                        <td class="checkbox-col">
                          <input class="approval-batch-check" type="checkbox" value="<%= cadastro._id %>" data-approval-batch-type="encontrista" onchange="atualizarAprovacaoLoteUI()">
                        </td>
                        <td>
                          <% if (cadastro.foto) { %>
                            <img src="/img/uploads/<%= encodeURIComponent(cadastro.foto) %>?w=120&h=120&fit=cover&format=webp" loading="lazy" decoding="async" alt="Foto" class="table-photo">
                          <% } else { %>
                            <i class="fas fa-user-circle fa-2x text-secondary"></i>
                          <% } %>
                        </td>
                        <td><%= cadastro.nomeCompleto %></td>
                        <td><%= cadastro.ejc %></td>
                        <td><%= cadastro.telefone %></td>
                        <td><%= cadastro.email %></td>
                        <td class="approval-actions-cell">
                          <button class="btn btn-edit btn-sm" onclick="editarCadastro('encontrista', '<%= cadastro._id %>')">
                            <i class="fas fa-id-card me-1"></i>Perfil
                          </button>
                          <button class="btn btn-approve btn-sm" onclick="aprovarCadastro('encontrista', '<%= cadastro._id %>')">
                            <i class="fas fa-check me-1"></i>Aprovar
                          </button>
                          <button class="btn btn-reject btn-sm" onclick="reprovarCadastro('encontrista', '<%= cadastro._id %>')">
                            <i class="fas fa-times me-1"></i>Reprovar
                          </button>
                        </td>
                      </tr>
                    <% }); %>
                  <% } %>
                </tbody>
              </table>
            </div>
            </section>

            <section class="approval-section">
              <div class="approval-section-head">
                <div>
                  <p class="approval-section-kicker">Fila de serviço</p>
                  <h6><i class="fas fa-hourglass-half me-2"></i>Encontreiros pendentes de aprovação</h6>
                </div>
                <span class="tab-chip tab-chip-soft">Pendentes: <%= encontreirosPendentesAprovacoes.length %></span>
              </div>
            <div class="table-wrap approval-table-wrap">
              <table class="table table-hover">
                <thead>
                  <tr>
                    <th class="checkbox-col"><input type="checkbox" data-approval-master-type="encontreiro" onchange="toggleSelecionarTodosAprovacoesPorTipo(this, 'encontreiro')" title="Selecionar todos os encontreiros visíveis"></th>
                    <th>Foto</th>
                    <th>Nome</th>
                    <th>Tipo</th>
                    <th>EJC</th>
                    <th>Telefone</th>
                    <th>Email</th>
                    <th>Ações</th>
                  </tr>
                </thead>
                <tbody>
                  <% if (encontreirosPendentesAprovacoes.length === 0) { %>
                    <tr><td colspan="8" class="empty-state">Todos os encontreiros estão aprovados!</td></tr>
                  <% } else { %>
                    <% encontreirosPendentesAprovacoes.forEach(function(cadastro) { %>
                      <tr data-searchable="true">
                        <td class="checkbox-col">
                          <input class="approval-batch-check" type="checkbox" value="<%= cadastro._id %>" data-approval-batch-type="encontreiro" onchange="atualizarAprovacaoLoteUI()">
                        </td>
                        <td>
                          <% if (cadastro.foto) { %>
                            <img src="/img/uploads/<%= encodeURIComponent(cadastro.foto) %>?w=120&h=120&fit=cover&format=webp" loading="lazy" decoding="async" alt="Foto" class="table-photo">
                          <% } else { %>
                            <i class="fas fa-user-circle fa-2x text-secondary"></i>
                          <% } %>
                        </td>
                        <td><%= cadastro.nomeCompleto %></td>
                        <td>
                          <% if (cadastro.tipo !== 'tios') { %>
                            <i class="fas fa-users text-primary"></i> Jovens
                          <% } else { %>
                            <i class="fas fa-heart text-danger"></i> Tios <%= cadastro.tiosCategoria === 'casal' ? '(Casal)' : '(Solo)' %>
                          <% } %>
                        </td>
                        <td><%= cadastro.ejc %></td>
                        <td><%= cadastro.telefone %></td>
                        <td><%= cadastro.email %></td>
                        <td class="approval-actions-cell">
                          <button class="btn btn-edit btn-sm" onclick="editarCadastro('encontreiro', '<%= cadastro._id %>')">
                            <i class="fas fa-id-card me-1"></i>Perfil
                          </button>
                          <button class="btn btn-approve btn-sm" onclick="aprovarCadastro('encontreiro', '<%= cadastro._id %>')">
                            <i class="fas fa-check me-1"></i>Aprovar
                          </button>
                          <button class="btn btn-reject btn-sm" onclick="reprovarCadastro('encontreiro', '<%= cadastro._id %>')">
                            <i class="fas fa-times me-1"></i>Reprovar
                          </button>
                        </td>
                      </tr>
                    <% }); %>
                  <% } %>
                </tbody>
              </table>
            </div>
            </section>
          </div>

          <!-- TAB: ENCONTROS -->
          <div class="tab-pane fade" id="encontros" data-required-permission="encontros.gerenciar" role="tabpanel">
            <div class="tab-workspace-head">
              <div>
                <p class="tab-kicker">Area Encontros</p>
                <h5><i class="fas fa-calendar-days me-2"></i>Gestao de Encontros</h5>
              </div>
              <div class="tab-head-chips">
                <span class="tab-chip">EJCs: <%= (ejcs || []).length %></span>
                <span class="tab-chip tab-chip-soft">Acesso e criacao rapidos</span>
              </div>
            </div>
            <div class="admin-form-card ejc-selector-card">
              <h5 class="mb-3"><i class="fas fa-location-arrow me-2"></i>Selecionar EJC</h5>
              <div class="row g-3 ejc-row">
                <div class="col-lg-9 col-md-8">
                  <label for="seletor_ejc_pagina" class="form-label">EJC disponível</label>
                  <div class="ejc-selector-shell">
                    <span class="ejc-selector-dot" aria-hidden="true"></span>
                    <select id="seletor_ejc_pagina" class="form-select ejc-selector-input">
                      <option value="">Selecione um EJC</option>
                      <% (ejcs || []).forEach(function(item) { %>
                        <option value="<%= item._id %>" <%= item.ativo ? 'selected' : '' %>><%= item.nome %><%= item.ativo ? ' (Ativo)' : '' %></option>
                      <% }); %>
                    </select>
                  </div>
                </div>
                <div class="col-lg-3 col-md-4 d-flex align-items-end ejc-action-col">
                  <button type="button" class="btn btn-primary w-100 btn-ejc-action" onclick="abrirPaginaEjc()">
                    <i class="fas fa-arrow-right me-1"></i>Acessar EJC
                  </button>
                </div>
              </div>
            </div>

            <div class="admin-form-card">
              <h5 class="mb-3"><i class="fas fa-plus-circle me-2"></i>Criar EJC</h5>
              <form id="formEjc" class="row g-3 ejc-row">
                <div class="col-lg-9 col-md-8">
                  <label for="ejc_nome" class="form-label">Nome do EJC *</label>
                  <input type="text" id="ejc_nome" class="form-control" placeholder="Ex: EJC São José" required>
                </div>
                <div class="col-lg-3 col-md-4 d-flex align-items-end ejc-action-col">
                  <button type="button" class="btn btn-primary w-100 btn-ejc-action" onclick="criarEjc()">
                    <i class="fas fa-save me-1"></i>Criar
                  </button>
                </div>
              </form>
            </div>

            <div class="admin-form-card mb-3">
              <div class="d-flex flex-wrap align-items-center justify-content-between gap-2">
                <h5 class="mb-0"><i class="fas fa-bullseye me-2"></i>Encontro Ativo</h5>
                <% if (encontroAtivoNome) { %>
                  <span class="status-badge status-ok"><%= encontroAtivoNome %></span>
                <% } else { %>
                  <span class="status-badge">Nenhum encontro ativo definido</span>
                <% } %>
              </div>
              <p class="text-muted mb-0 mt-2">Novas inscricoes sao vinculadas automaticamente ao encontro ativo.</p>
            </div>

            <div class="table-wrap mb-3">
              <table class="table table-hover">
                <thead>
                  <tr>
                    <th>Nome do EJC</th>
                    <th>Status</th>
                    <th>Data de Criação</th>
                    <th>Ações</th>
                  </tr>
                </thead>
                <tbody>
                  <% if (!ejcs || ejcs.length === 0) { %>
                    <tr><td colspan="4" class="empty-state">Nenhum EJC cadastrado.</td></tr>
                  <% } else { %>
                    <% ejcs.forEach(function(item) { %>
                      <tr>
                        <td><strong><%= item.nome %></strong></td>
                        <td>
                          <% if (item.ativo) { %>
                            <span class="status-badge status-ok has-led"><span class="status-led-dot is-active" aria-hidden="true"></span>Ativo</span>
                          <% } else { %>
                            <span class="status-badge has-led"><span class="status-led-dot is-inactive" aria-hidden="true"></span>Inativo</span>
                          <% } %>
                        </td>
                        <td><%= new Date(item.dataCriacao).toLocaleDateString('pt-BR') %></td>
                        <td>
                          <button class="btn btn-edit btn-ejc-state <%= item.ativo ? 'is-active' : 'is-inactive' %>" onclick="definirEjcAtivo('<%= item._id %>', '<%= item.nome.replace(/'/g, "\\'") %>')" <%= item.ativo ? 'disabled' : '' %>>
                            <span class="ejc-led-dot" aria-hidden="true"></span>
                            <%= item.ativo ? 'Encontro ativo' : 'Definir como ativo' %>
                          </button>
                          <button class="btn btn-delete" onclick="deletarEjc('<%= item._id %>', '<%= item.nome.replace(/'/g, "\\'") %>')">
                            <i class="fas fa-trash me-1"></i>Excluir Encontro
                          </button>
                        </td>
                      </tr>
                    <% }); %>
                  <% } %>
                </tbody>
              </table>
            </div>
          </div>

          <!-- TAB: SUB-EQUIPES -->
          <div class="tab-pane fade" id="subequipes" data-required-permission="equipes.gerenciar" role="tabpanel">
            <div class="tab-workspace-head">
              <div>
                <p class="tab-kicker">Gestao Estrutural</p>
                <h5><i class="fas fa-diagram-project me-2"></i>Gestao de Sub-Equipes</h5>
              </div>
              <div class="tab-head-chips">
                <span class="tab-chip">Sub-Equipes: <%= (subequipes || []).length %></span>
                <span class="tab-chip tab-chip-soft">Operacao por vigencia</span>
              </div>
            </div>

            <div class="row g-3 mb-3">
              <div class="col-lg-6">
                <div class="admin-form-card h-100 subequipe-feature-card">
                  <div class="subequipe-feature-head">
                    <h5 class="mb-2"><i class="fas fa-plus-circle me-2"></i>Nova Sub-Equipe</h5>
                    <p class="subequipe-feature-subtitle">Estruture frentes de servico por ano de vigencia com rastreabilidade.</p>
                  </div>
                  <form id="formSubequipe" class="row g-3 subequipe-feature-form">
                    <div class="col-12">
                      <label class="form-label">Nome da Sub-Equipe *</label>
                      <input type="text" id="subequipe_nome" class="form-control" placeholder="Ex: Acolhida Porta 2" required>
                    </div>
                    <div class="col-12">
                      <label class="form-label">Ano de vigência *</label>
                      <input type="number" id="subequipe_ano" class="form-control" min="2000" max="2100" step="1" value="<%= new Date().getFullYear() %>" required>
                    </div>
                    <div class="col-12">
                      <button type="button" class="btn btn-primary w-100 admin-primary-action subequipe-feature-action" onclick="cadastrarSubequipe()">
                        <i class="fas fa-save me-1"></i>Salvar Sub-Equipe
                      </button>
                    </div>
                  </form>
                </div>
              </div>

              <div class="col-lg-6">
                <div class="admin-form-card h-100 subequipe-feature-card subequipe-feature-card-link">
                  <div class="subequipe-feature-head">
                    <h5 class="mb-2"><i class="fas fa-link me-2"></i>Vincular Encontreiro/Tio</h5>
                    <p class="subequipe-feature-subtitle">Registre o vinculo diretamente no cadastro da pessoa para auditoria.</p>
                  </div>
                  <form id="formVinculoSubequipe" class="row g-3 subequipe-feature-form">
                    <div class="col-12">
                      <label class="form-label">Pessoa vinculada *</label>
                      <select id="vinculo_subequipe_pessoa" class="form-select">
                        <option value="">Selecione uma pessoa</option>
                        <% (encontreiros || []).forEach(function(item) { %>
                          <option value="<%= item._id %>"><%= item.nomeCompleto %> - <%= item.tipo === 'tios' ? 'Tio/Tia' : 'Jovem' %></option>
                        <% }); %>
                      </select>
                    </div>
                    <div class="col-12">
                      <label class="form-label">Sub-equipe destino *</label>
                      <select id="vinculo_subequipe" class="form-select">
                        <option value="">Selecione a sub-equipe</option>
                        <% (subequipes || []).forEach(function(item) { %>
                          <option value="<%= item._id %>"><%= item.nome %> (<%= item.anoVigencia || '-' %>)</option>
                        <% }); %>
                      </select>
                    </div>
                    <div class="col-12">
                      <label class="form-label">Papel no vinculo *</label>
                      <select id="vinculo_subequipe_papel" class="form-select">
                        <option value="coordenador" selected>Coordenador(a)</option>
                      </select>
                    </div>
                    <div class="col-12">
                      <button type="button" class="btn btn-primary w-100 admin-primary-action subequipe-feature-action" onclick="vincularEncontreiroSubequipe()">
                        <i class="fas fa-user-plus me-1"></i>Salvar Vinculo
                      </button>
                    </div>
                  </form>
                </div>
              </div>
            </div>

            <div class="admin-form-card mb-3">
              <div class="row g-3 align-items-end">
                <div class="col-lg-6">
                  <label class="form-label">Consulta de pessoas por sub-equipe</label>
                  <select id="visualizar_subequipe" class="form-select" onchange="renderVinculadosSubequipe()">
                    <option value="">Selecione uma sub-equipe</option>
                    <% (subequipes || []).forEach(function(item) { %>
                      <option value="<%= item._id %>"><%= item.nome %> (<%= item.anoVigencia || '-' %>)</option>
                    <% }); %>
                  </select>
                </div>
              </div>

              <div class="table-wrap mt-3">
                <table class="table table-hover" id="tabela-vinculados-subequipe">
                  <thead>
                    <tr>
                      <th>Nome</th>
                      <th>Tipo</th>
                      <th>Ano Vigência</th>
                      <th>Coordenador</th>
                    </tr>
                  </thead>
                  <tbody>
                    <tr><td colspan="4" class="empty-state">Selecione uma sub-equipe para visualizar os vinculados.</td></tr>
                  </tbody>
                </table>
              </div>
            </div>

            <div class="table-wrap">
              <table class="table table-hover">
                <thead>
                  <tr>
                    <th>Nome</th>
                    <th>Ano Vigência</th>
                    <th>Nome de referência</th>
                    <th>Data de criação</th>
                    <th>Ações</th>
                  </tr>
                </thead>
                <tbody>
                  <% if (!subequipes || subequipes.length === 0) { %>
                    <tr><td colspan="5" class="empty-state">Nenhuma sub-equipe cadastrada.</td></tr>
                  <% } else { %>
                    <% subequipes.forEach(function(item) { %>
                      <tr>
                        <td><strong><%= item.nome %></strong></td>
                        <td><%= item.anoVigencia || '-' %></td>
                        <td><%= item.nomeReferencia || item.nome %></td>
                        <td><%= item.dataCriacao ? new Date(item.dataCriacao).toLocaleDateString('pt-BR') : '-' %></td>
                        <td>
                          <button class="btn btn-edit" onclick="editarSubequipe('<%= item._id %>', '<%= (item.nome || '').replace(/'/g, "\\'") %>', '<%= item.anoVigencia || '' %>')">
                            <i class="fas fa-edit me-1"></i>Editar
                          </button>
                          <button class="btn btn-delete" onclick="deletarSubequipe('<%= item._id %>', '<%= (item.nomeReferencia || item.nome || '').replace(/'/g, "\\'") %>')">
                            <i class="fas fa-trash me-1"></i>Deletar
                          </button>
                        </td>
                      </tr>
                    <% }); %>
                  <% } %>
                </tbody>
              </table>
            </div>
          </div>

          <!-- TAB: GASTOS -->
          <div class="tab-pane fade gastos-workspace" id="gastos" data-required-permission="gastos.gerenciar" role="tabpanel">
            <div class="tab-workspace-head gastos-head">
              <div class="gastos-head-main">
                <p class="tab-kicker">Área Financeira</p>
                <h5><i class="fas fa-wallet me-2"></i>Financeiro</h5>
                <p class="gastos-head-subtitle">Gestão financeira com leitura executiva, registro assistido e saldo sempre em evidência.</p>
              </div>
              <div class="tab-head-chips tab-head-chips-premium">
                <span class="tab-chip">Lançamentos: <%= gastosResumoData.quantidade %></span>
                <span class="tab-chip tab-chip-soft">Total: <%= Number(gastosResumoData.total || 0).toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' }) %></span>
                <span class="tab-chip tab-chip-premium"><i class="fas fa-shield-heart me-1"></i>UX premium</span>
              </div>
            </div>

            <div class="financeiro-command-center" aria-label="Resumo executivo do financeiro">
              <div class="financeiro-command-primary">
                <div>
                  <p class="financeiro-command-kicker">Command center</p>
                  <h6>Panorama executivo do caixa</h6>
                  <p>Monitore a saúde financeira do encontro com foco em saldo, entradas, saídas e equilíbrio entre encontro e equipes.</p>
                </div>
                <span class="financeiro-command-status <%= Number(fluxoResumoData.saldo || 0) >= 0 ? 'is-positive' : 'is-negative' %>">
                  <i class="fas <%= Number(fluxoResumoData.saldo || 0) >= 0 ? 'fa-circle-check' : 'fa-triangle-exclamation' %>"></i>
                  <%= Number(fluxoResumoData.saldo || 0) >= 0 ? 'Caixa saudável' : 'Atenção ao saldo' %>
                </span>
              </div>
              <div class="financeiro-command-metrics">
                <article class="financeiro-command-card accent-balance">
                  <span>Saldo atual</span>
                  <strong><%= Number(fluxoResumoData.saldo || 0).toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' }) %></strong>
                  <small>Disponível para operação</small>
                </article>
                <article class="financeiro-command-card accent-entry">
                  <span>Entradas do mês</span>
                  <strong><%= Number(fluxoMensalResumoData.entradasMes || 0).toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' }) %></strong>
                  <small>Receitas e repasses confirmados</small>
                </article>
                <article class="financeiro-command-card accent-exit">
                  <span>Saídas do mês</span>
                  <strong><%= Number(fluxoMensalResumoData.saidasMes || 0).toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' }) %></strong>
                  <small>Pagamentos e despesas lançadas</small>
                </article>
                <article class="financeiro-command-card accent-split">
                  <span>Distribuição</span>
                  <strong><%= percentualGastosEncontro %>% / <%= percentualGastosEquipes %>%</strong>
                  <small>Encontro x equipes</small>
                </article>
              </div>
            </div>

            <div class="financeiro-overview-strip" aria-label="Destaques do painel financeiro">
              <article class="financeiro-overview-card">
                <span class="financeiro-overview-label">Visão central</span>
                <strong>Tesouraria em um só painel</strong>
                <small>Entradas, saídas e histórico com leitura imediata para a coordenação.</small>
              </article>
              <article class="financeiro-overview-card">
                <span class="financeiro-overview-label">Controle confiável</span>
                <strong>Rastreabilidade por responsável</strong>
                <small>Cada lançamento fica classificado, contextualizado e pronto para auditoria.</small>
              </article>
              <article class="financeiro-overview-card">
                <span class="financeiro-overview-label">Decisão rápida</span>
                <strong>Filtros e KPIs prontos</strong>
                <small>Encontre categorias, equipes e períodos em poucos segundos.</small>
              </article>
            </div>

            <div class="gastos-toolbar" aria-label="Filtros do painel financeiro">
              <div class="gastos-toolbar-group">
                <label for="gastos_periodo_filtro" class="form-label">Período</label>
                <select id="gastos_periodo_filtro" class="form-select">
                  <option value="todos">Todo o período</option>
                  <option value="hoje">Hoje</option>
                  <option value="7dias">Últimos 7 dias</option>
                  <option value="30dias">Últimos 30 dias</option>
                  <option value="mes_atual" selected>Mês atual</option>
                  <option value="trimestre">Último trimestre</option>
                </select>
              </div>
              <div class="gastos-toolbar-group">
                <label for="gastos_categoria_filtro" class="form-label">Categoria</label>
                <select id="gastos_categoria_filtro" class="form-select">
                  <option value="">Todas as categorias</option>
                  <% gastoCategoryOptionsList.forEach(function(categoria) { %>
                    <option value="<%= categoria %>"><%= categoria %></option>
                  <% }); %>
                </select>
              </div>
              <div class="gastos-toolbar-group">
                <label for="gastos_escopo_filtro" class="form-label">Escopo</label>
                <select id="gastos_escopo_filtro" class="form-select">
                  <option value="">Todos</option>
                  <option value="encontro">Somente encontro</option>
                  <option value="equipe">Somente equipes</option>
                </select>
              </div>
              <div class="gastos-toolbar-group gastos-toolbar-group-search">
                <label for="gastos_busca_filtro" class="form-label">Buscar</label>
                <input type="text" id="gastos_busca_filtro" class="form-control" placeholder="Descrição, responsável ou equipe">
              </div>
              <div class="gastos-toolbar-actions">
                <button type="button" class="btn btn-outline-light gastos-filter-btn" onclick="limparFiltrosGastos()">
                  <i class="fas fa-filter-circle-xmark me-1"></i>Limpar filtros
                </button>
              </div>
            </div>
            <div class="financeiro-toolbar-note" role="note">
              <i class="fas fa-circle-info"></i>
              <span>Combine período, categoria e busca para localizar qualquer movimentação em segundos e conciliar o caixa com mais segurança.</span>
            </div>

            <div class="row g-3 mb-3">
              <div class="col-xl-7">
                <div class="admin-form-card h-100 gastos-form-card">
                  <div class="gastos-card-hero">
                    <div>
                      <p class="gastos-card-kicker">Lançamento assistido</p>
                      <h5 class="mb-1"><i class="fas fa-coins me-2"></i>Registrar lançamentos com clareza</h5>
                      <p class="gastos-card-subtitle">Centralize arrecadações, vendas, doações e despesas em um fluxo mais elegante, confiável e fácil de acompanhar.</p>
                    </div>
                    <div class="gastos-card-pills">
                      <span class="gastos-card-pill"><i class="fas fa-arrow-trend-up"></i>Entradas + saídas</span>
                      <span class="gastos-card-pill"><i class="fas fa-shield-heart"></i>Controle seguro</span>
                    </div>
                  </div>

                  <form id="formGasto" class="row g-3 gastos-form">
                    <div class="col-12">
                      <div class="gastos-form-block">
                        <div class="gastos-block-heading">
                          <span class="gastos-block-step">01</span>
                          <div>
                            <strong>Contexto do lançamento</strong>
                            <small>Defina se o lançamento é entrada ou gasto e onde será contabilizado.</small>
                          </div>
                        </div>
                        <div class="row g-3">
                          <div class="col-md-4">
                            <label for="gasto_ejcId" class="form-label">EJC *</label>
                            <select id="gasto_ejcId" class="form-select" onchange="atualizarCamposGasto()">
                              <option value="">Selecione o EJC</option>
                              <% (ejcs || []).forEach(function(item) { %>
                                <option value="<%= item._id %>" <%= item.ativo ? 'selected' : '' %>><%= item.nome %><%= item.ativo ? ' (Ativo)' : '' %></option>
                              <% }); %>
                            </select>
                          </div>
                          <div class="col-md-4">
                            <label for="gasto_tipoLancamento" class="form-label">Tipo do lançamento *</label>
                            <select id="gasto_tipoLancamento" class="form-select" onchange="atualizarCamposGasto()">
                              <option value="arrecadacao" selected>Entrada de capital (arrecadação)</option>
                              <option value="venda_equipe">Venda de equipe</option>
                              <option value="doacao">Doação</option>
                              <option value="patrocinio">Patrocínio</option>
                              <option value="inscricao">Repasse de inscrição</option>
                              <option value="gasto_encontro">Gasto do encontro</option>
                              <option value="gasto_equipe">Gasto de equipe</option>
                            </select>
                          </div>
                          <div class="col-md-4">
                            <label for="gasto_escopoTipo" class="form-label">Escopo *</label>
                            <select id="gasto_escopoTipo" class="form-select" onchange="atualizarCamposGasto()">
                              <option value="encontro" selected>Encontro geral</option>
                              <option value="equipe">Equipe</option>
                            </select>
                          </div>
                          <div class="col-md-6" id="gasto_equipe_wrap" style="display:none;">
                            <label for="gasto_equipeId" class="form-label">Equipe vinculada *</label>
                            <select id="gasto_equipeId" class="form-select">
                              <option value="">Selecione a equipe</option>
                            </select>
                          </div>
                          <div class="col-md-6">
                            <label for="gasto_categoria" class="form-label">Categoria</label>
                            <select id="gasto_categoria" class="form-select">
                              <% gastoCategoryOptionsList.forEach(function(categoria) { %>
                                <option value="<%= categoria %>"><%= categoria %></option>
                              <% }); %>
                            </select>
                          </div>
                          <div class="col-12">
                            <p id="gasto_scope_hint" class="gastos-field-hint mb-0">Este lançamento será registrado como gasto geral do encontro e também refletido no fluxo de caixa.</p>
                          </div>
                        </div>
                      </div>
                    </div>

                    <div class="col-12">
                      <div class="gastos-form-block">
                        <div class="gastos-block-heading">
                          <span class="gastos-block-step">02</span>
                          <div>
                            <strong>Detalhes financeiros</strong>
                            <small>Descreva o lançamento com clareza.</small>
                          </div>
                        </div>
                        <div class="row g-3">
                          <div class="col-md-8">
                            <label for="gasto_descricao" class="form-label">Descrição *</label>
                            <input type="text" id="gasto_descricao" class="form-control" placeholder="Ex: compra de mercado, decoração, impressão" required>
                          </div>
                          <div class="col-md-4">
                            <label for="gasto_valor" class="form-label">Valor *</label>
                            <input type="text" id="gasto_valor" class="form-control" placeholder="Ex: 150,00" inputmode="decimal" required>
                          </div>
                          <div class="col-md-4">
                            <label for="gasto_data" id="gasto_data_label" class="form-label">Data do gasto *</label>
                            <input type="date" id="gasto_data" class="form-control" value="<%= new Date().toISOString().slice(0, 10) %>" required>
                          </div>
                          <div class="col-md-4">
                            <label for="gasto_responsavel" id="gasto_responsavel_label" class="form-label">Responsável</label>
                            <input type="text" id="gasto_responsavel" class="form-control" placeholder="Quem pagou ou lançou">
                          </div>
                          <div class="col-md-4">
                            <label for="gasto_forma_pagamento" id="gasto_forma_pagamento_label" class="form-label">Forma de pagamento</label>
                            <input type="text" id="gasto_forma_pagamento" class="form-control" placeholder="Pix, Dinheiro, Cartão...">
                          </div>
                        </div>
                      </div>
                    </div>

                    <div class="col-12">
                      <div class="gastos-form-block">
                        <div class="gastos-block-heading">
                          <span class="gastos-block-step">03</span>
                          <div>
                            <strong>Observações e conferência</strong>
                            <small>Inclua detalhes adicionais, se necessário.</small>
                          </div>
                        </div>
                        <div class="row g-3">
                          <div class="col-12">
                            <label for="gasto_observacoes" class="form-label">Observações</label>
                            <textarea id="gasto_observacoes" class="form-control" rows="2" placeholder="Detalhes extras do gasto"></textarea>
                          </div>
                          <div class="col-12">
                            <button type="button" id="gasto_submit_btn" class="btn btn-primary w-100 admin-primary-action gastos-submit-btn" onclick="cadastrarGasto()">
                              <i class="fas fa-save me-1"></i>Registrar lançamento com segurança
                            </button>
                            <div class="gastos-assurance-strip" role="note">
                              <span><i class="fas fa-shield-heart"></i>Rastreabilidade completa</span>
                              <span><i class="fas fa-bolt"></i>Resumo atualizado na hora</span>
                              <span><i class="fas fa-eye"></i>Leitura clara para tesouraria</span>
                            </div>
                          </div>
                        </div>
                      </div>
                    </div>
                  </form>
                </div>
              </div>

              <div class="col-xl-5">
                <div class="admin-form-card h-100 gastos-summary-card">
                  <div class="gastos-summary-head">
                    <div>
                      <p class="gastos-card-kicker">Visão executiva</p>
                      <h5 class="mb-1"><i class="fas fa-chart-pie me-2"></i>Resumo executivo</h5>
                      <p class="gastos-card-subtitle">Visualize volume, distribuição e indicadores do financeiro com leitura rápida e profissional.</p>
                    </div>
                    <span class="gastos-summary-badge">Tempo real</span>
                  </div>
                  <div class="financeiro-summary-spotlight">
                    <div>
                      <span class="financeiro-summary-spotlight-label">Leitura prioritária</span>
                      <strong><%= Number(fluxoResumoData.saldo || 0) >= 0 ? 'O caixa opera com saldo positivo e boa previsibilidade.' : 'O caixa precisa de atenção imediata para reequilíbrio.' %></strong>
                    </div>
                    <small>Use os KPIs abaixo para decidir rapidamente onde conter despesas ou reforçar arrecadação.</small>
                  </div>
                  <div class="gastos-kpi-grid">
                    <article class="gastos-kpi-card gastos-kpi-card-primary">
                      <span class="gastos-kpi-label">Total geral</span>
                      <strong id="gastos_total_geral_card" class="gastos-kpi-value"><%= Number(gastosResumoData.total || 0).toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' }) %></strong>
                      <small class="gastos-kpi-meta">Todos os lançamentos registrados</small>
                    </article>
                    <article class="gastos-kpi-card gastos-kpi-card-success">
                      <span class="gastos-kpi-label">Encontro</span>
                      <strong id="gastos_total_encontro_card" class="gastos-kpi-value"><%= Number(gastosResumoData.encontro || 0).toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' }) %></strong>
                      <small class="gastos-kpi-meta">Despesas gerais do encontro</small>
                    </article>
                    <article class="gastos-kpi-card gastos-kpi-card-warning">
                      <span class="gastos-kpi-label">Equipes</span>
                      <strong id="gastos_total_equipes_card" class="gastos-kpi-value"><%= Number(gastosResumoData.equipes || 0).toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' }) %></strong>
                      <small class="gastos-kpi-meta">Lançamentos específicos das equipes</small>
                    </article>
                    <article class="gastos-kpi-card gastos-kpi-card-danger">
                      <span class="gastos-kpi-label">Registros</span>
                      <strong id="gastos_total_registros_card" class="gastos-kpi-value"><%= gastosResumoData.quantidade %></strong>
                      <small class="gastos-kpi-meta">Controle financeiro consolidado</small>
                    </article>
                  </div>

                  <div class="gastos-insights-grid">
                    <article class="gastos-insight-card">
                      <span class="gastos-insight-label">No mês atual</span>
                      <strong id="gastos_mes_atual_valor"><%= Number(totalGastosMesAtual || 0).toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' }) %></strong>
                      <small>Soma dos lançamentos do mês selecionado</small>
                    </article>
                    <article class="gastos-insight-card">
                      <span class="gastos-insight-label">Maior gasto do mês</span>
                      <strong id="gastos_maior_mes_valor"><%= Number((maiorGastoMesAtual && maiorGastoMesAtual.valor) || 0).toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' }) %></strong>
                      <small id="gastos_maior_mes_desc"><%= (maiorGastoMesAtual && maiorGastoMesAtual.descricao) || 'Sem lançamento no período' %></small>
                    </article>
                    <article class="gastos-insight-card">
                      <span class="gastos-insight-label">Ticket médio</span>
                      <strong id="gastos_ticket_medio_valor"><%= Number(gastoMedioGeral || 0).toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' }) %></strong>
                      <small>Média por lançamento filtrado</small>
                    </article>
                  </div>

                  <div class="gastos-distribution-card">
                    <div class="gastos-distribution-head">
                      <strong>Distribuição encontro vs equipes</strong>
                      <span id="gastos_distrib_total_texto"><%= percentualGastosEncontro %>% / <%= percentualGastosEquipes %>%</span>
                    </div>
                    <div class="gastos-distribution-bar">
                      <span id="gastos_bar_encontro" class="gastos-bar-encontro" style="width: <%= percentualGastosEncontro %>%;"></span>
                      <span id="gastos_bar_equipes" class="gastos-bar-equipes" style="width: <%= percentualGastosEquipes %>%;"></span>
                    </div>
                    <div class="gastos-distribution-legend">
                      <span><i class="fas fa-circle"></i>Encontro: <strong id="gastos_legenda_encontro"><%= Number(gastosResumoData.encontro || 0).toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' }) %></strong></span>
                      <span><i class="fas fa-circle"></i>Equipes: <strong id="gastos_legenda_equipes"><%= Number(gastosResumoData.equipes || 0).toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' }) %></strong></span>
                    </div>
                  </div>

                  <div class="alert alert-info mt-3 mb-0 gastos-hint" role="alert">
                    <i class="fas fa-circle-info me-2"></i>Use esta área para registrar arrecadações, vendas das equipes, doações e também os gastos gerais do encontro.
                  </div>
                </div>
              </div>
            </div>

            <div class="gastos-table-shell financeiro-collapsible-shell is-collapsed" data-collapsible-panel>
              <button type="button" class="gastos-table-head gastos-table-toggle" aria-expanded="false" aria-controls="gastos_livro_lancamentos_panel" onclick="toggleFinanceiroPanel(this)">
                <div>
                  <h5 class="mb-1"><i class="fas fa-receipt me-2"></i>Livro de lançamentos</h5>
                  <p class="mb-0">Clique para visualizar os lançamentos com contexto, responsáveis e classificação.</p>
                </div>
                <div class="gastos-table-head-actions">
                  <span id="gastos_table_count_badge" class="gastos-table-badge"><%= gastosResumoData.quantidade %> registro(s)</span>
                  <span class="gastos-collapse-icon" aria-hidden="true"><i class="fas fa-chevron-down"></i></span>
                </div>
              </button>
              <div id="gastos_livro_lancamentos_panel" class="financeiro-collapsible-body" hidden>
                <div class="table-wrap gastos-table-wrap">
              <table class="table table-hover gastos-table">
                <thead>
                  <tr>
                    <th>Data</th>
                    <th>Descrição</th>
                    <th>Categoria</th>
                    <th>Escopo</th>
                    <th>EJC</th>
                    <th>Valor</th>
                    <th>Responsável</th>
                    <th>Ações</th>
                  </tr>
                </thead>
                <tbody id="gastos-tbody">
                  <% if (!gastos || gastos.length === 0) { %>
                    <tr>
                      <td colspan="8">
                        <div class="gastos-empty-state">
                          <i class="fas fa-wallet"></i>
                          <span>Nenhum gasto cadastrado até o momento.</span>
                        </div>
                      </td>
                    </tr>
                  <% } else { %>
                    <% gastos.forEach(function(item) { %>
                      <tr>
                        <td><%= item.dataGasto ? new Date(item.dataGasto).toLocaleDateString('pt-BR') : '-' %></td>
                        <td>
                          <strong><%= item.descricao || '-' %></strong>
                          <% if (item.observacoes) { %>
                            <div class="text-muted small"><%= item.observacoes %></div>
                          <% } %>
                        </td>
                        <td><%= item.categoria || 'Outros' %></td>
                        <td>
                          <% if (item.escopoTipo === 'equipe') { %>
                            <span class="status-badge status-ok gastos-scope-badge"><%= item.equipeNome || 'Equipe' %></span>
                          <% } else { %>
                            <span class="status-badge gastos-scope-badge">Encontro</span>
                          <% } %>
                        </td>
                        <td><%= item.ejcVinculadoNome || item.ejc || '-' %></td>
                        <td><strong><%= Number(item.valor || 0).toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' }) %></strong></td>
                        <td><%= item.responsavel || '-' %></td>
                        <td>
                          <button class="btn btn-delete" onclick="deletarGasto('<%= item._id %>', '<%= (item.descricao || '').replace(/'/g, "\\'") %>')">
                            <i class="fas fa-trash me-1"></i>Excluir
                          </button>
                        </td>
                      </tr>
                    <% }); %>
                  <% } %>
                </tbody>
              </table>
                </div>
              </div>
            </div>

          <div class="financeiro-subsection">
            <div class="tab-workspace-head gastos-head">
              <div class="gastos-head-main">
                <p class="tab-kicker">Fluxo de Caixa</p>
                <h5><i class="fas fa-scale-balanced me-2"></i>Entradas e saídas</h5>
                <p class="gastos-head-subtitle">Conciliação de entradas e saídas com visão imediata do saldo disponível.</p>
              </div>
              <div class="tab-head-chips tab-head-chips-premium">
                <span class="tab-chip">Movimentos: <%= fluxoResumoData.quantidade || 0 %></span>
                <span class="tab-chip tab-chip-soft">Saldo: <%= Number(fluxoResumoData.saldo || 0).toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' }) %></span>
                <span class="tab-chip tab-chip-premium"><i class="fas fa-bolt me-1"></i>Conciliação</span>
              </div>
            </div>

            <div class="row g-3 mb-3">
              <div class="col-xl-7">
                <div class="admin-form-card h-100 gastos-form-card">
                  <div class="gastos-card-hero">
                    <div>
                      <p class="gastos-card-kicker">Tesouraria</p>
                      <h5 class="mb-1"><i class="fas fa-right-left me-2"></i>Lançar movimentos com rastreabilidade</h5>
                      <p class="gastos-card-subtitle">Mantenha o caixa alinhado com origem, destino e forma de pagamento em um fluxo elegante e objetivo.</p>
                    </div>
                    <div class="gastos-card-pills">
                      <span class="gastos-card-pill"><i class="fas fa-chart-line"></i>Saldo em tempo real</span>
                      <span class="gastos-card-pill"><i class="fas fa-bolt"></i>Conciliação simples</span>
                    </div>
                  </div>

                  <form id="formFluxoCaixa" class="row g-3 gastos-form">
                    <div class="col-md-4">
                      <label for="fluxo_ejcId" class="form-label">EJC *</label>
                      <select id="fluxo_ejcId" class="form-select">
                        <option value="">Selecione o EJC</option>
                        <% (ejcs || []).forEach(function(item) { %>
                          <option value="<%= item._id %>" <%= item.ativo ? 'selected' : '' %>><%= item.nome %><%= item.ativo ? ' (Ativo)' : '' %></option>
                        <% }); %>
                      </select>
                    </div>
                    <div class="col-md-4">
                      <label for="fluxo_tipoMovimento" class="form-label">Tipo *</label>
                      <select id="fluxo_tipoMovimento" class="form-select">
                        <option value="entrada" selected>Entrada</option>
                        <option value="saida">Saída</option>
                      </select>
                    </div>
                    <div class="col-md-4">
                      <label for="fluxo_categoria" class="form-label">Categoria</label>
                      <select id="fluxo_categoria" class="form-select">
                        <% fluxoCategoryOptionsList.forEach(function(categoria) { %>
                          <option value="<%= categoria %>"><%= categoria %></option>
                        <% }); %>
                      </select>
                    </div>
                    <div class="col-md-7">
                      <label for="fluxo_descricao" class="form-label">Descrição *</label>
                      <input type="text" id="fluxo_descricao" class="form-control" placeholder="Ex: repasse de inscrições, pagamento de fornecedor" required>
                    </div>
                    <div class="col-md-2">
                      <label for="fluxo_valor" class="form-label">Valor *</label>
                      <input type="text" id="fluxo_valor" class="form-control" placeholder="0,00" inputmode="decimal" required>
                    </div>
                    <div class="col-md-3">
                      <label for="fluxo_dataMovimento" class="form-label">Data *</label>
                      <input type="date" id="fluxo_dataMovimento" class="form-control" value="<%= new Date().toISOString().slice(0, 10) %>" required>
                    </div>
                    <div class="col-md-4">
                      <label for="fluxo_origemDestino" class="form-label">Origem / Destino</label>
                      <input type="text" id="fluxo_origemDestino" class="form-control" placeholder="Ex: família, fornecedor, equipe">
                    </div>
                    <div class="col-md-4">
                      <label for="fluxo_responsavel" class="form-label">Responsável</label>
                      <input type="text" id="fluxo_responsavel" class="form-control" placeholder="Quem recebeu/pagou">
                    </div>
                    <div class="col-md-4">
                      <label for="fluxo_formaPagamento" class="form-label">Forma</label>
                      <input type="text" id="fluxo_formaPagamento" class="form-control" placeholder="Pix, Dinheiro, Cartão...">
                    </div>
                    <div class="col-12">
                      <label for="fluxo_observacoes" class="form-label">Observações</label>
                      <textarea id="fluxo_observacoes" class="form-control" rows="2" placeholder="Informações complementares"></textarea>
                    </div>
                    <div class="col-12">
                      <button type="button" class="btn btn-primary w-100 admin-primary-action gastos-submit-btn" onclick="cadastrarFluxoCaixa()">
                        <i class="fas fa-plus-circle me-1"></i>Registrar movimento no caixa
                      </button>
                      <div class="gastos-assurance-strip" role="note">
                        <span><i class="fas fa-bolt"></i>Conciliação simples</span>
                        <span><i class="fas fa-chart-line"></i>Saldo em tempo real</span>
                        <span><i class="fas fa-shield-heart"></i>Histórico pronto para auditoria</span>
                      </div>
                    </div>
                  </form>
                </div>
              </div>

              <div class="col-xl-5">
                <div class="admin-form-card h-100 gastos-summary-card">
                  <div class="gastos-summary-head">
                    <div>
                      <p class="gastos-card-kicker">Saldo consolidado</p>
                      <h5 class="mb-1"><i class="fas fa-chart-area me-2"></i>Painel de caixa</h5>
                      <p class="gastos-card-subtitle">Acompanhe a saúde do caixa com indicadores diretos e leitura premium.</p>
                    </div>
                    <span class="gastos-summary-badge">Financeiro</span>
                  </div>
                  <div class="financeiro-summary-spotlight is-cash">
                    <div>
                      <span class="financeiro-summary-spotlight-label">Status do período</span>
                      <strong><%= Number(fluxoResumoData.saldo || 0) >= 0 ? 'Saldo sustentável para a operação atual.' : 'Saídas acima do ideal: revisar prioridades.' %></strong>
                    </div>
                    <small>O painel abaixo mostra entradas, saídas, saldo líquido e volume de movimentos para a conciliação.</small>
                  </div>
                  <div class="gastos-kpi-grid">
                    <article class="gastos-kpi-card gastos-kpi-card-success">
                      <span class="gastos-kpi-label">Entradas</span>
                      <strong id="fluxo_total_entradas_card" class="gastos-kpi-value"><%= Number(fluxoResumoData.entradas || 0).toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' }) %></strong>
                      <small class="gastos-kpi-meta">Total recebido</small>
                    </article>
                    <article class="gastos-kpi-card gastos-kpi-card-danger">
                      <span class="gastos-kpi-label">Saídas</span>
                      <strong id="fluxo_total_saidas_card" class="gastos-kpi-value"><%= Number(fluxoResumoData.saidas || 0).toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' }) %></strong>
                      <small class="gastos-kpi-meta">Total pago</small>
                    </article>
                    <article class="gastos-kpi-card gastos-kpi-card-primary">
                      <span class="gastos-kpi-label">Saldo</span>
                      <strong id="fluxo_saldo_card" class="gastos-kpi-value"><%= Number(fluxoResumoData.saldo || 0).toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' }) %></strong>
                      <small class="gastos-kpi-meta">Entradas - Saídas</small>
                    </article>
                    <article class="gastos-kpi-card gastos-kpi-card-warning">
                      <span class="gastos-kpi-label">Movimentos</span>
                      <strong id="fluxo_quantidade_card" class="gastos-kpi-value"><%= fluxoResumoData.quantidade || 0 %></strong>
                      <small class="gastos-kpi-meta">Lançamentos no livro caixa</small>
                    </article>
                  </div>

                  <div class="financeiro-extrato-card mt-3">
                    <div class="gastos-summary-head gastos-summary-head-secondary">
                      <div>
                        <p class="gastos-card-kicker">Extrato mensal</p>
                        <h6 class="mb-1">Consolidado de <span id="fluxo_mes_referencia_texto"><%= fluxoMensalResumoData.mesReferencia || new Date().toLocaleDateString('pt-BR', { month: 'long', year: 'numeric' }) %></span></h6>
                        <p class="gastos-card-subtitle">Acompanhe o início do mês, tudo que entrou, tudo que saiu e o saldo final projetado.</p>
                      </div>
                    </div>
                    <div class="gastos-insights-grid financeiro-extrato-grid">
                      <article class="gastos-insight-card is-balance">
                        <span class="gastos-insight-label">Saldo inicial</span>
                        <strong id="fluxo_saldo_inicial_mes_card"><%= Number(fluxoMensalResumoData.saldoInicial || 0).toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' }) %></strong>
                        <small>Posição acumulada antes do mês atual</small>
                      </article>
                      <article class="gastos-insight-card is-entry">
                        <span class="gastos-insight-label">Entradas do mês</span>
                        <strong id="fluxo_entradas_mes_card"><%= Number(fluxoMensalResumoData.entradasMes || 0).toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' }) %></strong>
                        <small>Receitas e repasses do período</small>
                      </article>
                      <article class="gastos-insight-card is-exit">
                        <span class="gastos-insight-label">Saídas do mês</span>
                        <strong id="fluxo_saidas_mes_card"><%= Number(fluxoMensalResumoData.saidasMes || 0).toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' }) %></strong>
                        <small>Pagamentos, compras e despesas</small>
                      </article>
                      <article class="gastos-insight-card is-highlight">
                        <span class="gastos-insight-label">Saldo final do mês</span>
                        <strong id="fluxo_saldo_final_mes_card"><%= Number(fluxoMensalResumoData.saldoFinal || 0).toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' }) %></strong>
                        <small>Saldo inicial + entradas - saídas</small>
                      </article>
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <div class="gastos-table-shell financeiro-collapsible-shell is-collapsed" data-collapsible-panel>
              <button type="button" class="gastos-table-head gastos-table-toggle" aria-expanded="false" aria-controls="gastos_livro_caixa_panel" onclick="toggleFinanceiroPanel(this)">
                <div>
                  <h5 class="mb-1"><i class="fas fa-book me-2"></i>Livro caixa</h5>
                  <p class="mb-0">Clique para abrir os registros completos de entrada e saída de valores.</p>
                </div>
                <div class="gastos-table-head-actions">
                  <span id="fluxo_table_count_badge" class="gastos-table-badge"><%= fluxoResumoData.quantidade || 0 %> movimento(s)</span>
                  <span class="gastos-collapse-icon" aria-hidden="true"><i class="fas fa-chevron-down"></i></span>
                </div>
              </button>
              <div id="gastos_livro_caixa_panel" class="financeiro-collapsible-body" hidden>
                <div class="table-wrap gastos-table-wrap">
                <table class="table table-hover gastos-table">
                  <thead>
                    <tr>
                      <th>Data</th>
                      <th>Tipo</th>
                      <th>Descrição</th>
                      <th>Categoria</th>
                      <th>EJC</th>
                      <th>Valor</th>
                      <th>Responsável</th>
                      <th>Ações</th>
                    </tr>
                  </thead>
                  <tbody id="fluxo-caixa-tbody">
                    <% if (!fluxoCaixa || fluxoCaixa.length === 0) { %>
                      <tr>
                        <td colspan="8">
                          <div class="gastos-empty-state">
                            <i class="fas fa-book-open"></i>
                            <span>Nenhum movimento de caixa cadastrado.</span>
                          </div>
                        </td>
                      </tr>
                    <% } else { %>
                      <% fluxoCaixa.forEach(function(item) { %>
                        <tr>
                          <td><%= item.dataMovimento ? new Date(item.dataMovimento).toLocaleDateString('pt-BR') : '-' %></td>
                          <td>
                            <% if (item.tipoMovimento === 'saida') { %>
                              <span class="status-badge status-danger gastos-scope-badge">Saída</span>
                            <% } else { %>
                              <span class="status-badge status-ok gastos-scope-badge">Entrada</span>
                            <% } %>
                          </td>
                          <td>
                            <strong><%= item.descricao || '-' %></strong>
                            <% if (item.origemDestino) { %>
                              <div class="text-muted small">Origem/Destino: <%= item.origemDestino %></div>
                            <% } %>
                            <% if (item.observacoes) { %>
                              <div class="text-muted small"><%= item.observacoes %></div>
                            <% } %>
                          </td>
                          <td><%= item.categoria || 'Outros' %></td>
                          <td><%= item.ejcVinculadoNome || item.ejc || '-' %></td>
                          <td><strong><%= Number(item.valor || 0).toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' }) %></strong></td>
                          <td><%= item.responsavel || '-' %></td>
                          <td>
                            <button class="btn btn-delete" onclick="deletarFluxoCaixa('<%= item._id %>', '<%= (item.descricao || '').replace(/'/g, "\\'") %>')">
                              <i class="fas fa-trash me-1"></i>Excluir
                            </button>
                          </td>
                        </tr>
                      <% }); %>
                    <% } %>
                  </tbody>
                </table>
                </div>
              </div>
            </div>
          </div>

          <!-- TAB: ADMINISTRADORES -->
          <div class="tab-pane fade <%= isAbaAtiva('administradores') ? 'show active admin-pane-persistent' : '' %>" id="administradores" data-required-permission="admins.gerenciar" role="tabpanel">
            <div class="tab-workspace-head">
              <div>
                <p class="tab-kicker">Area Administradores</p>
                <h5><i class="fas fa-user-shield me-2"></i>Gestao de Administradores e Importacao</h5>
              </div>
              <div class="tab-head-chips">
                <span class="tab-chip">Admins: <%= (administradores || []).length %></span>
                <span class="tab-chip tab-chip-soft">Importacao segura</span>
              </div>
            </div>
            <div class="admin-form-card admin-config-card admin-block-card" data-required-permission="bloqueio.gerenciar">
              <div class="admin-card-head">
                <div>
                  <p class="admin-card-kicker">Disponibilidade</p>
                  <h5><i class="fas fa-ban me-2"></i>Controle de Formulários</h5>
                  <p class="admin-card-subtitle">Gerencie bloqueios temporários com período e mensagem exibida ao usuário final.</p>
                </div>
                <span class="admin-card-badge">Bloqueio temporário</span>
              </div>
              <div class="row g-3 admin-block-grid">
                <!-- Controle encontrista -->
                <div class="col-md-6">
                  <div class="card border-light admin-mini-panel admin-mini-panel-encontrista">
                    <div class="card-body">
                      <div class="admin-mini-panel-head">
                        <div>
                          <h6 class="card-title mb-1"><i class="fas fa-user-graduate me-2"></i>Formulário Encontrista</h6>
                          <p class="admin-mini-panel-subtitle">Controle de abertura, período e justificativa para inscrições de encontristas.</p>
                        </div>
                      </div>
                      <div class="form-check form-switch mb-3 admin-switch-row">
                        <input class="form-check-input" type="checkbox" id="bloquear_encontrista" onchange="atualizarCamposEncontrista()">
                        <label class="form-check-label" for="bloquear_encontrista">
                          Bloquear formulário encontrista
                        </label>
                      </div>
                      <div id="campos-encontrista" style="display:none;" class="row g-2 admin-block-fields">
                        <div class="col-12">
                          <label class="form-label">Data/Hora de Início (opcional)</label>
                          <input type="datetime-local" id="data_inicio_encontrista" class="form-control">
                          <small class="text-muted">Deixe em branco para bloquear imediatamente</small>
                        </div>
                        <div class="col-12">
                          <label class="form-label">Data/Hora de Término (opcional)</label>
                          <input type="datetime-local" id="data_fim_encontrista" class="form-control">
                          <small class="text-muted">Deixe em branco para bloqueio indefinido</small>
                        </div>
                        <div class="col-12">
                          <label class="form-label">Motivo (para exibir ao usuário)</label>
                          <textarea id="motivo_encontrista" class="form-control" rows="2" placeholder="Ex: Inscrições encerradas para esta etapa"></textarea>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>

                <!-- Controle encontreiro -->
                <div class="col-md-6">
                  <div class="card border-light admin-mini-panel admin-mini-panel-encontreiros">
                    <div class="card-body">
                      <div class="admin-mini-panel-head">
                        <div>
                          <h6 class="card-title mb-1"><i class="fas fa-users me-2"></i>Formulário Encontreiros</h6>
                          <p class="admin-mini-panel-subtitle">Defina janelas de bloqueio e observações para o formulário de encontreiros.</p>
                        </div>
                      </div>
                      <div class="form-check form-switch mb-3 admin-switch-row">
                        <input class="form-check-input" type="checkbox" id="bloquear_encontreiros" onchange="atualizarCamposEncontreiros()">
                        <label class="form-check-label" for="bloquear_encontreiros">
                          Bloquear formulário encontreiros
                        </label>
                      </div>
                      <div id="campos-encontreiros" style="display:none;" class="row g-2 admin-block-fields">
                        <div class="col-12">
                          <label class="form-label">Data/Hora de Início (opcional)</label>
                          <input type="datetime-local" id="data_inicio_encontreiros" class="form-control">
                          <small class="text-muted">Deixe em branco para bloquear imediatamente</small>
                        </div>
                        <div class="col-12">
                          <label class="form-label">Data/Hora de Término (opcional)</label>
                          <input type="datetime-local" id="data_fim_encontreiros" class="form-control">
                          <small class="text-muted">Deixe em branco para bloqueio indefinido</small>
                        </div>
                        <div class="col-12">
                          <label class="form-label">Motivo (para exibir ao usuário)</label>
                          <textarea id="motivo_encontreiros" class="form-control" rows="2" placeholder="Ex: Inscrições encerradas para esta etapa"></textarea>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>

                <div class="col-12">
                  <button type="button" class="btn btn-primary w-100 admin-primary-action" onclick="salvarConfiguracoesBloqueio()">
                    <i class="fas fa-save me-1"></i>Salvar Configurações de Bloqueio
                  </button>
                </div>
              </div>
              <div id="bloqueio-resultado" class="mt-3"></div>
            </div>

            <div class="admin-form-card admin-config-card admin-import-card" data-required-permission="importacao.executar">
              <div class="admin-card-head" id="import-card-toggle" onclick="toggleImportCard()" style="cursor:pointer;user-select:none;">
                <div>
                  <p class="admin-card-kicker">Integração</p>
                  <h5><i class="fas fa-file-import me-2"></i>Importações</h5>
                  <p class="admin-card-subtitle">Importe encontreiros ou carregue equipes, circulos e encontreiros de um banco externo para um encontro ja criado no sistema.</p>
                </div>
                <div class="d-flex align-items-center gap-2">
                  <span class="admin-card-badge">Importação segura</span>
                  <i class="fas fa-chevron-down" id="import-card-chevron" style="transition:transform .25s;color:var(--admin-text-muted,#6c757d)"></i>
                </div>
              </div>
              <div id="import-card-body" style="display:none;overflow:hidden;">
                <div class="import-ux-strip" aria-label="Etapas da importação">
                  <span class="import-ux-chip"><strong>1</strong>Modo</span>
                  <span class="import-ux-chip"><strong>2</strong>Destino e origem</span>
                  <span class="import-ux-chip"><strong>3</strong>Validação e execução</span>
                </div>
                <div class="import-ux-context" aria-live="polite">
                  <span class="import-context-pill"><i class="fas fa-layer-group"></i><span id="import_context_tipo">Apenas Encontreiros</span></span>
                  <span class="import-context-pill"><i class="fas fa-database"></i><span id="import_context_origem">Link direto do banco</span></span>
                </div>
                <form id="formImportacao" class="row g-3">
                <div class="col-md-4">
                  <label class="form-label">Tipo de Importacao *</label>
                  <select id="import_tipoImportacao" class="form-select" onchange="atualizarCamposImportacao()">
                    <option value="encontreiros">Apenas Encontreiros</option>
                    <option value="encontro_completo">Encontro Completo (com Equipes e Circulos)</option>
                  </select>
                </div>

                <div class="col-md-4">
                  <label class="form-label">Origem da Importacao *</label>
                  <select id="import_sourceType" class="form-select" onchange="atualizarCamposImportacao()">
                    <option value="database">Link direto do banco</option>
                    <option value="sistema">Copiar de encontro ja criado no sistema</option>
                    <option value="excel">Arquivo Excel</option>
                    <option value="pdf">Arquivo PDF</option>
                  </select>
                </div>

                <div class="col-md-4">
                  <label class="form-label">Limite de Registros</label>
                  <input type="number" id="import_limite" class="form-control" value="1000" min="1" max="5000">
                  <small class="text-muted admin-helper-note mt-1">Aplique limites menores para importações de teste e maior segurança operacional.</small>
                </div>

                <div id="import_encontro_completo_fields" class="row g-3 m-0 p-0 import-panel" style="display:none;">
                  <div class="col-12">
                    <div class="alert alert-info mb-0 import-complete-callout">
                      <span class="import-complete-callout-title"><i class="fas fa-circle-info me-1"></i>Fluxo recomendado</span>
                      Crie primeiro o encontro no sistema e selecione abaixo o encontro de destino para receber os dados importados.
                    </div>
                  </div>
                  <div class="col-lg-7 col-md-6">
                    <label class="form-label">Importar para encontro *</label>
                    <select id="import_ejcSelecionado" class="form-select import-destination-select">
                      <option value="">-- Selecione o encontro de destino --</option>
                    </select>
                  </div>
                  <div class="col-lg-5 col-md-6" id="import_origem_sistema_wrap" style="display:none;">
                    <label class="form-label">Encontro de origem no sistema *</label>
                    <select id="import_encontroOrigemId" class="form-select" onchange="carregarResumoEncontroOrigem()">
                      <option value="">-- Selecione o encontro de origem --</option>
                    </select>
                  </div>
                  <div class="col-12">
                    <div class="import-toggle-grid" role="group" aria-label="Itens para importar">
                      <div class="form-check import-toggle-card">
                        <span class="import-toggle-icon"><i class="fas fa-people-group"></i></span>
                        <div>
                          <label class="form-check-label" for="import_importarEquipes">Importar Equipes</label>
                          <small class="d-block">Replica a estrutura de equipes para o encontro destino.</small>
                        </div>
                        <input class="form-check-input" type="checkbox" id="import_importarEquipes" checked>
                      </div>
                      <div class="form-check import-toggle-card">
                        <span class="import-toggle-icon"><i class="fas fa-circle-nodes"></i></span>
                        <div>
                          <label class="form-check-label" for="import_importarCirculos">Importar Circulos</label>
                          <small class="d-block">Mantem a organizacao por circulos no novo encontro.</small>
                        </div>
                        <input class="form-check-input" type="checkbox" id="import_importarCirculos" checked>
                      </div>
                      <div class="form-check import-toggle-card">
                        <span class="import-toggle-icon"><i class="fas fa-id-badge"></i></span>
                        <div>
                          <label class="form-check-label" for="import_importarEncontreiros">Importar Encontreiros</label>
                          <small class="d-block">Inclui pessoas e dados de cadastro vinculados ao encontro.</small>
                        </div>
                        <input class="form-check-input" type="checkbox" id="import_importarEncontreiros" checked>
                      </div>
                    </div>
                  </div>
                  <div class="col-12">
                    <div id="import_encontro_resumo" class="alert alert-secondary mb-0" role="status">
