    function getTransferenciaEncontroOptions() {
      return (Array.isArray(ejcs) ? ejcs : [])
        .filter((ejc) => ejc && ejc._id && ejc.nome)
        .map((ejc) => {
          const nome = String(ejc.nome || '').trim();
          const isAtivo = !!ejc.ativo || (encontroAtivoNomeAtual && nome === encontroAtivoNomeAtual);
          return {
            value: String(ejc._id),
            label: isAtivo ? `${nome} • Ativo` : nome,
            nome,
            ativo: isAtivo,
          };
        })
        .sort((a, b) => {
          if (a.ativo !== b.ativo) return a.ativo ? -1 : 1;
          return a.nome.localeCompare(b.nome, 'pt-BR');
        });
    }

    function getTransferenciaEncontroPadrao() {
      const options = getTransferenciaEncontroOptions();
      return options[0] ? options[0].value : '';
    }

    function findEjcById(ejcId) {
      return (Array.isArray(ejcs) ? ejcs : []).find((item) => String(item?._id || '') === String(ejcId || '')) || null;
    }

    async function solicitarEncontroTransferencia(totalSelecionados = 1) {
      const options = getTransferenciaEncontroOptions();
      if (!options.length) {
        await appAlert('Cadastre ao menos um encontro antes de transferir encontristas para encontreiros.', 'warning', 'Nenhum encontro disponível');
        return null;
      }

      const plural = totalSelecionados > 1;
      const encontroId = await appSelect(
        plural
          ? `Escolha o encontro que receberá os ${totalSelecionados} encontristas selecionados.`
          : 'Escolha o encontro que receberá este encontrista.',
        options,
        getTransferenciaEncontroPadrao(),
        plural ? 'Selecionar encontro de destino' : 'Selecionar encontro do transferido',
        'Encontro de destino'
      );

      if (encontroId == null) return null;

      const encontro = findEjcById(encontroId);
      if (!encontro) {
        await appAlert('O encontro selecionado não foi encontrado. Tente novamente.', 'warning', 'Seleção inválida');
        return null;
      }

      return encontro;
    }

