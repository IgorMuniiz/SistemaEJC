          <td>${escapeImportHtml(item.motivo || '-')}</td>
        </tr>
      `).join('');

      return `
        <div class="import-report-table-wrap">
          <table class="table table-sm import-report-table">
            <thead>
              <tr>
                <th>Nome</th>
                <th>Email</th>
                <th>Tipo</th>
                <th>Ação</th>
                <th>Motivo</th>
              </tr>
            </thead>
            <tbody>${rows}</tbody>
          </table>
        </div>
