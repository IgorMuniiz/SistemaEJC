    function fecharInlineEditorAdmin(force = false) {
      const row = document.getElementById('admin-inline-editor-row');
      if (!row) return;
      if (adminInlineEditorRemoveTimer) {
        clearTimeout(adminInlineEditorRemoveTimer);
        adminInlineEditorRemoveTimer = null;
      }

      if (force) {
        row.remove();
        return;
      }

      row.style.opacity = '0';
      row.style.transform = 'scaleY(0)';
      row.style.pointerEvents = 'none';
      adminInlineEditorRemoveTimer = setTimeout(() => {
        if (row.isConnected) row.remove();
        adminInlineEditorRemoveTimer = null;
      }, 180);
    }

