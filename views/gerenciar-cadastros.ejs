      const master = document.querySelector(`[data-approval-master-type="${tipo}"]`);
      if (!master) return;

      const visibles = getApprovalBatchCheckboxes(tipo).filter(isApprovalRowVisible);
      const checkedCount = visibles.filter((checkbox) => checkbox.checked).length;
      const allChecked = visibles.length > 0 && checkedCount === visibles.length;

      master.checked = allChecked;
      master.indeterminate = checkedCount > 0 && !allChecked;
    }

    function atualizarAprovacaoLoteUI() {
      const selecionados = getAprovacoesSelecionadas();
      const totalSelecionados = selecionados.length;
      const contador = document.getElementById('approval-batch-counter');
      const btnAprovar = document.getElementById('btn-aprovar-selecionados-aprovacoes');
      const btnReprovar = document.getElementById('btn-reprovar-selecionados-aprovacoes');
      const masterGlobal = document.getElementById('approval-select-all-visible');
      const visiveis = getApprovalBatchCheckboxes().filter(isApprovalRowVisible);
      const visiveisMarcados = visiveis.filter((checkbox) => checkbox.checked).length;
      const allVisibleChecked = visiveis.length > 0 && visiveisMarcados === visiveis.length;

      if (contador) contador.textContent = `${totalSelecionados} selecionado(s)`;
      if (btnAprovar) btnAprovar.disabled = totalSelecionados === 0;
      if (btnReprovar) btnReprovar.disabled = totalSelecionados === 0;

      if (masterGlobal) {
        masterGlobal.checked = allVisibleChecked;
        masterGlobal.indeterminate = visiveisMarcados > 0 && !allVisibleChecked;
      }

      if (lastApprovalSelectionCount !== null && totalSelecionados !== lastApprovalSelectionCount) {
        pulseManagerElement(contador);
        pulseManagerElement(btnAprovar);
        pulseManagerElement(btnReprovar);
      }
      lastApprovalSelectionCount = totalSelecionados;

      atualizarMasterAprovacoesPorTipo('encontrista');
      atualizarMasterAprovacoesPorTipo('encontreiro');
    }

