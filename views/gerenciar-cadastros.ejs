          message,
          isPrompt: false,
          confirmText: tone === 'success' ? 'Perfeito' : 'Entendi',
          tone,
        });
      } catch (e) {
        console.error('[appAlert] erro ao mostrar popup premium:', e);
        window.alert(`${title}\n\n${message}`);
      }
