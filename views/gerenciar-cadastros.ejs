      resetLegacyAppPopupState();

      try {
        const isDanger = /delet|exclus|irrevers|remoc|remover|limpar/i.test(`${title} ${message}`);
        return await showBeautifulDialog({
          title,
          message,
          isPrompt: false,
          cancelText: 'Cancelar',
          confirmText: isDanger ? 'Confirmar' : 'Continuar',
          isDanger,
          tone: isDanger ? 'danger' : 'warning',
        });
      } catch (e) {
        console.error('[appConfirm] erro ao mostrar popup premium:', e);
        return window.confirm(`${title}\n\n${message}`);
