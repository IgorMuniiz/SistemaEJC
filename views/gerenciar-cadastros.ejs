                      <input type="text" id="import_completeColecaoEquipes" class="form-control" value="Equipe">
                    </div>
                    <div class="col-md-4">
                      <label class="form-label">Colecao/Tabela de Circulos</label>
                      <input type="text" id="import_completeColecaoCirculos" class="form-control" value="Circulo">
                    </div>
                    <div class="col-md-4">
                      <label class="form-label">Colecao/Tabela de Encontreiros</label>
                      <input type="text" id="import_completeColecaoEncontreiros" class="form-control" value="Encontro">
                    </div>
                  </div>
                  <div class="col-12" id="import_sqlquery_wrap" style="display:none;"></div>
                </div>

                <div id="import_file_fields" class="row g-3 m-0 p-0 import-panel" style="display:none;">
                  <div class="col-12">
                    <label class="form-label">Arquivo para Importacao *</label>
                    <input type="file" id="import_arquivo" class="form-control" accept=".xlsx,.xls,.xlsm,.pdf">
                  </div>
                  <div class="col-md-6">
                    <label class="form-label">Foto Padrao (opcional)</label>
                    <input type="text" id="import_fotoPadrao" class="form-control" placeholder="arquivo-foto.jpg">
                  </div>
                </div>

                <div class="col-md-6 d-flex align-items-end">
                  <div class="form-check mb-2">
                    <input class="form-check-input" type="checkbox" id="import_atualizarExistentes">
                    <label class="form-check-label" for="import_atualizarExistentes">Atualizar encontreiros ja existentes</label>
                  </div>
                </div>

                <div class="col-md-6 d-flex align-items-end">
                  <button type="button" class="btn btn-primary w-100 admin-primary-action" id="import_button" onclick="importarCadastros()">
                    <i class="fas fa-file-import me-1"></i><span id="import_button_text">Importar Encontreiros</span>
                  </button>
                </div>
              </form>
              <small class="text-muted admin-helper-note">Formatos aceitos: MongoDB, PostgreSQL, MySQL, Excel (.xlsx/.xls/.xlsm) e PDF.</small>
