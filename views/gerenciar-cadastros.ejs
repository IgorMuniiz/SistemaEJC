    function formatCurrencyInputBRL(value) {
      const numeric = String(value || '').replace(/\D/g, '');
      if (!numeric) return '';
      const cents = Number.parseInt(numeric, 10) / 100;
      return cents.toLocaleString('pt-BR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    }

    function initGastosPremiumInputs() {
      const valorInput = document.getElementById('gasto_valor');
      if (!valorInput || valorInput.dataset.maskReady === '1') return;

      valorInput.dataset.maskReady = '1';
      valorInput.addEventListener('input', () => {
        valorInput.value = formatCurrencyInputBRL(valorInput.value);
      });
      valorInput.addEventListener('focus', () => {
        requestAnimationFrame(() => valorInput.select());
      });
    }

    function formatCurrencyValueBRL(value) {
      return normalizeFinanceValue(value).toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' });
    }

    function parseCurrencyValueBRL(value) {
      const raw = String(value == null ? '' : value).trim();
      if (!raw) return Number.NaN;

      const normalized = raw
        .replace(/r\$/gi, '')
        .replace(/\s+/g, '')
        .replace(/\.(?=\d{3}(\D|$))/g, '')
        .replace(',', '.')
        .replace(/[^\d.-]/g, '');

      const parsed = Number.parseFloat(normalized);
      return Number.isFinite(parsed) ? parsed : Number.NaN;
    }

    function normalizeFinanceValue(value) {
      if (typeof value === 'number') {
        return Number.isFinite(value) ? value : 0;
      }

      const numericValue = Number(value);
      if (Number.isFinite(numericValue)) return numericValue;

      const parsedValue = parseCurrencyValueBRL(value);
      return Number.isFinite(parsedValue) ? parsedValue : 0;
    }

    function resolveLancamentoFinanceiroConfig(tipoLancamento) {
      return gastoLancamentoConfigs[tipoLancamento] || gastoLancamentoConfigs.gasto;
    }

    function getFinanceCategoryBadgeClass(categoria, tipoMovimento = '') {
      const normalized = normalizeSearchText(`${categoria || ''} ${tipoMovimento || ''}`);
      if (normalized.includes('doa')) return 'finance-category-badge badge-donation';
      if (normalized.includes('vend')) return 'finance-category-badge badge-sale';
      if (normalized.includes('arrecad') || normalized.includes('inscr') || normalized.includes('repasse') || normalized.includes('patrocin') || normalized.includes('entrada')) {
        return 'finance-category-badge badge-entry';
      }
      if (normalized.includes('saida') || normalized.includes('gasto') || normalized.includes('aliment') || normalized.includes('infra') || normalized.includes('material') || normalized.includes('decor') || normalized.includes('transporte') || normalized.includes('limpeza') || normalized.includes('liturgia') || normalized.includes('comunica') || normalized.includes('brinde')) {
        return 'finance-category-badge badge-expense';
      }
      return 'finance-category-badge';
    }

    function renderGastoCategoryOptions(preferredValue = '') {
      const tipoLancamento = document.getElementById('gasto_tipoLancamento')?.value || 'arrecadacao';
      const categoriaSelect = document.getElementById('gasto_categoria');
      if (!categoriaSelect) return;

      const lancamentoConfig = resolveLancamentoFinanceiroConfig(tipoLancamento);
      const options = lancamentoConfig.isEntrada ? gastoEntradaCategoryOptions : gastoSaidaCategoryOptions;
      const valorSelecionado = preferredValue || categoriaSelect.value || lancamentoConfig.categoriaDefault || 'Outros';

      categoriaSelect.innerHTML = options
        .map((categoria) => `<option value="${escapeHtml(categoria)}">${escapeHtml(categoria)}</option>`)
        .join('');

      categoriaSelect.value = options.includes(valorSelecionado)
        ? valorSelecionado
        : (lancamentoConfig.categoriaDefault || options[0] || 'Outros');
    }

    function parseGastoDateSafe(value) {
      const parsed = value ? new Date(value) : null;
      return parsed && !Number.isNaN(parsed.getTime()) ? parsed : null;
    }

    function isGastoWithinPeriodo(dateValue, periodo) {
      if (!periodo || periodo === 'todos') return true;
      const date = parseGastoDateSafe(dateValue);
      if (!date) return false;

      const now = new Date();
      const startToday = new Date(now.getFullYear(), now.getMonth(), now.getDate());
      const compareDate = new Date(date.getFullYear(), date.getMonth(), date.getDate());

      if (periodo === 'hoje') {
        return compareDate.getTime() === startToday.getTime();
      }

      const diffDays = Math.floor((startToday.getTime() - compareDate.getTime()) / 86400000);
      if (periodo === '7dias') return diffDays >= 0 && diffDays < 7;
      if (periodo === '30dias') return diffDays >= 0 && diffDays < 30;
      if (periodo === 'mes_atual') {
        return date.getFullYear() === now.getFullYear() && date.getMonth() === now.getMonth();
      }
      if (periodo === 'trimestre') return diffDays >= 0 && diffDays < 90;
      return true;
    }

    function getGastosFiltrados() {
      const periodo = document.getElementById('gastos_periodo_filtro')?.value || 'todos';
      const categoria = document.getElementById('gastos_categoria_filtro')?.value || '';
      const escopo = document.getElementById('gastos_escopo_filtro')?.value || '';
      const busca = normalizeSearchText(document.getElementById('gastos_busca_filtro')?.value || '');

      return (gastosFinanceiros || []).filter((item) => {
        if (!item) return false;
        if (!isGastoWithinPeriodo(item.dataGasto, periodo)) return false;
        if (categoria && String(item.categoria || '') !== categoria) return false;
        if (escopo && String(item.escopoTipo || '') !== escopo) return false;

        if (busca) {
          const haystack = normalizeSearchText([
            item.descricao,
            item.responsavel,
            item.equipeNome,
            item.ejcVinculadoNome,
            item.categoria,
            item.formaPagamento,
          ].join(' '));
          if (!haystack.includes(busca)) return false;
        }

        return true;
      });
    }

    let gastosUrlSyncSuspended = false;

    function updateGastosFiltersInUrl() {
      if (gastosUrlSyncSuspended || typeof window === 'undefined' || !window.history || !window.history.replaceState) return;

      const periodo = document.getElementById('gastos_periodo_filtro')?.value || 'mes_atual';
      const categoria = document.getElementById('gastos_categoria_filtro')?.value || '';
      const escopo = document.getElementById('gastos_escopo_filtro')?.value || '';
      const busca = document.getElementById('gastos_busca_filtro')?.value || '';

      const url = new URL(window.location.href);
      if (periodo && periodo !== 'mes_atual') url.searchParams.set('gPeriodo', periodo);
      else url.searchParams.delete('gPeriodo');

      if (categoria) url.searchParams.set('gCategoria', categoria);
      else url.searchParams.delete('gCategoria');

      if (escopo) url.searchParams.set('gEscopo', escopo);
      else url.searchParams.delete('gEscopo');

      if (busca.trim()) url.searchParams.set('gBusca', busca.trim());
      else url.searchParams.delete('gBusca');

      window.history.replaceState({}, '', url.toString());
    }

    function applyGastosFiltersFromUrl() {
      if (typeof window === 'undefined') return;

      const params = new URLSearchParams(window.location.search);
      const periodoInput = document.getElementById('gastos_periodo_filtro');
      const categoriaInput = document.getElementById('gastos_categoria_filtro');
      const escopoInput = document.getElementById('gastos_escopo_filtro');
      const buscaInput = document.getElementById('gastos_busca_filtro');

      gastosUrlSyncSuspended = true;

      const periodoUrl = String(params.get('gPeriodo') || '').trim();
      if (periodoInput && periodoUrl && Array.from(periodoInput.options || []).some((opt) => opt.value === periodoUrl)) {
        periodoInput.value = periodoUrl;
      }

      const categoriaUrl = String(params.get('gCategoria') || '').trim();
      if (categoriaInput && categoriaUrl && Array.from(categoriaInput.options || []).some((opt) => opt.value === categoriaUrl)) {
        categoriaInput.value = categoriaUrl;
      }

      const escopoUrl = String(params.get('gEscopo') || '').trim();
      if (escopoInput && escopoUrl && Array.from(escopoInput.options || []).some((opt) => opt.value === escopoUrl)) {
        escopoInput.value = escopoUrl;
      }

      if (buscaInput) {
        buscaInput.value = String(params.get('gBusca') || '');
      }

      gastosUrlSyncSuspended = false;
    }

    function buildGastoRowMarkup(item) {
      const descricao = escapeHtml(item?.descricao || '-');
      const observacoes = item?.observacoes ? `<div class="text-muted small">${escapeHtml(item.observacoes)}</div>` : '';
      const categoria = escapeHtml(item?.categoria || 'Outros');
      const categoriaBadgeClass = getFinanceCategoryBadgeClass(item?.categoria, 'saida');
      const ejcNome = escapeHtml(item?.ejcVinculadoNome || item?.ejc || '-');
      const responsavel = escapeHtml(item?.responsavel || '-');
      const data = parseGastoDateSafe(item?.dataGasto);
      const dataTexto = data ? data.toLocaleDateString('pt-BR') : '-';
      const escopoBadge = String(item?.escopoTipo || '') === 'equipe'
        ? `<span class="status-badge status-ok gastos-scope-badge">${escapeHtml(item?.equipeNome || 'Equipe')}</span>`
        : '<span class="status-badge gastos-scope-badge">Encontro</span>';
      const descricaoSafe = String(item?.descricao || '').replace(/'/g, "\\'");
      const valor = normalizeFinanceValue(item?.valor);

      return `<tr>
        <td>${dataTexto}</td>
        <td><strong>${descricao}</strong>${observacoes}</td>
        <td><span class="${categoriaBadgeClass}">${categoria}</span></td>
        <td>${escopoBadge}</td>
        <td>${ejcNome}</td>
        <td><strong>${formatCurrencyValueBRL(valor)}</strong></td>
        <td>${responsavel}</td>
        <td>
          <button class="btn btn-delete" onclick="deletarGasto('${String(item?._id || '')}', '${descricaoSafe}')">
            <i class="fas fa-trash me-1"></i>Excluir
          </button>
        </td>
      </tr>`;
    }

    function renderGastosDashboard() {
      const gastosFiltrados = getGastosFiltrados();
      const tbody = document.getElementById('gastos-tbody');
      const countBadge = document.getElementById('gastos_table_count_badge');
      const total = gastosFiltrados.reduce((sum, item) => sum + normalizeFinanceValue(item?.valor), 0);
      const totalEncontro = gastosFiltrados
        .filter((item) => String(item?.escopoTipo || '') !== 'equipe')
        .reduce((sum, item) => sum + normalizeFinanceValue(item?.valor), 0);
      const totalEquipes = gastosFiltrados
        .filter((item) => String(item?.escopoTipo || '') === 'equipe')
        .reduce((sum, item) => sum + normalizeFinanceValue(item?.valor), 0);
      const media = gastosFiltrados.length ? (total / gastosFiltrados.length) : 0;
      const now = new Date();
      const gastosMesAtual = gastosFiltrados.filter((item) => {
        const date = parseGastoDateSafe(item?.dataGasto);
        return date && date.getFullYear() === now.getFullYear() && date.getMonth() === now.getMonth();
      });
      const totalMesAtual = gastosMesAtual.reduce((sum, item) => sum + normalizeFinanceValue(item?.valor), 0);
      const maiorGastoMes = gastosMesAtual.reduce((maior, item) => {
        if (!maior || normalizeFinanceValue(item?.valor) > normalizeFinanceValue(maior?.valor)) return item;
        return maior;
      }, null);
      const percentEncontro = total ? Math.max(0, Math.round((totalEncontro / total) * 100)) : 0;
      const percentEquipes = total ? Math.max(0, 100 - percentEncontro) : 0;

      if (tbody) {
        if (!gastosFiltrados.length) {
          tbody.innerHTML = '<tr><td colspan="8"><div class="gastos-empty-state"><i class="fas fa-wallet"></i><span>Nenhum gasto encontrado com os filtros atuais.</span></div></td></tr>';
        } else {
          tbody.innerHTML = gastosFiltrados.map(buildGastoRowMarkup).join('');
        }
      }

      if (countBadge) countBadge.textContent = `${gastosFiltrados.length} registro(s)`;
      const totalGeralCard = document.getElementById('gastos_total_geral_card');
      const totalEncontroCard = document.getElementById('gastos_total_encontro_card');
      const totalEquipesCard = document.getElementById('gastos_total_equipes_card');
      const totalRegistrosCard = document.getElementById('gastos_total_registros_card');
      const mesAtualCard = document.getElementById('gastos_mes_atual_valor');
      const maiorMesValor = document.getElementById('gastos_maior_mes_valor');
      const maiorMesDesc = document.getElementById('gastos_maior_mes_desc');
      const ticketMedio = document.getElementById('gastos_ticket_medio_valor');
      const distribTotal = document.getElementById('gastos_distrib_total_texto');
      const legendaEncontro = document.getElementById('gastos_legenda_encontro');
      const legendaEquipes = document.getElementById('gastos_legenda_equipes');
      const barEncontro = document.getElementById('gastos_bar_encontro');
      const barEquipes = document.getElementById('gastos_bar_equipes');

      updateGastosFiltersInUrl();

      if (totalGeralCard) totalGeralCard.textContent = formatCurrencyValueBRL(total);
      if (totalEncontroCard) totalEncontroCard.textContent = formatCurrencyValueBRL(totalEncontro);
      if (totalEquipesCard) totalEquipesCard.textContent = formatCurrencyValueBRL(totalEquipes);
      if (totalRegistrosCard) totalRegistrosCard.textContent = String(gastosFiltrados.length);
      if (mesAtualCard) mesAtualCard.textContent = formatCurrencyValueBRL(totalMesAtual);
      if (maiorMesValor) maiorMesValor.textContent = formatCurrencyValueBRL(normalizeFinanceValue(maiorGastoMes?.valor));
      if (maiorMesDesc) maiorMesDesc.textContent = maiorGastoMes?.descricao || 'Sem lançamento no período';
      if (ticketMedio) ticketMedio.textContent = formatCurrencyValueBRL(media);
      if (distribTotal) distribTotal.textContent = `${percentEncontro}% / ${percentEquipes}%`;
      if (legendaEncontro) legendaEncontro.textContent = formatCurrencyValueBRL(totalEncontro);
      if (legendaEquipes) legendaEquipes.textContent = formatCurrencyValueBRL(totalEquipes);
      if (barEncontro) barEncontro.style.width = `${percentEncontro}%`;
      if (barEquipes) barEquipes.style.width = `${percentEquipes}%`;
    }

    function limparFiltrosGastos() {
      const periodo = document.getElementById('gastos_periodo_filtro');
      const categoria = document.getElementById('gastos_categoria_filtro');
      const escopo = document.getElementById('gastos_escopo_filtro');
      const busca = document.getElementById('gastos_busca_filtro');
      if (periodo) periodo.value = 'mes_atual';
      if (categoria) categoria.value = '';
      if (escopo) escopo.value = '';
      if (busca) busca.value = '';
      renderGastosDashboard();
    }

    function bindGastosDashboardFilters() {
      ['gastos_periodo_filtro', 'gastos_categoria_filtro', 'gastos_escopo_filtro', 'gastos_busca_filtro'].forEach((id) => {
        const node = document.getElementById(id);
        if (!node || node.dataset.bound === '1') return;
        node.dataset.bound = '1';
        node.addEventListener('input', renderGastosDashboard);
        node.addEventListener('change', renderGastosDashboard);
      });
    }

    function setFinanceiroPanelState(panel, expanded) {
      if (!panel) return;
      const trigger = panel.querySelector('.gastos-table-toggle');
      const body = panel.querySelector('.financeiro-collapsible-body');
      panel.classList.toggle('is-collapsed', !expanded);
      panel.classList.toggle('is-expanded', expanded);
      if (trigger) trigger.setAttribute('aria-expanded', expanded ? 'true' : 'false');
      if (body) body.hidden = !expanded;
    }

    function toggleFinanceiroPanel(trigger) {
      const panel = trigger?.closest?.('[data-collapsible-panel]');
      if (!panel) return;
      const expanded = trigger.getAttribute('aria-expanded') === 'true';
      setFinanceiroPanelState(panel, !expanded);
    }

    function initFinanceiroPanels() {
      document.querySelectorAll('#gastos [data-collapsible-panel]').forEach((panel) => {
        setFinanceiroPanelState(panel, false);
      });
    }

    function atualizarCamposGasto() {
      const tipoLancamentoSelect = document.getElementById('gasto_tipoLancamento');
      const escopoSelect = document.getElementById('gasto_escopoTipo');
      const equipeWrap = document.getElementById('gasto_equipe_wrap');
      const equipeSelect = document.getElementById('gasto_equipeId');
      const scopeHint = document.getElementById('gasto_scope_hint');
      if (!escopoSelect || !equipeWrap || !equipeSelect) return;

      const tipoLancamento = tipoLancamentoSelect?.value || 'arrecadacao';
      const lancamentoConfig = resolveLancamentoFinanceiroConfig(tipoLancamento);

      if (tipoLancamento === 'venda_equipe' && escopoSelect.value !== 'equipe') {
        escopoSelect.value = 'equipe';
      }
      if (tipoLancamento === 'gasto_equipe' && escopoSelect.value !== 'equipe') {
        escopoSelect.value = 'equipe';
      }
      if (tipoLancamento === 'gasto_encontro' && escopoSelect.value !== 'encontro') {
        escopoSelect.value = 'encontro';
      }

      const isEquipe = escopoSelect.value === 'equipe';
      equipeWrap.style.display = isEquipe ? '' : 'none';
      if (!isEquipe) {
        equipeSelect.value = '';
      }

      renderGastoCategoryOptions();

      if (scopeHint) {
        const destinoTexto = isEquipe
          ? 'uma <strong>equipe específica</strong>'
          : 'o <strong>encontro</strong>';
        scopeHint.innerHTML = lancamentoConfig.isEntrada
          ? `Este lançamento será registrado como <strong>entrada de capital</strong> no fluxo de caixa de ${destinoTexto}.`
          : `Este lançamento será registrado como <strong>gasto</strong> de ${destinoTexto} e também refletido no livro caixa.`;
      }

      const descricaoInput = document.getElementById('gasto_descricao');
      const observacoesInput = document.getElementById('gasto_observacoes');
      const dataLabel = document.getElementById('gasto_data_label');
      const responsavelLabel = document.getElementById('gasto_responsavel_label');
      const formaLabel = document.getElementById('gasto_forma_pagamento_label');
      const submitBtn = document.getElementById('gasto_submit_btn');

      if (descricaoInput) descricaoInput.placeholder = lancamentoConfig.descricaoPlaceholder;
      if (observacoesInput) observacoesInput.placeholder = lancamentoConfig.observacoesPlaceholder;
      if (dataLabel) dataLabel.textContent = lancamentoConfig.isEntrada ? 'Data do lançamento *' : 'Data do gasto *';
      if (responsavelLabel) responsavelLabel.textContent = lancamentoConfig.isEntrada ? 'Responsável pela entrada' : 'Responsável';
      if (formaLabel) formaLabel.textContent = lancamentoConfig.isEntrada ? 'Forma / origem' : 'Forma de pagamento';
      if (submitBtn) submitBtn.innerHTML = lancamentoConfig.submitLabel;

      atualizarOpcoesEquipeGasto(equipeSelect.value);
      initGastosPremiumInputs();
      applyGastosFiltersFromUrl();
      bindGastosDashboardFilters();
      renderGastosDashboard();
    }

    async function cadastrarGasto() {
      if (!ensurePermission('gastos.gerenciar')) return;
      const submitButton = document.getElementById('gasto_submit_btn');

      const tipoLancamento = document.getElementById('gasto_tipoLancamento')?.value || 'arrecadacao';
      const lancamentoConfig = resolveLancamentoFinanceiroConfig(tipoLancamento);
      const isEntrada = Boolean(lancamentoConfig.isEntrada);
      const ejcId = document.getElementById('gasto_ejcId')?.value || '';
      const escopoTipo = document.getElementById('gasto_escopoTipo')?.value || 'encontro';
      const equipeId = document.getElementById('gasto_equipeId')?.value || '';
      const equipeNome = document.getElementById('gasto_equipeId')?.selectedOptions?.[0]?.textContent?.trim() || '';
      const ejcNome = document.getElementById('gasto_ejcId')?.selectedOptions?.[0]?.textContent?.trim() || '';
      const categoria = document.getElementById('gasto_categoria')?.value || (lancamentoConfig.categoriaDefault || 'Outros');
      const descricao = document.getElementById('gasto_descricao')?.value.trim() || '';
      const valor = document.getElementById('gasto_valor')?.value.trim() || '';
      const valorNormalizado = normalizeFinanceValue(valor);
      const dataGasto = document.getElementById('gasto_data')?.value || '';
      const responsavel = document.getElementById('gasto_responsavel')?.value.trim() || '';
      const formaPagamento = document.getElementById('gasto_forma_pagamento')?.value.trim() || '';
      const observacoes = document.getElementById('gasto_observacoes')?.value.trim() || '';

      if (!ejcId) {
        await appAlert('Selecione o EJC do lançamento.', 'warning', 'Dados incompletos');
        return;
      }

      if (!descricao || !valor || !dataGasto) {
        await appAlert('Preencha descrição, valor e data do lançamento.', 'warning', 'Dados incompletos');
        return;
      }

      if (escopoTipo === 'equipe' && !equipeId) {
        await appAlert('Selecione a equipe relacionada ao lançamento.', 'warning', 'Dados incompletos');
        return;
      }

      setActionButtonBusy(submitButton, true, isEntrada ? 'Registrando...' : 'Salvando...');

      const gastoPayload = {
        ejcId,
        escopoTipo,
        equipeId,
        categoria,
        descricao,
        valor: valorNormalizado,
        dataGasto,
        responsavel,
        formaPagamento,
        observacoes,
      };

      const fluxoPayload = {
        ejcId,
        tipoMovimento: isEntrada ? 'entrada' : 'saida',
        categoria,
        descricao,
        valor: valorNormalizado,
        dataMovimento: dataGasto,
        origemDestino: escopoTipo === 'equipe' ? (equipeNome || 'Equipe') : 'Encontro',
        responsavel,
        formaPagamento,
        observacoes: observacoes || (escopoTipo === 'equipe' ? `Lançamento vinculado à equipe ${equipeNome || 'informada'}.` : ''),
      };

      try {
        let gastoCriadoLocal = null;
        if (!isEntrada) {
          const gastoResponse = await fetch('/admin/cadastrar-gasto', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(gastoPayload),
          });

          const gastoResult = await gastoResponse.json();
          if (!gastoResponse.ok || !gastoResult.success) {
            await appAlert(gastoResult.error || 'Erro ao cadastrar gasto.', 'danger', 'Erro');
            return;
          }

          gastoCriadoLocal = buildLocalFinanceiroItem(gastoResult.gasto || gastoPayload, {
            id: gastoResult.gastoId,
            ejcNome,
            escopoTipo,
            equipeId: escopoTipo === 'equipe' ? equipeId : '',
            equipeNome: escopoTipo === 'equipe' ? equipeNome : '',
            dataGasto,
          });
        }

        const fluxoResponse = await fetch('/admin/cadastrar-fluxo-caixa', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(fluxoPayload),
        });

        const fluxoResult = await fluxoResponse.json();
        if (!fluxoResponse.ok || !fluxoResult.success) {
          await appAlert(fluxoResult.error || 'Erro ao refletir o lançamento no fluxo de caixa.', 'danger', 'Erro');
          return;
        }

        const fluxoCriadoLocal = buildLocalFinanceiroItem(fluxoResult.movimento || fluxoPayload, {
          id: fluxoResult.movimentoId,
          ejcNome,
          tipoMovimento: isEntrada ? 'entrada' : 'saida',
          origemDestino: fluxoPayload.origemDestino,
          dataMovimento: dataGasto,
        });

        applyLocalFinanceiroEntry({ gasto: gastoCriadoLocal, fluxo: fluxoCriadoLocal });
        queueManagerFeedback({ tabId: 'gastos' });
        document.getElementById('formGasto')?.reset();

        const tipoLancamentoInput = document.getElementById('gasto_tipoLancamento');
        if (tipoLancamentoInput) {
          tipoLancamentoInput.value = 'arrecadacao';
        }

        const dataInput = document.getElementById('gasto_data');
        if (dataInput) {
          dataInput.value = new Date().toISOString().slice(0, 10);
        }

        atualizarCamposGasto();
        await appAlert(
          lancamentoConfig.sucessoMensagem || 'Lançamento cadastrado com sucesso.',
          'success',
          isEntrada ? 'Entrada registrada' : 'Lançamento salvo'
        );
      } catch (error) {
        await appAlert('Erro ao cadastrar lançamento financeiro.', 'danger', 'Erro');
      } finally {
        setActionButtonBusy(submitButton, false);
      }
    }

    async function deletarGasto(gastoId, descricao) {
      if (!ensurePermission('gastos.gerenciar')) return;
      const triggerButton = getActionTriggerButton();
      const targetRow = triggerButton ? [triggerButton.closest('tr')].filter(Boolean) : [];
      if (!await appConfirm(`Deseja excluir o gasto "${descricao}"?`, 'Confirmar exclusão')) return;

      setActionButtonBusy(triggerButton, true, 'Excluindo...');
      setRowsPendingState(targetRow, true);

      try {
        const response = await fetch(`/admin/deletar-gasto/${gastoId}`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
        });
        const result = await response.json();

        if (result.success) {
          queueManagerFeedback({ tabId: 'gastos' });
          await appAlert('Gasto removido com sucesso.', 'success', 'Sucesso');
          recarregarMantendoAbaAtual();
        } else {
          await appAlert(result.error || 'Erro ao remover gasto.', 'danger', 'Erro');
        }
      } catch (error) {
        await appAlert('Erro ao remover gasto.', 'danger', 'Erro');
      } finally {
        setActionButtonBusy(triggerButton, false);
        setRowsPendingState(targetRow, false);
      }
    }

    function initFluxoCaixaPremiumInputs() {
      const valorInput = document.getElementById('fluxo_valor');
      if (!valorInput || valorInput.dataset.maskReady === '1') return;

      valorInput.dataset.maskReady = '1';
      valorInput.addEventListener('input', () => {
        valorInput.value = formatCurrencyInputBRL(valorInput.value);
      });
      valorInput.addEventListener('focus', () => {
        requestAnimationFrame(() => valorInput.select());
      });
    }

    function buildFluxoCaixaRowMarkup(item) {
      const data = parseGastoDateSafe(item?.dataMovimento);
      const dataTexto = data ? data.toLocaleDateString('pt-BR') : '-';
      const tipo = String(item?.tipoMovimento || 'entrada') === 'saida' ? 'saida' : 'entrada';
      const tipoBadge = tipo === 'saida'
        ? '<span class="finance-movement-badge movement-exit">Saída</span>'
        : '<span class="finance-movement-badge movement-entry">Entrada</span>';
      const descricao = escapeHtml(item?.descricao || '-');
      const categoria = escapeHtml(item?.categoria || 'Outros');
      const categoriaBadgeClass = getFinanceCategoryBadgeClass(item?.categoria, tipo);
      const ejcNome = escapeHtml(item?.ejcVinculadoNome || item?.ejc || '-');
      const responsavel = escapeHtml(item?.responsavel || '-');
      const origemDestino = item?.origemDestino ? `<div class="text-muted small">Origem/Destino: ${escapeHtml(item.origemDestino)}</div>` : '';
      const observacoes = item?.observacoes ? `<div class="text-muted small">${escapeHtml(item.observacoes)}</div>` : '';
      const descricaoSafe = String(item?.descricao || '').replace(/'/g, "\\'");
      const valorNumber = normalizeFinanceValue(item?.valor);
      const valorSinal = tipo === 'saida' ? -valorNumber : valorNumber;

      return `<tr>
        <td>${dataTexto}</td>
        <td>${tipoBadge}</td>
        <td><strong>${descricao}</strong>${origemDestino}${observacoes}</td>
        <td><span class="${categoriaBadgeClass}">${categoria}</span></td>
        <td>${ejcNome}</td>
        <td><strong>${formatCurrencyValueBRL(valorSinal)}</strong></td>
        <td>${responsavel}</td>
        <td>
          <button class="btn btn-delete" onclick="deletarFluxoCaixa('${String(item?._id || '')}', '${descricaoSafe}')">
            <i class="fas fa-trash me-1"></i>Excluir
          </button>
        </td>
      </tr>`;
    }

    function renderFluxoCaixaDashboard() {
      const tbody = document.getElementById('fluxo-caixa-tbody');
      const countBadge = document.getElementById('fluxo_table_count_badge');
      const entradas = (fluxoCaixaFinanceiro || [])
        .filter((item) => String(item?.tipoMovimento || '') !== 'saida')
        .reduce((sum, item) => sum + normalizeFinanceValue(item?.valor), 0);
      const saidas = (fluxoCaixaFinanceiro || [])
        .filter((item) => String(item?.tipoMovimento || '') === 'saida')
        .reduce((sum, item) => sum + normalizeFinanceValue(item?.valor), 0);
      const saldo = entradas - saidas;
      const now = new Date();
      const inicioMes = new Date(now.getFullYear(), now.getMonth(), 1);
      let saldoInicialMes = 0;
      let entradasMes = 0;
      let saidasMes = 0;

      (fluxoCaixaFinanceiro || []).forEach((item) => {
        const dataMovimento = parseGastoDateSafe(item?.dataMovimento);
        if (!dataMovimento) return;

        const valor = normalizeFinanceValue(item?.valor);
        const ehSaida = String(item?.tipoMovimento || '') === 'saida';
        const mesmoMes = dataMovimento.getFullYear() === now.getFullYear()
          && dataMovimento.getMonth() === now.getMonth();

        if (dataMovimento < inicioMes) {
          saldoInicialMes += ehSaida ? -valor : valor;
        } else if (mesmoMes) {
          if (ehSaida) saidasMes += valor;
          else entradasMes += valor;
        }
      });

      const saldoFinalMes = saldoInicialMes + entradasMes - saidasMes;

      if (tbody) {
        if (!fluxoCaixaFinanceiro.length) {
          tbody.innerHTML = '<tr><td colspan="8"><div class="gastos-empty-state"><i class="fas fa-book-open"></i><span>Nenhum movimento de caixa cadastrado.</span></div></td></tr>';
        } else {
          tbody.innerHTML = fluxoCaixaFinanceiro.map(buildFluxoCaixaRowMarkup).join('');
        }
      }

      if (countBadge) countBadge.textContent = `${fluxoCaixaFinanceiro.length} movimento(s)`;
      const entradasCard = document.getElementById('fluxo_total_entradas_card');
      const saidasCard = document.getElementById('fluxo_total_saidas_card');
      const saldoCard = document.getElementById('fluxo_saldo_card');
      const quantidadeCard = document.getElementById('fluxo_quantidade_card');
      const saldoInicialCard = document.getElementById('fluxo_saldo_inicial_mes_card');
      const entradasMesCard = document.getElementById('fluxo_entradas_mes_card');
      const saidasMesCard = document.getElementById('fluxo_saidas_mes_card');
      const saldoFinalMesCard = document.getElementById('fluxo_saldo_final_mes_card');
      const mesReferencia = document.getElementById('fluxo_mes_referencia_texto');

      if (entradasCard) entradasCard.textContent = formatCurrencyValueBRL(entradas);
      if (saidasCard) saidasCard.textContent = formatCurrencyValueBRL(saidas);
      if (saldoCard) saldoCard.textContent = formatCurrencyValueBRL(saldo);
      if (quantidadeCard) quantidadeCard.textContent = String(fluxoCaixaFinanceiro.length);
      if (saldoInicialCard) saldoInicialCard.textContent = formatCurrencyValueBRL(saldoInicialMes);
      if (entradasMesCard) entradasMesCard.textContent = formatCurrencyValueBRL(entradasMes);
      if (saidasMesCard) saidasMesCard.textContent = formatCurrencyValueBRL(saidasMes);
      if (saldoFinalMesCard) saldoFinalMesCard.textContent = formatCurrencyValueBRL(saldoFinalMes);
      if (mesReferencia) mesReferencia.textContent = now.toLocaleDateString('pt-BR', { month: 'long', year: 'numeric' });
    }

    async function cadastrarFluxoCaixa() {
      if (!ensurePermission('gastos.gerenciar')) return;
      const submitButton = document.querySelector('#formFluxoCaixa .gastos-submit-btn');

      const ejcId = document.getElementById('fluxo_ejcId')?.value || '';
      const tipoMovimento = document.getElementById('fluxo_tipoMovimento')?.value || 'entrada';
      const categoria = document.getElementById('fluxo_categoria')?.value || 'Outros';
      const descricao = document.getElementById('fluxo_descricao')?.value.trim() || '';
      const valor = document.getElementById('fluxo_valor')?.value.trim() || '';
      const dataMovimento = document.getElementById('fluxo_dataMovimento')?.value || '';
      const origemDestino = document.getElementById('fluxo_origemDestino')?.value.trim() || '';
      const responsavel = document.getElementById('fluxo_responsavel')?.value.trim() || '';
      const formaPagamento = document.getElementById('fluxo_formaPagamento')?.value.trim() || '';
      const observacoes = document.getElementById('fluxo_observacoes')?.value.trim() || '';

      if (!ejcId) {
        await appAlert('Selecione o EJC do movimento de caixa.', 'warning', 'Dados incompletos');
        return;
      }

      if (!descricao || !valor || !dataMovimento) {
        await appAlert('Preencha descrição, valor e data do movimento.', 'warning', 'Dados incompletos');
        return;
      }

      setActionButtonBusy(submitButton, true, 'Registrando...');

      try {
        const response = await fetch('/admin/cadastrar-fluxo-caixa', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            ejcId,
            tipoMovimento,
            categoria,
            descricao,
            valor,
            dataMovimento,
            origemDestino,
            responsavel,
            formaPagamento,
            observacoes,
          }),
        });

        const result = await response.json();
        if (result.success) {
          queueManagerFeedback({ tabId: 'gastos' });
          await appAlert('Movimento de caixa cadastrado com sucesso.', 'success', 'Sucesso');
          document.getElementById('formFluxoCaixa')?.reset();
          const dataInput = document.getElementById('fluxo_dataMovimento');
          if (dataInput) {
            dataInput.value = new Date().toISOString().slice(0, 10);
          }
          initFluxoCaixaPremiumInputs();
          recarregarMantendoAbaAtual();
        } else {
          await appAlert(result.error || 'Erro ao cadastrar movimento de caixa.', 'danger', 'Erro');
        }
      } catch (error) {
        await appAlert('Erro ao cadastrar movimento de caixa.', 'danger', 'Erro');
      } finally {
        setActionButtonBusy(submitButton, false);
      }
    }

