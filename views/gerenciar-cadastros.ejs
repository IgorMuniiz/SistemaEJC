    async function executarAprovacaoLote(action) {
      if (!ensurePermission('cadastros.aprovar')) return;

      const triggerButton = getActionTriggerButton();

      const selecionados = getAprovacoesSelecionadas();
      if (selecionados.length === 0) {
        await appAlert('Selecione ao menos um cadastro para processar.', 'warning', 'Nenhum selecionado');
        return;
      }

      const idsPorTipo = selecionados.reduce((acc, item) => {
        if (!acc[item.tipo]) acc[item.tipo] = [];
        acc[item.tipo].push(item.id);
        return acc;
      }, {});

      const verbo = action === 'aprovar' ? 'aprovar' : 'reprovar';
      const confirmar = await appConfirm(
        `${verbo.charAt(0).toUpperCase() + verbo.slice(1)} ${selecionados.length} cadastro(s) selecionado(s)?`,
        'Confirmar ação em lote'
      );
      if (!confirmar) return;

      setActionButtonBusy(triggerButton, true, action === 'aprovar' ? 'Aprovando...' : 'Reprovando...');

      try {
        let totalAtualizado = 0;
        let totalNaoEncontrado = 0;

        for (const [tipoLista, ids] of Object.entries(idsPorTipo)) {
          const response = await fetch('/admin/aprovacao-lote', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ tipoLista, action, ids }),
          });

          const result = await response.json();
          if (!response.ok || !result.success) {
            throw new Error(result.error || 'Nao foi possivel concluir a atualização em lote.');
          }

          totalAtualizado += Number(result.updatedCount || 0);
          totalNaoEncontrado += Number(result.missingCount || 0);
        }

        queueManagerFeedback({
          tabId: 'aprovacoes-tab',
          rows: selecionados.slice(0, 12),
        });
        await appAlert(
          `Ação em lote concluída.\n\nAtualizados: ${totalAtualizado}\nNão encontrados: ${totalNaoEncontrado}`,
          'success',
          'Sucesso'
        );
        recarregarMantendoAbaAtual();
      } catch (error) {
        await appAlert('Erro ao processar seleção em lote: ' + (error.message || 'falha de conexão'), 'danger', 'Erro');
      } finally {
        setActionButtonBusy(triggerButton, false);
      }
    }

