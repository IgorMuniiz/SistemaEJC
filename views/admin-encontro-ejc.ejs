    function transferRoleLabel(vinculo) {
      if (vinculo.entidadeTipo === 'circulo') {
        return vinculo.papel === 'moita'
          ? `Moita${vinculo.descricaoPapel ? ` • ${vinculo.descricaoPapel}` : ''}`
          : 'Membro';
      }
      return (vinculo.papel === 'coordenador' || vinculo.papel === 'coordenou')
        ? 'Coordenação'
        : 'Membro';
    }

    function getTransferDestinations(entidadeTipo, entidadeId) {
      const colecao = entidadeTipo === 'circulo' ? circulos : equipes;
      return colecao
        .filter((item) => String(item._id) !== String(entidadeId))
        .map((item) => ({
          id: String(item._id),
          nome: String(item.nome || ''),
        }))
        .sort((a, b) => a.nome.localeCompare(b.nome, 'pt-BR'));
    }

    function getRoleOptionsByEntityType(entidadeTipo) {
      if (entidadeTipo === 'circulo') {
        return [
          { value: 'membro', label: 'Membro' },
          { value: 'moita', label: 'Moita' },
        ];
      }

      return [
        { value: 'membro', label: 'Membro' },
        { value: 'coordenador', label: 'Coordenador' },
      ];
    }

    function getRoleEditorConfig(entidadeTipo) {
      if (entidadeTipo === 'circulo') {
        return {
          roleLabel: 'Novo papel no círculo',
          roleHelp: 'Membro mantém vínculo comum. Moita exige descrição.',
          roleOptions: getRoleOptionsByEntityType('circulo'),
          roleValue: 'membro',
          roleDescriptionPlaceholder: 'Ex.: Música, Liturgia, Organização',
          roleDescriptionHelp: 'Preencha quando o papel for Moita.',
        };
      }

      return {
        roleLabel: 'Novo papel na equipe',
        roleHelp: 'Defina se a pessoa selecionada é Membro ou Coordenador.',
        roleOptions: getRoleOptionsByEntityType('equipe'),
        roleValue: 'membro',
      };
    }

    function getLinkedPeopleSelection(entidadeTipo, entidadeId) {
      return vinculos
        .filter((vinculo) => vinculo.entidadeTipo === entidadeTipo && String(vinculo.entidadeId) === String(entidadeId))
        .map((vinculo) => {
          const pessoa = personByVinculo(vinculo);
          const pessoaId = String(vinculo.pessoaId || '');
          const isLegacy = !/^[a-f\d]{24}$/i.test(pessoaId) || !pessoa;
          return {
            pessoaId,
            nome: String(pessoa?.nomeCompleto || 'Pessoa vinculada'),
            tipo: personTipoLabel(vinculo, pessoa),
            papel: transferRoleLabel(vinculo),
            isLegacy,
            legadoTexto: !pessoa ? 'Vínculo legado ou pessoa não localizada' : 'ID de vínculo legado',
          };
        })
        .sort((a, b) => a.nome.localeCompare(b.nome, 'pt-BR'));
    }

    function getCirculoTheme(nome) {
      const normalizado = String(nome || '')
        .normalize('NFD')
        .replace(/[\u0300-\u036f]/g, '')
        .toLowerCase()
        .replace(/[^a-z\s-]/g, ' ')
        .replace(/\s+/g, ' ')
        .trim();

      const palette = [
        { theme: 'theme-amarelo', termos: ['amarelo', 'dourado', 'ouro', 'ambar', 'gold'] },
        { theme: 'theme-azul', termos: ['azul', 'anil', 'ciano', 'cyan', 'turquesa', 'celeste'] },
        { theme: 'theme-laranja', termos: ['laranja', 'laranjado', 'ocre', 'coral', 'marrom', 'terracota', 'bronze'] },
        { theme: 'theme-verde', termos: ['verde', 'esmeralda', 'lima', 'limao', 'olive', 'oliva'] },
        { theme: 'theme-vermelho', termos: ['vermelho', 'rubro', 'vinho', 'bordo', 'scarlet', 'red'] },
        { theme: 'theme-rosa', termos: ['rosa', 'pink', 'rose', 'cor de rosa', 'rosado'] },
        { theme: 'theme-roxo', termos: ['roxo', 'lilas', 'violeta', 'purple', 'magenta'] },
      ];

      for (const item of palette) {
        if (item.termos.some((termo) => normalizado.includes(termo))) {
          return item.theme;
        }
      }

      if (['preto', 'grafite', 'black'].some((termo) => normalizado.includes(termo))) {
        return 'theme-preto';
      }

      if (['branco', 'prata', 'silver', 'white'].some((termo) => normalizado.includes(termo))) {
        return 'theme-branco';
      }

      if (['cinza', 'gray', 'grey'].some((termo) => normalizado.includes(termo))) {
        return 'theme-default';
      }

      return 'theme-default';
    }

    function getEquipeTheme(nome, index) {
      const normalizado = String(nome || '')
        .normalize('NFD')
        .replace(/[\u0300-\u036f]/g, '')
        .toLowerCase()
        .replace(/[^a-z\s-]/g, ' ')
        .replace(/\s+/g, ' ')
        .trim();

      const keywordPalette = [
        { theme: 'theme-roxo', termos: ['liturgia', 'espiritualidade', 'intercessao'] },
        { theme: 'theme-laranja', termos: ['cozinha', 'cantina', 'alimentacao', 'copa'] },
        { theme: 'theme-azul', termos: ['secretaria', 'comunicacao', 'midia', 'som'] },
        { theme: 'theme-verde', termos: ['acolhida', 'recepcao', 'apoio', 'servico'] },
        { theme: 'theme-vermelho', termos: ['animacao', 'musica', 'banda'] },
        { theme: 'theme-amarelo', termos: ['ornamentacao', 'decoracao', 'ambiente'] },
        { theme: 'theme-rosa', termos: ['bem estar', 'cuidado', 'saude'] },
      ];

      for (const item of keywordPalette) {
        if (item.termos.some((termo) => normalizado.includes(termo))) {
          return item.theme;
        }
      }

      const fallbackPalette = [
        'theme-azul',
        'theme-verde',
        'theme-laranja',
        'theme-roxo',
        'theme-vermelho',
        'theme-amarelo',
        'theme-rosa',
        'theme-default',
        'theme-preto',
      ];

      const safeIndex = Number.isFinite(index) ? index : 0;
      return fallbackPalette[((safeIndex % fallbackPalette.length) + fallbackPalette.length) % fallbackPalette.length];
    }

