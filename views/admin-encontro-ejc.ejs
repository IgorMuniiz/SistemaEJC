    function updateWorkspaceStats() {
      const totalCirculos = Array.isArray(circulos) ? circulos.length : 0;
      const totalEquipes = Array.isArray(equipes) ? equipes.length : 0;
      const totalVinculosCirculos = vinculos.filter((item) => item.entidadeTipo === 'circulo').length;
      const totalVinculosEquipes = vinculos.filter((item) => item.entidadeTipo === 'equipe').length;
      const totalDistribuidos = totalVinculosCirculos + totalVinculosEquipes;

      const setText = (id, text) => {
        const element = document.getElementById(id);
        if (element) {
          element.textContent = text;
        }
      };

      setText('hero-strip-circulos', `${totalVinculosCirculos} vínculos em círculos`);
      setText('hero-strip-equipes', `${totalVinculosEquipes} vínculos em equipes`);
      setText('hero-strip-distribuidos', `${totalDistribuidos} pessoas distribuídas`);
      setText('stat-total-circulos', String(totalCirculos));
      setText('stat-total-equipes', String(totalEquipes));
      setText('stat-vinculos-circulos', String(totalVinculosCirculos));
      setText('stat-vinculos-equipes', String(totalVinculosEquipes));
      setText('module-count-circulos', String(totalCirculos));
      setText('module-count-equipes', String(totalEquipes));
      setText('module-count-quadrante', String(totalDistribuidos));
      setText('module-count-crachas', String(totalDistribuidos));
      setText('panel-chip-circulos', `${totalVinculosCirculos} vínculos`);
      setText('panel-chip-equipes', `${totalVinculosEquipes} vínculos`);
    }

    function getActionTriggerButton() {
      const active = document.activeElement;
      return active instanceof HTMLButtonElement ? active : null;
    }

    function setActionButtonBusy(button, isBusy, busyText = 'Processando...') {
      if (!button) return;

      if (isBusy) {
        if (!button.dataset.originalHtml) {
          button.dataset.originalHtml = button.innerHTML;
        }
        button.disabled = true;
        button.classList.add('is-busy');
        button.innerHTML = `<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>${escapeHtml(busyText)}`;
        return;
      }

      button.disabled = false;
      button.classList.remove('is-busy');
      if (button.dataset.originalHtml) {
        button.innerHTML = button.dataset.originalHtml;
        delete button.dataset.originalHtml;
      }
    }

    function resetMultiSelect(selectId, inputId) {
      const { select, list } = getChecklistElements(selectId);
      if (select) {
        Array.from(select.options || []).forEach((option) => {
          option.selected = false;
        });
      }

      if (list) {
        Array.from(list.querySelectorAll('input[type="checkbox"]')).forEach((checkbox) => {
          checkbox.checked = false;
        });
        list.classList.add('d-none');
      }

      const input = inputId ? document.getElementById(inputId) : null;
      if (input) {
        input.value = '';
      }

      atualizarContadorSelecao(selectId);
      if (inputId) {
        filtrarSelectMulti(selectId, '');
      }
    }

    function applyLocalVinculosUpdate({ entidadeTipo, pessoaTipo, papel, descricaoPapel = '', novosVinculos = [] }) {
      if (!Array.isArray(novosVinculos) || !novosVinculos.length) return;

      novosVinculos.forEach((vinculo) => {
        vinculos.push(vinculo);

        const pessoaMap = pessoaTipo === 'encontrista' ? mapEncontristas : mapEncontreiros;
        const pessoa = pessoaMap[String(vinculo.pessoaId)];
        if (!pessoa) return;

        pessoa.ejcVinculadoId = ejcId;
        const ejcNomeAtivo = <%- JSON.stringify(String(ejc.nome || '')) %>;
        pessoa.ejcVinculadoNome = ejcNomeAtivo;

        if (entidadeTipo === 'equipe' && pessoaTipo === 'encontreiro') {
          const equipe = equipes.find((item) => String(item._id) === String(vinculo.entidadeId));
          const equipeNome = equipe ? String(equipe.nomeReferencia || equipe.nome || '') : '';
          if (!equipeNome) return;

          const targetField = papel === 'coordenador' ? 'equipeCoordenou' : 'equipeServiu';
          const listaAtual = Array.isArray(pessoa[targetField]) ? pessoa[targetField] : [];
          if (!listaAtual.includes(equipeNome)) {
            pessoa[targetField] = [...listaAtual, equipeNome];
          }
        }
      });

      renderAll();
    }

    function pinModalToViewport(modalElement, dialogSelector) {
      if (!modalElement) return;

      modalElement.style.setProperty('position', 'fixed', 'important');
      modalElement.style.setProperty('inset', '0', 'important');
      modalElement.style.setProperty('top', '0', 'important');
      modalElement.style.setProperty('right', '0', 'important');
      modalElement.style.setProperty('bottom', '0', 'important');
      modalElement.style.setProperty('left', '0', 'important');
      modalElement.style.setProperty('min-height', '100dvh', 'important');
      modalElement.style.setProperty('height', '100dvh', 'important');

      const dialogElement = modalElement.querySelector(dialogSelector);
      if (!dialogElement) return;

      dialogElement.style.display = 'flex';
      dialogElement.style.alignItems = 'center';
      dialogElement.style.justifyContent = 'center';
      dialogElement.style.minHeight = 'calc(100dvh - 24px)';
      dialogElement.style.margin = '12px auto';
    }

    function ensureAppPopup() {
      let modalElement = document.getElementById('app-popup-modal');
      if (modalElement) {
        pinModalToViewport(modalElement, '.app-popup-dialog');
        return {
          element: modalElement,
          instance: bootstrap.Modal.getOrCreateInstance(modalElement),
        };
      }

      modalElement = document.createElement('div');
      modalElement.className = 'modal fade';
      modalElement.id = 'app-popup-modal';
      modalElement.tabIndex = -1;
      modalElement.setAttribute('aria-hidden', 'true');
      modalElement.innerHTML = `
        <div class="modal-dialog modal-dialog-centered app-popup-dialog">
          <div class="modal-content border-0 shadow-lg app-popup-content app-popup-tone-primary">
            <div class="modal-header app-popup-header">
              <div class="app-popup-headline">
                <div class="app-popup-orb" id="app-popup-orb" aria-hidden="true"><i class="fas fa-sparkles"></i></div>
                <div class="app-popup-title-stack">
                  <span class="app-popup-kicker" id="app-popup-kicker">Ação rápida</span>
                  <h5 class="modal-title" id="app-popup-title">Aviso</h5>
                </div>
              </div>
              <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
            </div>
            <div class="modal-body app-popup-body">
              <p id="app-popup-message" class="mb-0" style="white-space: pre-line;"></p>
              <div class="app-popup-note" id="app-popup-note"></div>
            </div>
            <div class="modal-footer app-popup-footer">
              <button type="button" class="btn btn-outline-secondary app-popup-cancel" id="app-popup-cancel">Cancelar</button>
              <button type="button" class="btn btn-primary app-popup-confirm" id="app-popup-confirm">OK</button>
            </div>
          </div>
        </div>
      `;
      document.body.appendChild(modalElement);

      pinModalToViewport(modalElement, '.app-popup-dialog');

      return {
        element: modalElement,
        instance: bootstrap.Modal.getOrCreateInstance(modalElement),
      };
    }

    function showAppPopup({ title, message, confirmText = 'OK', cancelText = null, tone = 'primary' }) {
      const { element, instance } = ensureAppPopup();
      const titleEl = element.querySelector('#app-popup-title');
      const kickerEl = element.querySelector('#app-popup-kicker');
      const messageEl = element.querySelector('#app-popup-message');
      const noteEl = element.querySelector('#app-popup-note');
      const orbEl = element.querySelector('#app-popup-orb');
      const confirmBtn = element.querySelector('#app-popup-confirm');
      const cancelBtn = element.querySelector('#app-popup-cancel');
      const contentEl = element.querySelector('.app-popup-content');

      const toneLabels = {
        primary: 'Acao rapida',
        warning: 'Confirmacao',
        danger: 'Atencao',
        success: 'Concluido',
      };
      const toneNotes = {
        primary: 'Siga com a ação e acompanhe o reflexo imediato na distribuição deste encontro.',
        warning: 'Revise a operação antes de confirmar para evitar retrabalho manual.',
        danger: 'Confira os dados com cuidado antes de seguir com esta alteração.',
        success: 'A distribuição foi atualizada sem recarregar a tela e a operação já foi refletida abaixo.',
      };
      const toneIcons = {
        primary: 'fa-sparkles',
        warning: 'fa-shield-halved',
        danger: 'fa-triangle-exclamation',
        success: 'fa-circle-check',
      };

      titleEl.textContent = title || 'Aviso';
      kickerEl.textContent = toneLabels[tone] || 'Acao rapida';
      messageEl.textContent = message || '';
      if (noteEl) {
        noteEl.textContent = toneNotes[tone] || toneNotes.primary;
        noteEl.style.display = noteEl.textContent ? '' : 'none';
      }
      if (orbEl) {
        orbEl.innerHTML = `<i class="fas ${toneIcons[tone] || toneIcons.primary}"></i>`;
      }
      confirmBtn.textContent = confirmText;
      confirmBtn.className = `btn btn-${tone} app-popup-confirm`;
      contentEl.classList.remove('app-popup-tone-primary', 'app-popup-tone-warning', 'app-popup-tone-danger', 'app-popup-tone-success');
      contentEl.classList.add(`app-popup-tone-${tone}`);

      if (cancelText) {
        cancelBtn.style.display = '';
        cancelBtn.textContent = cancelText;
      } else {
        cancelBtn.style.display = 'none';
      }

      return new Promise((resolve) => {
        let resolved = false;

        const cleanup = () => {
          confirmBtn.removeEventListener('click', onConfirm);
          cancelBtn.removeEventListener('click', onCancel);
          element.removeEventListener('hidden.bs.modal', onHidden);
        };

        const settle = (value) => {
          if (resolved) return;
          resolved = true;
          cleanup();
          resolve(value);
        };

        const onConfirm = () => {
          settle(true);
          instance.hide();
        };

        const onCancel = () => {
          settle(false);
          instance.hide();
        };

        const onHidden = () => settle(false);

        confirmBtn.addEventListener('click', onConfirm);
        cancelBtn.addEventListener('click', onCancel);
        element.addEventListener('hidden.bs.modal', onHidden, { once: true });

        instance.show();
      });
    }

