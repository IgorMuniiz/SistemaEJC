        transferLabel: 'Gerenciar pessoas vinculadas',
        transferHelp: 'Marque os nomes, escolha a ação e aplique sem sair da tela.',
        transferOptions: getTransferDestinations('equipe', equipeId),
        linkedPeople: getLinkedPeopleSelection('equipe', equipeId),
        emptyTransferText: 'Nenhuma pessoa vinculada a esta equipe no momento.',
        ...getRoleEditorConfig('equipe'),
      });

      if (!editorData) return;

      const novoNome = String(editorData.value || '').trim();
      const acaoVinculo = String(editorData.acaoVinculo || 'transferir');
      const transferirParaId = String(editorData.transferirParaId || '').trim();
      const papelVinculo = String(editorData.papelVinculo || '').trim().toLowerCase();
      const descricaoPapelVinculo = String(editorData.descricaoPapelVinculo || '').trim();
      const gerenciarPessoaIds = Array.isArray(editorData.gerenciarPessoaIds)
        ? editorData.gerenciarPessoaIds.filter(Boolean)
        : [];

      if (!novoNome) return await appAlert('Informe o nome da equipe.', 'warning', 'Campo obrigatório');
      if (gerenciarPessoaIds.length && acaoVinculo === 'transferir' && !transferirParaId) {
        return await appAlert('Escolha a equipe de destino para concluir a transferência.', 'warning', 'Transferência incompleta');
      }
      if (gerenciarPessoaIds.length && acaoVinculo === 'papel' && !papelVinculo) {
        return await appAlert('Selecione o novo papel para as pessoas marcadas.', 'warning', 'Papel obrigatório');
      }
      if (novoNome === String(nomeAtual || '').trim() && !gerenciarPessoaIds.length) return;

      const res = await fetch(`/admin/editar-equipe/${encodeURIComponent(equipeId)}`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          ejcId,
          nome: novoNome,
          acaoVinculo,
          gerenciarPessoaIds,
          transferirParaId,
          papelVinculo,
          descricaoPapelVinculo,
          transferirPessoaIds: acaoVinculo === 'transferir' ? gerenciarPessoaIds : [],
          removerPessoaIds: acaoVinculo === 'excluir' ? gerenciarPessoaIds : [],
        }),
      });
      const data = await res.json();
      if (!data.success) return await appAlert(data.error || 'Erro ao editar equipe.', 'danger', 'Erro');
      recarregarMantendoPainelAtual();
    }

    async function excluirEquipe(equipeId, nomeEquipe) {
      if (!ensurePermission('equipes.gerenciar')) return;
      if (!equipeId) return;
      if (!await appConfirm(`Deseja excluir a equipe \"${nomeEquipe || ''}\"? Todos os vinculos dela serao removidos.`, 'Confirmar exclusao')) return;

      const res = await fetch(`/admin/excluir-equipe/${encodeURIComponent(equipeId)}`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ ejcId }),
      });
      const data = await res.json();
      if (!data.success) return await appAlert(data.error || 'Erro ao excluir equipe.', 'danger', 'Erro');
      recarregarMantendoPainelAtual();
    }

    async function vincularEncontristaCirculo() {
      if (!ensurePermission('encontros.gerenciar')) return;
      const triggerButton = getActionTriggerButton();
      try {
        const entidadeId = document.getElementById('circulo_id').value;
        const pessoaIds = Array.from(document.getElementById('encontrista_id').selectedOptions || [])
          .map((option) => String(option.value || '').trim())
          .filter(Boolean);
        const papel = document.getElementById('papel_circulo').value || 'membro';
        const descricaoPapel = (document.getElementById('descricao_papel_moita').value || '').trim();

        if (!entidadeId || pessoaIds.length === 0) return await appAlert('Selecione circulo e ao menos um encontrista.', 'warning', 'Dados incompletos');
        if (papel === 'moita' && !descricaoPapel) {
          return await appAlert('Informe qual papel a pessoa esta fazendo na moita.', 'warning', 'Campo obrigatorio');
        }

        console.log('[VINCULAR CIRCULO]', { ejcId, entidadeId, pessoaIds, papel, descricaoPapel });
        setActionButtonBusy(triggerButton, true, 'Vinculando...');

        const res = await fetch('/admin/vincular-encontro', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Accept': 'application/json',
          },
          body: JSON.stringify({
            ejcId,
            entidadeTipo: 'circulo',
            entidadeId,
            pessoaTipo: 'encontrista',
            pessoaIds,
            papel,
            descricaoPapel,
          })
        });

        const contentType = String(res.headers.get('content-type') || '');
        if (!contentType.includes('application/json')) {
          if (res.status === 401) {
            throw new Error('Sua sessao expirou. Atualize a pagina e faça login novamente.');
          }
          throw new Error('Resposta invalida do servidor ao vincular no circulo.');
        }

        const data = await res.json();
        console.log('[VINCULAR CIRCULO] resposta:', res.status, data);
        if (!res.ok || !data.success) {
          return await appAlert(data.error || 'Erro ao vincular encontrista.', 'danger', 'Erro');
        }

        if ((Number(data.vinculados) || 0) === 0) {
          return await appAlert(`Nenhum novo vinculo foi criado. Esses nomes podem ja estar vinculados nesse circulo. (ja vinculados: ${data.jaVinculados || 0}, nao encontrados: ${data.naoEncontrados || 0})`, 'warning', 'Sem alteracoes');
        }

        applyLocalVinculosUpdate({
          entidadeTipo: 'circulo',
          pessoaTipo: 'encontrista',
          papel,
          descricaoPapel,
          novosVinculos: Array.isArray(data.novosVinculos) ? data.novosVinculos : [],
        });
        resetMultiSelect('encontrista_id', 'filtro_encontrista');
        document.getElementById('papel_circulo').value = 'membro';
        document.getElementById('descricao_papel_moita').value = '';
        alternarCampoMoita();
        await appAlert(`${data.vinculados} vínculo(s) criado(s) com sucesso.`, 'success', 'Círculo atualizado');
      } catch (err) {
        await appAlert(`Falha ao vincular encontrista: ${err.message}`, 'danger', 'Erro');
      } finally {
        setActionButtonBusy(triggerButton, false);
      }
    }

    async function vincularEncontreiroEquipeEJC() {
      if (!ensurePermission('equipes.gerenciar')) return;
      const triggerButton = getActionTriggerButton();
      try {
        const entidadeId = document.getElementById('equipe_id').value;
        const pessoaIds = Array.from(document.getElementById('encontreiro_id').selectedOptions || [])
          .map((option) => String(option.value || '').trim())
          .filter(Boolean);
        const papel = document.getElementById('papel_equipe').value;

        if (!entidadeId || pessoaIds.length === 0 || !papel) {
          return await appAlert('Selecione equipe, ao menos uma pessoa e vinculo.', 'warning', 'Dados incompletos');
        }

        console.log('[VINCULAR EQUIPE]', { ejcId, entidadeId, pessoaIds, papel });
        setActionButtonBusy(triggerButton, true, papel === 'coordenador' ? 'Registrando capitão...' : 'Vinculando...');

        const res = await fetch('/admin/vincular-encontro', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Accept': 'application/json',
          },
          body: JSON.stringify({ ejcId, entidadeTipo: 'equipe', entidadeId, pessoaTipo: 'encontreiro', pessoaIds, papel })
        });

        const contentType = String(res.headers.get('content-type') || '');
        if (!contentType.includes('application/json')) {
          if (res.status === 401) {
            throw new Error('Sua sessao expirou. Atualize a pagina e faça login novamente.');
          }
          throw new Error('Resposta invalida do servidor ao vincular na equipe.');
        }

        const data = await res.json();
        console.log('[VINCULAR EQUIPE] resposta:', res.status, data);
        if (!res.ok || !data.success) {
          return await appAlert(data.error || 'Erro ao vincular na equipe.', 'danger', 'Erro');
        }

        if ((Number(data.vinculados) || 0) === 0) {
          return await appAlert(`Nenhum novo vinculo foi criado. Esses nomes podem ja estar vinculados nessa equipe. (ja vinculados: ${data.jaVinculados || 0}, nao encontrados: ${data.naoEncontrados || 0})`, 'warning', 'Sem alteracoes');
        }

        applyLocalVinculosUpdate({
          entidadeTipo: 'equipe',
          pessoaTipo: 'encontreiro',
          papel,
          novosVinculos: Array.isArray(data.novosVinculos) ? data.novosVinculos : [],
        });
        resetMultiSelect('encontreiro_id', 'filtro_encontreiro');
        await appAlert(
          papel === 'coordenador'
            ? `${data.vinculados} capitão(ões) registrado(s) com sucesso.`
            : `${data.vinculados} vínculo(s) criado(s) com sucesso.`,
          'success',
          papel === 'coordenador' ? 'Capitão registrado' : 'Equipe atualizada'
        );
      } catch (err) {
        await appAlert(`Falha ao vincular na equipe: ${err.message}`, 'danger', 'Erro');
      } finally {
        setActionButtonBusy(triggerButton, false);
      }
    }

    function alternarCampoMoita() {
      const papel = document.getElementById('papel_circulo').value;
      const wrap = document.getElementById('wrap_papel_moita');
      if (!wrap) return;

      if (papel === 'moita') {
        wrap.style.display = '';
      } else {
        wrap.style.display = 'none';
        const input = document.getElementById('descricao_papel_moita');
        if (input) input.value = '';
      }
    }

    initChecklistFromSelect('encontrista_id');
    initChecklistFromSelect('encontreiro_id');
    observarContadorSelecao('encontrista_id');
    observarContadorSelecao('encontreiro_id');
    alternarCampoMoita();
    aplicarPermissoesNaPagina();
    restaurarPainelAtivo();
    renderAll();
  </script>
</body>
</html>

