    async function appEntityEditorPrompt({
      title = 'Editar',
      label = 'Novo valor',
      value = '',
      placeholder = '',
      help = '',
      confirmText = 'Salvar alterações',
      transferLabel = 'Gerenciar pessoas vinculadas',
      transferHelp = '',
      transferOptions = [],
      linkedPeople = [],
      emptyTransferText = 'Nenhuma pessoa vinculada disponível para gerenciamento.',
      defaultAction = 'transferir',
      roleLabel = 'Novo papel',
      roleHelp = '',
      roleOptions = [],
      roleValue = '',
      roleDescription = '',
      roleDescriptionPlaceholder = 'Descrição do papel (quando aplicável)',
      roleDescriptionHelp = '',
    }) {
      const { element, instance } = ensureEntityEditorPopup();
      const titleEl = element.querySelector('#app-entity-editor-title');
      const labelEl = element.querySelector('#app-entity-editor-label');
      const inputEl = element.querySelector('#app-entity-editor-field');
      const helpEl = element.querySelector('#app-entity-editor-help');
      const selectionCountEl = element.querySelector('#app-entity-selection-count span');
      const transferShell = element.querySelector('#app-entity-transfer-shell');
      const transferLabelEl = element.querySelector('#app-entity-transfer-label');
      const transferHelpEl = element.querySelector('#app-entity-transfer-help');
      const transferSelect = element.querySelector('#app-entity-transfer-destination');
      const destinationWrap = element.querySelector('#app-entity-destination-wrap');
      const roleWrap = element.querySelector('#app-entity-role-wrap');
      const roleLabelEl = element.querySelector('#app-entity-role-label');
      const roleSelect = element.querySelector('#app-entity-role-select');
      const roleHelpEl = element.querySelector('#app-entity-role-help');
      const roleDescriptionInput = element.querySelector('#app-entity-role-description');
      const roleDescriptionHelpEl = element.querySelector('#app-entity-role-description-help');
      const transferList = element.querySelector('#app-entity-transfer-list');
      const actionOptions = Array.from(element.querySelectorAll('.app-entity-action-option'));
      const actionInputs = Array.from(element.querySelectorAll('input[name="app-entity-link-action"]'));
      const selectAllWrap = element.querySelector('#app-entity-transfer-selectall-wrap');
      const selectAllCheckbox = element.querySelector('#app-entity-transfer-selectall');
      const cancelBtn = element.querySelector('#app-entity-editor-cancel');
      const confirmBtn = element.querySelector('#app-entity-editor-confirm');

      titleEl.textContent = title;
      labelEl.textContent = label;
      inputEl.value = String(value || '');
      inputEl.placeholder = String(placeholder || '');
      helpEl.textContent = String(help || '');
      helpEl.style.display = help ? '' : 'none';
      confirmBtn.innerHTML = `<i class="fas fa-floppy-disk me-1"></i>${escapeHtml(confirmText)}`;

      transferShell.style.display = '';
      transferLabelEl.textContent = transferLabel;
      transferHelpEl.textContent = String(transferHelp || '');
      transferHelpEl.style.display = transferHelp ? '' : 'none';
      transferSelect.innerHTML = ['<option value="">Selecione o destino</option>']
        .concat((transferOptions || []).map((item) => `<option value="${escapeHtml(item.id)}">${escapeHtml(item.nome)}</option>`))
        .join('');
      transferSelect.disabled = !Array.isArray(transferOptions) || !transferOptions.length;

      roleLabelEl.textContent = String(roleLabel || 'Novo papel');
      roleSelect.innerHTML = ['<option value="">Selecione o papel</option>']
        .concat((roleOptions || []).map((item) => `<option value="${escapeHtml(item.value)}">${escapeHtml(item.label)}</option>`))
        .join('');
      roleSelect.value = String(roleValue || '');
      roleSelect.disabled = !Array.isArray(roleOptions) || !roleOptions.length;

      roleHelpEl.textContent = String(roleHelp || '');
      roleHelpEl.style.display = roleHelp ? '' : 'none';

      roleDescriptionInput.value = String(roleDescription || '');
      roleDescriptionInput.placeholder = String(roleDescriptionPlaceholder || 'Descrição do papel (quando aplicável)');
      roleDescriptionInput.style.display = 'none';

      roleDescriptionHelpEl.textContent = String(roleDescriptionHelp || '');
      roleDescriptionHelpEl.style.display = 'none';

      const hasLinkedPeople = Array.isArray(linkedPeople) && linkedPeople.length > 0;
      selectAllCheckbox.checked = false;
      selectAllWrap.style.display = hasLinkedPeople ? '' : 'none';

      actionInputs.forEach((input) => {
        input.checked = input.value === defaultAction;
        input.disabled = !hasLinkedPeople;
      });

      const syncRoleDescriptionVisibility = () => {
        const papelAtual = String(roleSelect.value || '').toLowerCase();
        const isMoita = papelAtual === 'moita';
        roleDescriptionInput.style.display = isMoita ? '' : 'none';
        roleDescriptionHelpEl.style.display = isMoita && roleDescriptionHelp ? '' : 'none';
      };

      if (hasLinkedPeople) {
        transferList.innerHTML = linkedPeople.map((person) => `
          <label class="app-entity-person-card${person.isLegacy ? ' is-legacy' : ''}" data-transfer-row="true">
            <input class="form-check-input app-entity-person-check" type="checkbox" value="${escapeHtml(person.pessoaId)}" data-transfer-person="true"${person.isLegacy ? ' disabled' : ''}>
            <span class="app-entity-person-main">
              <strong>${escapeHtml(person.nome)}</strong>
              <small>${escapeHtml(person.tipo)}</small>
            </span>
            <span class="app-entity-person-role${person.isLegacy ? ' is-legacy-badge' : ''}">${escapeHtml(person.isLegacy ? 'Legado' : person.papel)}</span>
            ${person.isLegacy ? '<small class="app-entity-person-legacy-note">' + escapeHtml(person.legadoTexto) + '</small>' : ''}
          </label>
        `).join('');
      } else {
        transferList.innerHTML = `<div class="app-entity-empty-state"><i class="fas fa-users-slash"></i><p>${escapeHtml(emptyTransferText)}</p></div>`;
      }

      const getTransferCheckboxes = () => Array.from(transferList.querySelectorAll('input[data-transfer-person="true"]'));
      const getSelectedAction = () => actionInputs.find((item) => item.checked)?.value || 'transferir';
      const selectedIds = () => getTransferCheckboxes().filter((item) => item.checked).map((item) => String(item.value || ''));

      const syncSelectAllState = () => {
        const checkboxes = getTransferCheckboxes();
        const total = checkboxes.length;
        const checked = checkboxes.filter((item) => item.checked).length;
        selectAllCheckbox.indeterminate = checked > 0 && checked < total;
        selectAllCheckbox.checked = total > 0 && checked === total;
      };

      const updateSelectionCount = () => {
        const totalSelecionados = selectedIds().length;
        selectionCountEl.textContent = totalSelecionados === 1
          ? '1 pessoa marcada'
          : `${totalSelecionados} pessoas marcadas`;
      };

      const updateActionState = () => {
        const acaoAtual = getSelectedAction();
        const totalSelecionados = selectedIds().length;
        destinationWrap.style.display = acaoAtual === 'transferir' ? '' : 'none';
        roleWrap.style.display = acaoAtual === 'papel' ? '' : 'none';
        syncRoleDescriptionVisibility();

        actionOptions.forEach((option) => {
          option.classList.toggle('is-active', option.getAttribute('data-action') === acaoAtual);
        });

        if (acaoAtual === 'excluir' && totalSelecionados > 0) {
          confirmBtn.classList.remove('btn-primary');
          confirmBtn.classList.add('btn-danger');
          confirmBtn.innerHTML = '<i class="fas fa-user-minus me-1"></i>Excluir selecionados';
        } else if (acaoAtual === 'papel' && totalSelecionados > 0) {
          confirmBtn.classList.remove('btn-danger');
          confirmBtn.classList.add('btn-primary');
          confirmBtn.innerHTML = '<i class="fas fa-user-pen me-1"></i>Alterar papel';
        } else if (acaoAtual === 'transferir' && totalSelecionados > 0) {
          confirmBtn.classList.remove('btn-danger');
          confirmBtn.classList.add('btn-primary');
          confirmBtn.innerHTML = '<i class="fas fa-right-left me-1"></i>Transferir selecionados';
        } else {
          confirmBtn.classList.remove('btn-danger');
          confirmBtn.classList.add('btn-primary');
          confirmBtn.innerHTML = `<i class="fas fa-floppy-disk me-1"></i>${escapeHtml(confirmText)}`;
        }

        updateSelectionCount();
        syncSelectAllState();
      };

      return new Promise((resolve) => {
        let resolved = false;
        const viewportTarget = window.visualViewport || null;

        const onViewportChange = () => {
          syncEntityEditorViewport(element);
        };

        const cleanup = () => {
          cancelBtn.removeEventListener('click', onCancel);
          confirmBtn.removeEventListener('click', onConfirm);
          inputEl.removeEventListener('keydown', onInputKeydown);
          selectAllCheckbox.removeEventListener('change', onToggleAll);
          transferList.removeEventListener('change', onListChange);
          actionInputs.forEach((input) => input.removeEventListener('change', onActionChange));
          roleSelect.removeEventListener('change', onRoleChange);
          roleDescriptionInput.removeEventListener('input', onRoleChange);
          element.removeEventListener('shown.bs.modal', onShown);
          element.removeEventListener('hidden.bs.modal', onHidden);
          window.removeEventListener('resize', onViewportChange);
          if (viewportTarget) {
            viewportTarget.removeEventListener('resize', onViewportChange);
            viewportTarget.removeEventListener('scroll', onViewportChange);
          }
        };

        const settle = (payload) => {
          if (resolved) return;
          resolved = true;
          cleanup();
          resolve(payload);
        };

        const onCancel = () => {
          settle(null);
          instance.hide();
        };

        const onConfirm = () => {
          const acaoVinculo = getSelectedAction();
          const gerenciarPessoaIds = selectedIds();
          settle({
            value: String(inputEl.value || ''),
            acaoVinculo,
            transferirParaId: acaoVinculo === 'transferir' ? String(transferSelect.value || '') : '',
            papelVinculo: acaoVinculo === 'papel' ? String(roleSelect.value || '') : '',
            descricaoPapelVinculo: acaoVinculo === 'papel' ? String(roleDescriptionInput.value || '').trim() : '',
            gerenciarPessoaIds,
            transferirPessoaIds: acaoVinculo === 'transferir' ? gerenciarPessoaIds : [],
            removerPessoaIds: acaoVinculo === 'excluir' ? gerenciarPessoaIds : [],
          });
          instance.hide();
        };

        const onInputKeydown = (event) => {
          if (event.key === 'Enter') {
            event.preventDefault();
            onConfirm();
          }
        };

        const onToggleAll = () => {
          getTransferCheckboxes().forEach((item) => {
            item.checked = selectAllCheckbox.checked;
          });
          updateActionState();
        };

        const onListChange = (event) => {
          if (event.target && event.target.matches('input[data-transfer-person="true"]')) {
            const row = event.target.closest('[data-transfer-row="true"]');
            if (row) {
              row.classList.toggle('is-selected', event.target.checked);
            }
            updateActionState();
          }
        };

        const onActionChange = () => updateActionState();
        const onRoleChange = () => updateActionState();

        const onShown = () => {
          syncEntityEditorViewport(element);
          inputEl.focus();
          inputEl.select();
          updateActionState();
        };

        const onHidden = () => settle(null);

        cancelBtn.addEventListener('click', onCancel);
        confirmBtn.addEventListener('click', onConfirm);
        inputEl.addEventListener('keydown', onInputKeydown);
        selectAllCheckbox.addEventListener('change', onToggleAll);
        transferList.addEventListener('change', onListChange);
        actionInputs.forEach((input) => input.addEventListener('change', onActionChange));
        roleSelect.addEventListener('change', onRoleChange);
        roleDescriptionInput.addEventListener('input', onRoleChange);
        element.addEventListener('shown.bs.modal', onShown, { once: true });
        element.addEventListener('hidden.bs.modal', onHidden, { once: true });
        window.addEventListener('resize', onViewportChange);
        if (viewportTarget) {
          viewportTarget.addEventListener('resize', onViewportChange);
          viewportTarget.addEventListener('scroll', onViewportChange);
        }

        syncEntityEditorViewport(element);
        updateActionState();
        instance.show();
      });
    }

    function abrirExportacao(entidadeTipo, entidadeId, formato, botao) {
      if (!ensurePermission(entidadeTipo === 'circulo' ? 'encontros.gerenciar' : 'equipes.gerenciar')) return;
      if (!entidadeTipo || !entidadeId || !formato) return;

      let restoreTimer = null;
      if (botao) {
        botao.disabled = true;
        botao.dataset.originalHtml = botao.innerHTML;
        botao.innerHTML = '<span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>Gerando...';
      }

      const url = `/admin/encontros/${encodeURIComponent(ejcId)}/export/${encodeURIComponent(entidadeTipo)}/${encodeURIComponent(entidadeId)}/${encodeURIComponent(formato)}`;
      window.open(url, '_blank');

      // The browser handles the download asynchronously, so we restore button state after a short delay.
      restoreTimer = setTimeout(() => {
        if (botao) {
          botao.disabled = false;
          botao.innerHTML = botao.dataset.originalHtml || botao.innerHTML;
          delete botao.dataset.originalHtml;
        }
      }, 1600);

      return restoreTimer;
    }

    function gerarQuadrante(botao) {
      if (!ensurePermission('encontros.gerenciar')) return;
      let restoreTimer = null;
      if (botao) {
        botao.disabled = true;
        botao.dataset.originalHtml = botao.innerHTML;
        botao.innerHTML = '<span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>Gerando...';
      }

      const url = `/admin/encontros/${encodeURIComponent(ejcId)}/quadrante/editor`;
      window.location.href = url;

      restoreTimer = setTimeout(() => {
        if (botao) {
          botao.disabled = false;
          botao.innerHTML = botao.dataset.originalHtml || botao.innerHTML;
          delete botao.dataset.originalHtml;
        }
      }, 1800);

      return restoreTimer;
    }

    function gerarCrachasEjc(botao) {
      if (!ensurePermission('encontros.gerenciar')) return;
      let restoreTimer = null;
      if (botao) {
        botao.disabled = true;
        botao.dataset.originalHtml = botao.innerHTML;
        botao.innerHTML = '<span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>Gerando...';
      }

      const url = `/admin/encontros/${encodeURIComponent(ejcId)}/export/crachas/pdf`;
      window.open(url, '_blank');

      restoreTimer = setTimeout(() => {
        if (botao) {
          botao.disabled = false;
          botao.innerHTML = botao.dataset.originalHtml || botao.innerHTML;
          delete botao.dataset.originalHtml;
        }
      }, 1600);

      return restoreTimer;
    }

    function ativarPainel(panelId, btn) {
      const targetPanel = document.getElementById(panelId);
      if (!targetPanel || targetPanel.style.display === 'none') return;

      document.querySelectorAll('.panel').forEach((panel) => panel.classList.remove('active', 'panel-entering'));
      targetPanel.classList.add('active');

      document.querySelectorAll('.menu-btn').forEach((b) => b.classList.remove('active'));
      const menuButton = btn || document.querySelector(`.menu-btn[data-panel="${panelId}"]`);
      if (menuButton) menuButton.classList.add('active');
      atualizarAtalhosPainelAtivo(panelId);

      salvarPainelAtivo();
    }

    function atualizarAtalhosPainelAtivo(panelId) {
      document.querySelectorAll('.encontro-module-card[data-panel-target]').forEach((item) => {
        item.classList.toggle('active', item.dataset.panelTarget === panelId);
      });
    }

    function getPainelAtivoId() {
      const ativo = document.querySelector('.panel.active');
      return ativo && ativo.id ? ativo.id : 'panel-circulos';
    }

    function getPainelStorageKey() {
      return `admin_encontro_ejc_painel_${String(ejcId || 'default')}`;
    }

    function salvarPainelAtivo() {
      const painelId = getPainelAtivoId();
      localStorage.setItem(getPainelStorageKey(), painelId);

      const url = new URL(window.location.href);
      url.searchParams.set('painel', painelId);
      window.history.replaceState({}, '', url.toString());
    }

    function restaurarPainelAtivo() {
      const url = new URL(window.location.href);
      const painelNaUrl = String(url.searchParams.get('painel') || '').trim();
      const painelNoStorage = String(localStorage.getItem(getPainelStorageKey()) || '').trim();
      const painelFallback = getPrimeiroPainelDisponivelId();
      const painelDesejado = painelNaUrl || painelNoStorage || painelFallback;
      const painelEl = document.getElementById(painelDesejado);

      if (painelEl && painelEl.style.display !== 'none') {
        ativarPainel(painelDesejado);
        return;
      }

      ativarPainel(painelFallback);
    }

    function recarregarMantendoPainelAtual() {
      salvarPainelAtivo();
      window.location.href = window.location.href;
    }

    function getChecklistElements(selectId) {
      return {
        select: document.getElementById(selectId),
        list: document.getElementById(`lista_${selectId}`),
      };
    }

    function closeAllChecklists(exceptSelectId = '') {
      ['encontrista_id', 'encontreiro_id'].forEach((selectId) => {
        if (selectId === exceptSelectId) return;
        const { list } = getChecklistElements(selectId);
        if (list) list.classList.add('d-none');
      });
    }

    function toggleMultiChecklist(selectId) {
      const { list } = getChecklistElements(selectId);
      if (!list) return;

      const willOpen = list.classList.contains('d-none');
      closeAllChecklists(selectId);
      if (willOpen) {
        list.classList.remove('d-none');
      } else {
        list.classList.add('d-none');
      }
    }

    function normalizeChecklistSearchText(value) {
      const base = String(value || '')
        .trim()
        .toLowerCase();

      const normalized = typeof base.normalize === 'function'
        ? base.normalize('NFD')
        : base;

      return normalized
        .replace(/[\u0300-\u036f]/g, '')
        .replace(/\s+/g, ' ');
    }

    function filtrarSelectMulti(selectId, termo) {
      const filtro = normalizeChecklistSearchText(termo);
      const { list } = getChecklistElements(selectId);
      if (!list) return;

      if (filtro) {
        list.classList.remove('d-none');
      }

      Array.from(list.querySelectorAll('.multi-check-item')).forEach((item) => {
        const texto = normalizeChecklistSearchText(item.getAttribute('data-text') || '');
        item.style.display = (!filtro || texto.includes(filtro)) ? '' : 'none';
      });
    }

    function limparFiltroSelectMulti(inputId, selectId) {
      const input = document.getElementById(inputId);
      if (input) {
        input.value = '';
      }

      filtrarSelectMulti(selectId, '');

      if (input) {
        input.focus();
      }
    }

    function initChecklistFromSelect(selectId) {
      const { select, list } = getChecklistElements(selectId);
      if (!select || !list) return;

      const options = Array.from(select.options || []).filter((option) => option.value);
      list.innerHTML = options.map((option) => {
        const optionValue = escapeHtml(String(option.value || ''));
        const optionTextRaw = String(option.textContent || '').trim();
        const optionText = escapeHtml(optionTextRaw);
        const checked = option.selected ? 'checked' : '';
        return `
          <label class="multi-check-item" data-value="${optionValue}" data-text="${optionText}">
            <input type="checkbox" value="${optionValue}" ${checked} onchange="toggleChecklistValue('${selectId}', this.value, this.checked)">
            <span>${optionText}</span>
          </label>
        `;
      }).join('');

      atualizarContadorSelecao(selectId);
    }

    function toggleChecklistValue(selectId, value, checked) {
      const { select } = getChecklistElements(selectId);
      if (!select) return;

      const option = Array.from(select.options || []).find((item) => String(item.value) === String(value));
      if (!option) return;

      option.selected = Boolean(checked);
      select.dispatchEvent(new Event('change'));
      atualizarContadorSelecao(selectId);
    }

    function atualizarResumoSelecao(selectId) {
      const select = document.getElementById(selectId);
      const resumo = document.getElementById(`resumo_${selectId}`);
      if (!select || !resumo) return;

      const selecionados = Array.from(select.selectedOptions || []);
      if (!selecionados.length) {
        resumo.textContent = 'Clique para selecionar nomes';
      } else if (selecionados.length === 1) {
        resumo.textContent = selecionados[0].textContent || '1 nome selecionado';
      } else {
        resumo.textContent = `${selecionados.length} nomes selecionados`;
      }
    }

    function atualizarContadorSelecao(selectId) {
      const select = document.getElementById(selectId);
      const contador = document.getElementById(`contador_${selectId}`);
      if (!select || !contador) return;

      const totalSelecionados = Array.from(select.selectedOptions || [])
        .map((option) => String(option.value || '').trim())
        .filter(Boolean)
        .length;

      contador.textContent = totalSelecionados === 1
        ? '1 selecionado'
        : `${totalSelecionados} selecionados`;

      atualizarResumoSelecao(selectId);
    }

    function observarContadorSelecao(selectId) {
      const select = document.getElementById(selectId);
      if (!select) return;

      const atualizar = () => atualizarContadorSelecao(selectId);
      select.addEventListener('change', atualizar);
      select.addEventListener('keyup', atualizar);
      select.addEventListener('mouseup', atualizar);
      atualizar();
    }

    document.addEventListener('click', (event) => {
      const target = event.target;
      if (!(target instanceof Element)) return;
      if (target.closest('.multi-select-panel')) return;
      closeAllChecklists();
    });

    function getPerfilModalScrollMode() {
      return 'fixed';
    }

    async function abrirPerfilPessoa(pessoaId, pessoaTipo) {
      if (!pessoaId || !pessoaTipo) return;
      
      try {
        const mapa = pessoaTipo === 'encontrista' ? mapEncontristas : mapEncontreiros;
        const pessoa = mapa[String(pessoaId)];
        
        if (!pessoa) {
          return await appAlert('Dados da pessoa não encontrados.', 'warning', 'Não encontrado');
        }

        const isDarkTheme = document.documentElement.getAttribute('data-theme') === 'dark';
        const tipoLabel = pessoaTipo === 'encontrista' ? 'Encontrista' : (pessoa.tipo === 'tios' ? 'Tios' : 'Encontreiro');
        const fotoUrl = pessoa.foto
          ? `/img/uploads/${encodeURIComponent(pessoa.foto)}?w=200&h=200&fit=cover&format=webp`
          : null;
        const dataNascimentoFormatada = (() => {
          if (!pessoa.dataNascimento) return '-';
          const parsed = new Date(pessoa.dataNascimento);
          return Number.isNaN(parsed.getTime()) ? '-' : parsed.toLocaleDateString('pt-BR');
        })();

        const colors = isDarkTheme ? {
          overlay: 'rgba(2, 6, 23, 0.58)',
          surface: 'linear-gradient(156deg, rgba(6, 12, 24, 0.96) 0%, rgba(16, 28, 50, 0.95) 100%)',
          border: 'rgba(148, 163, 184, 0.30)',
          borderSoft: 'rgba(148, 163, 184, 0.18)',
          title: '#f8fafc',
          subtitle: 'rgba(186, 230, 253, 0.85)',
          text: '#e2e8f0',
          muted: 'rgba(148, 163, 184, 0.88)',
          chipBg: 'rgba(14, 116, 144, 0.28)',
          chipText: '#bae6fd',
          cardBg: 'rgba(15, 23, 42, 0.52)',
          shadow: '0 26px 58px rgba(2, 6, 23, 0.62), 0 1px 0 rgba(255,255,255,0.08) inset',
          closeClass: 'btn-close-white'
        } : {
          overlay: 'rgba(15, 23, 42, 0.38)',
          surface: 'linear-gradient(150deg, #ffffff 0%, #f7fbff 55%, #eff6ff 100%)',
          border: 'rgba(30, 64, 175, 0.16)',
          borderSoft: 'rgba(30, 64, 175, 0.10)',
          title: '#0f172a',
          subtitle: 'rgba(30, 64, 175, 0.82)',
          text: '#1e293b',
          muted: 'rgba(71, 85, 105, 0.92)',
          chipBg: 'rgba(14, 165, 233, 0.14)',
          chipText: '#075985',
          cardBg: 'rgba(248, 250, 252, 0.92)',
          shadow: '0 24px 52px rgba(15, 23, 42, 0.18), 0 1px 0 rgba(255,255,255,0.9) inset',
          closeClass: 'btn-close'
        };

        const renderField = (icon, label, value, extraClass = '') => `
          <article class="perfil-pessoa-field ${extraClass}">
            <span class="perfil-pessoa-field-icon" aria-hidden="true"><i class="fas ${icon}"></i></span>
            <div class="perfil-pessoa-field-copy">
              <span class="perfil-pessoa-field-label">${escapeHtml(label)}</span>
              <span class="perfil-pessoa-field-value">${escapeHtml(value || '-')}</span>
            </div>
          </article>
        `;

        const fieldsHtml = [
          renderField('fa-tag', 'Como quer ser chamado', pessoa.comoQuerSerChamado),
          renderField('fa-venus-mars', 'Genero', pessoa.genero),
          renderField('fa-calendar-day', 'Data de nascimento', dataNascimentoFormatada),
          renderField('fa-phone', 'Telefone', pessoa.telefone),
          renderField('fa-envelope', 'Email', pessoa.email, 'is-email'),
          renderField('fa-church', 'EJC', pessoa.ejc),
          renderField('fa-location-dot', 'CEP', pessoa.cep),
          renderField('fa-road', 'Endereco', pessoa.logradouro),
          renderField('fa-map-pin', 'Bairro', pessoa.bairro),
          renderField('fa-note-sticky', 'Observacoes', pessoa.observacoes),
        ].join('');

        // Criar modal
        let modalEl = document.getElementById('perfil-pessoa-modal');
        if (!modalEl) {
          modalEl = document.createElement('div');
          modalEl.id = 'perfil-pessoa-modal';
          modalEl.tabIndex = '-1';
          modalEl.setAttribute('aria-hidden', 'true');
          document.body.appendChild(modalEl);
        } else {
          const existingInstance = bootstrap.Modal.getInstance(modalEl);
          if (existingInstance) {
            existingInstance.dispose();
          }
        }

        modalEl.className = `modal fade perfil-pessoa-modal ${isDarkTheme ? 'perfil-theme-dark' : 'perfil-theme-light'}`;
        modalEl.style.setProperty('--perfil-overlay', colors.overlay);
        modalEl.style.setProperty('--perfil-surface', colors.surface);
        modalEl.style.setProperty('--perfil-border', colors.border);
        modalEl.style.setProperty('--perfil-border-soft', colors.borderSoft);
        modalEl.style.setProperty('--perfil-title', colors.title);
        modalEl.style.setProperty('--perfil-subtitle', colors.subtitle);
        modalEl.style.setProperty('--perfil-text', colors.text);
        modalEl.style.setProperty('--perfil-muted', colors.muted);
        modalEl.style.setProperty('--perfil-chip-bg', colors.chipBg);
        modalEl.style.setProperty('--perfil-chip-text', colors.chipText);
        modalEl.style.setProperty('--perfil-card-bg', colors.cardBg);
        modalEl.style.setProperty('--perfil-shadow', colors.shadow);

        modalEl.innerHTML = `
          <div class="modal-dialog modal-dialog-scrollable perfil-pessoa-dialog">
            <div class="modal-content perfil-pessoa-card">
              <div class="modal-header perfil-pessoa-header">
                <div class="perfil-pessoa-headline">
                  <span class="perfil-pessoa-badge">Ficha completa</span>
                  <h5 class="modal-title">Perfil do ${escapeHtml(tipoLabel)}</h5>
                </div>
                <button type="button" class="btn-close ${colors.closeClass}" data-bs-dismiss="modal" aria-label="Fechar"></button>
              </div>
              <div class="modal-body perfil-pessoa-body">
                <section class="perfil-pessoa-hero">
                  ${fotoUrl
                    ? `<img src="${fotoUrl}" alt="Foto" class="perfil-pessoa-avatar">`
                    : `<div class="perfil-pessoa-avatar perfil-pessoa-avatar-placeholder"><i class="fas fa-user-circle"></i></div>`}
                  <div class="perfil-pessoa-main-info">
                    <h3>${escapeHtml(pessoa.nomeCompleto || '-')}</h3>
                    <p>${escapeHtml(tipoLabel)}</p>
                  </div>
                </div>
                <div class="perfil-pessoa-grid">
                  ${fieldsHtml}
                </div>
              </div>
            </div>
          </div>
        `;

        pinModalToViewport(modalEl, '.perfil-pessoa-dialog');

        const liberarScrollPagina = () => {
          document.body.classList.remove('modal-open');
          document.body.style.overflowY = 'auto';
          document.body.style.removeProperty('padding-right');
        };

        let perfilScrollRafId = null;
        const syncModalWithPageScroll = () => {
          modalEl.style.top = `${Math.max(0, window.scrollY)}px`;
        };

        const requestModalScrollSync = () => {
          if (perfilScrollRafId !== null) return;
          perfilScrollRafId = window.requestAnimationFrame(() => {
            perfilScrollRafId = null;
            syncModalWithPageScroll();
          });
        };

        const enableFollowScroll = () => {
          modalEl.classList.add('perfil-pessoa-follow-scroll');
          syncModalWithPageScroll();
          window.addEventListener('scroll', requestModalScrollSync, { passive: true });
          window.addEventListener('resize', requestModalScrollSync);
        };

        const restaurarScrollPadrao = () => {
          if (perfilScrollRafId !== null) {
            window.cancelAnimationFrame(perfilScrollRafId);
            perfilScrollRafId = null;
          }
          window.removeEventListener('scroll', requestModalScrollSync);
          window.removeEventListener('resize', requestModalScrollSync);
          modalEl.classList.remove('perfil-pessoa-follow-scroll');
          modalEl.style.removeProperty('top');
          document.body.style.removeProperty('overflow-y');
        };

        modalEl.addEventListener('shown.bs.modal', () => {
          liberarScrollPagina();
          if (getPerfilModalScrollMode() === 'follow') {
            enableFollowScroll();
          }
        }, { once: true });
        modalEl.addEventListener('hidden.bs.modal', restaurarScrollPadrao, { once: true });

        const modal = new bootstrap.Modal(modalEl, {
          backdrop: true,
          keyboard: true,
          focus: true,
        });
        modal.show();
      } catch (err) {
        console.error('Erro ao abrir perfil:', err);
        await appAlert('Erro ao carregar perfil.', 'danger', 'Erro');
      }
    }

    async function removerVinculo(vinculoId) {
      if (!vinculoId) return;
      const vinculo = vinculos.find((item) => String(item._id) === String(vinculoId));
      const permissaoNecessaria = vinculo?.entidadeTipo === 'equipe' ? 'equipes.gerenciar' : 'encontros.gerenciar';
      if (!ensurePermission(permissaoNecessaria)) return;
      if (!await appConfirm('Deseja remover este vinculo?', 'Confirmar remocao')) return;

      const res = await fetch(`/admin/remover-vinculo/${encodeURIComponent(vinculoId)}`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' }
      });
      const data = await res.json();
      if (!data.success) return await appAlert(data.error || 'Erro ao remover vinculo.', 'danger', 'Erro');
      recarregarMantendoPainelAtual();
    }

    async function criarCirculo() {
      if (!ensurePermission('encontros.gerenciar')) return;
      const nome = document.getElementById('circulo_nome').value.trim();
      if (!nome) return await appAlert('Informe o nome do circulo.', 'warning', 'Campo obrigatorio');
