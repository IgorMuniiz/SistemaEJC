    async function editarCirculo(circuloId, nomeAtual) {
      if (!ensurePermission('encontros.gerenciar')) return;
      if (!circuloId) return;

      const editorData = await appEntityEditorPrompt({
        title: 'Editar círculo',
        label: 'Nome do círculo',
        value: nomeAtual || '',
        placeholder: 'Digite o nome do círculo',
        help: 'Renomeie o círculo e escolha se deseja transferir ou excluir pessoas vinculadas sem sair desta tela.',
        confirmText: 'Salvar alterações',
        transferLabel: 'Gerenciar encontristas vinculados',
        transferHelp: 'Marque as pessoas e escolha se deseja transferir para outro círculo ou apenas remover o vínculo.',
        transferOptions: getTransferDestinations('circulo', circuloId),
        linkedPeople: getLinkedPeopleSelection('circulo', circuloId),
        emptyTransferText: 'Nenhum encontrista vinculado a este círculo no momento.',
        ...getRoleEditorConfig('circulo'),
      });

      if (!editorData) return;

      const novoNome = String(editorData.value || '').trim();
      const acaoVinculo = String(editorData.acaoVinculo || 'transferir');
      const transferirParaId = String(editorData.transferirParaId || '').trim();
      const papelVinculo = String(editorData.papelVinculo || '').trim().toLowerCase();
      const descricaoPapelVinculo = String(editorData.descricaoPapelVinculo || '').trim();
      const gerenciarPessoaIds = Array.isArray(editorData.gerenciarPessoaIds)
        ? editorData.gerenciarPessoaIds.filter(Boolean)
        : [];

      if (!novoNome) return await appAlert('Informe o nome do círculo.', 'warning', 'Campo obrigatório');
      if (gerenciarPessoaIds.length && acaoVinculo === 'transferir' && !transferirParaId) {
        return await appAlert('Escolha o círculo de destino para concluir a transferência.', 'warning', 'Transferência incompleta');
      }
      if (gerenciarPessoaIds.length && acaoVinculo === 'papel' && !papelVinculo) {
        return await appAlert('Selecione o novo papel para as pessoas marcadas.', 'warning', 'Papel obrigatório');
      }
      if (gerenciarPessoaIds.length && acaoVinculo === 'papel' && papelVinculo === 'moita' && !descricaoPapelVinculo) {
        return await appAlert('Informe a descrição do papel quando selecionar Moita.', 'warning', 'Descrição obrigatória');
      }
      if (novoNome === String(nomeAtual || '').trim() && !gerenciarPessoaIds.length) return;

      const res = await fetch(`/admin/editar-circulo/${encodeURIComponent(circuloId)}`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          ejcId,
          nome: novoNome,
          acaoVinculo,
          gerenciarPessoaIds,
          transferirParaId,
          papelVinculo,
          descricaoPapelVinculo,
          transferirPessoaIds: acaoVinculo === 'transferir' ? gerenciarPessoaIds : [],
          removerPessoaIds: acaoVinculo === 'excluir' ? gerenciarPessoaIds : [],
        }),
      });
      const data = await res.json();
      if (!data.success) return await appAlert(data.error || 'Erro ao editar círculo.', 'danger', 'Erro');
      recarregarMantendoPainelAtual();
    }

    async function excluirCirculo(circuloId, nomeCirculo) {
