        confirmBtn.addEventListener('click', onConfirm);
        inputEl.addEventListener('keydown', onInputKeydown);
        element.addEventListener('shown.bs.modal', onShown, { once: true });
        element.addEventListener('hidden.bs.modal', onHidden, { once: true });

        instance.show();
      });
    }

    function syncEntityEditorViewport(modalElement) {
      const element = modalElement || document.getElementById('app-entity-editor-modal');
      if (!element) return;

      const viewportHeight = Math.max(
        window.visualViewport?.height || 0,
        window.innerHeight || 0,
        document.documentElement?.clientHeight || 0,
        320,
      );
      const gap = Number.parseFloat(getComputedStyle(element).getPropertyValue('--entity-modal-gap')) || 12;
      const card = element.querySelector('.app-entity-editor-card');
      const cardHeight = card
        ? Math.min(card.scrollHeight || card.offsetHeight || 0, Math.max(viewportHeight - (gap * 2), 220))
        : 0;
      const centeredOffset = Math.max(gap, Math.round((viewportHeight - cardHeight) / 2));

      document.documentElement.style.setProperty('--entity-modal-vh', `${viewportHeight}px`);
      document.documentElement.style.setProperty('--entity-modal-page-top', `${centeredOffset}px`);
    }

